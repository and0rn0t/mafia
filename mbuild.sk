# ==============================================================================
# [mbuild.sk] 마피아 게임 맵 자동 생성(관리자 전용). 빈 월드 "mafia_map" 에 낮 광장, 밤 방, 밤 대상 선택 침대를 서로 떨어뜨려 짓고
#             게임 월드 위치와 연출 장소 6곳(mscene.sk), 원탁 반지름 등 숫자 설정까지 정한다.
# 명령: /mbuild        맵을 짓는다(이미 있으면 같은 자리에 다시 덮어 짓는다. 예전 버전 건물도 지운다). 짓는 동안 서버가 잠깐 멈출 수 있다.
#       /mbuild tp     원탁 광장으로 이동
# 카메라/연출 위치(mBSaveSpots)는 스크립트를 불러올 때마다 자동으로 다시 저장된다(/sk reload 만으로 적용. /madmin 에서 바꾼 값도 이때 코드 값으로 돌아간다).
# 건물 배치를 바꾸면 mBVer() 를 올린다. 서버 맵이 낮은 버전이면 관리자에게 접속/리로드 때 /mbuild 를 다시 하라고 알린다.
# 배경 분리: 세 공간은 100칸씩 떨어져 있고, 각 카메라는 다른 공간을 등지는 방향을 본다(시야 거리 8청크 안이라 화면 전환 때 청크를 다시 받지 않는다).
# 낮/밤: 서버 시간은 밤(18000)으로 고정(스켈레톤 더미가 타지 않게). 화면의 하늘은 mscene.sk 가 플레이어별로 바꾼다(낮 정오, 밤은 달이 동쪽 낮게 뜬 13800).
# 배치(월드 mafia_map, 바닥 블록 y=64, 바닥 위 y=65):
#   낮 광장   (0,0) 둘레 풀밭. 반지름 14 돌 광장(가운데 붉은 카펫 원과 원탁), 가로등 8개, 꽃밭, 벤치. 둘레 사방에 집 16채(±20~27), 나무 8그루, 장터 가판대 6개,
#             맨 바깥(±30)에 잎 울타리 벽. 투표 선택 화면(원탁 안에서 바깥을 보는 얼굴 클로즈업)의 어느 방향 배경에도 광장만 보이고 다른 공간이나 빈 지평선이 안 보인다.
#             카메라는 북쪽에서 원탁 가까이(눈 y=67.6, z=-5) 남쪽으로 원탁을 크게, 뒤로 집과 하늘을 본다. 더미 자리 반지름 3.2
#   밤 방     x 100~107, z -4~4, 천장 y=71. 동쪽 벽에 큰 유리창(z -1~1, y 66~70)으로 달이 보인다. 창 앞에 탁자(반 블록)와 꽃병, 촛불,
#             창 옆(남쪽) 의자에 자기 더미가 카메라를 보고 앉는다. 카메라는 방 가운데쯤(x 103.3)에서 동쪽 창을 꽉 차게 본다
#   침대      (0, -100) 둘레 풀밭. 붉은 침대 3개(x -2, 0, 2, 한 칸씩 띄움, 머리 남쪽), 뒤에 잎 울타리, 조명 없음(달빛만).
#             가운데 = 지금 후보, 화면 왼쪽(x=2) = 이전, 오른쪽(x=-2) = 다음(가장자리에 아주 조금만 보임)(카메라가 남쪽을 보므로). 카메라는 가운데 침대 바로 위에서 거의 수직으로 내려다본다(베개와 얼굴이 화면 위쪽, 양옆 침대는 화면 가장자리에 반쯤 걸친다)
# 월드 설정: 몹 생성 끔, 시간/날씨 고정, 구조물 없음. world.sk 의 자동 불러오기 목록({worldlist::mafia_map})에 넣는다.
# 미검증: 전체(서버 실행 불가). 마네킹 누운 방향: 시험 화면 두 번(yaw 180 = 머리 동쪽, yaw 270 = 머리 북쪽, 위치 = 발끝)을 보고 yaw 90(머리 남쪽 베개)과 발끝 위치(침대 북쪽 끝 z=-100.1)로 맞췄다.
#   앉은 높이(의자 위 y+0.5), 달이 창에 걸리는지는 실제로 보고 조정해야 한다(/madmin 장소·카메라 메뉴, /mbuild 를 다시 하면 여기 값으로 돌아간다).
# ==============================================================================

import:
	org.bukkit.Bukkit
	org.bukkit.Location
	org.bukkit.Material
	org.bukkit.GameRule
	org.bukkit.WorldCreator
	org.bukkit.WorldType
	org.bukkit.util.Vector

function mBWorld() :: world:
	set {_w} to Bukkit.getWorld("mafia_map")
	if {_w} is set:
		return {_w}
	set {_c} to new WorldCreator("mafia_map")
	{_c}.type(WorldType.FLAT)
	{_c}.generatorSettings("{""layers"":[{""block"":""minecraft:air"",""height"":1}],""biome"":""minecraft:the_void""}")
	{_c}.generateStructures(false)
	set {_w} to Bukkit.createWorld({_c})
	set {worldlist::mafia_map} to "mafia_map"
	return {_w}

# 블록 하나(블록 데이터 문자열, 예: "minecraft:stone_bricks" 또는 "minecraft:red_bed[part=head,facing=north]")
function mBSet(w: world, x: number, y: number, z: number, d: text):
	{_w}.getBlockAt({_x}, {_y}, {_z}).setBlockData(Bukkit.createBlockData({_d}), false)

# 직육면체 채우기(양 끝 포함)
function mBFill(w: world, x1: number, y1: number, z1: number, x2: number, y2: number, z2: number, d: text):
	set {_bd} to Bukkit.createBlockData({_d})
	loop integers between {_x1} and {_x2}:
		set {_x} to loop-value-1
		loop integers between {_y1} and {_y2}:
			set {_y} to loop-value-2
			loop integers between {_z1} and {_z2}:
				{_w}.getBlockAt({_x}, {_y}, loop-value-3).setBlockData({_bd}, false)

# 방 하나: 바닥(y0), 벽, 천장(y1), 안은 비운다. 안쪽 범위는 x1~x2, z1~z2.
# (리로드가 느려지지 않게, 함수 호출 인자 안에 계산을 넣지 않고 먼저 변수로 계산한다. 아래 함수들도 같음)
function mBRoom(w: world, x1: number, z1: number, x2: number, z2: number, y0: number, y1: number, floor: text, wall: text, ceil: text):
	set {_ax} to {_x1} - 1
	set {_az} to {_z1} - 1
	set {_bx} to {_x2} + 1
	set {_bz} to {_z2} + 1
	set {_iy} to {_y0} + 1
	set {_jy} to {_y1} - 1
	mBFill({_w}, {_ax}, {_y0}, {_az}, {_bx}, {_y1}, {_bz}, {_wall})
	mBFill({_w}, {_x1}, {_iy}, {_z1}, {_x2}, {_jy}, {_z2}, "minecraft:air")
	mBFill({_w}, {_x1}, {_y0}, {_z1}, {_x2}, {_y0}, {_z2}, {_floor})
	mBFill({_w}, {_x1}, {_y1}, {_z1}, {_x2}, {_y1}, {_z2}, {_ceil})

# 기준점(ox, oz)에서 상대 좌표로 채우기/놓기(호출하는 줄에는 숫자만 쓴다)
function mBFillR(w: world, ox: number, oz: number, x1: number, y1: number, z1: number, x2: number, y2: number, z2: number, d: text):
	set {_ax} to {_ox} + {_x1}
	set {_az} to {_oz} + {_z1}
	set {_bx} to {_ox} + {_x2}
	set {_bz} to {_oz} + {_z2}
	mBFill({_w}, {_ax}, {_y1}, {_az}, {_bx}, {_y2}, {_bz}, {_d})

function mBSetR(w: world, ox: number, oz: number, x: number, y: number, z: number, d: text):
	set {_ax} to {_ox} + {_x}
	set {_az} to {_oz} + {_z}
	mBSet({_w}, {_ax}, {_y}, {_az}, {_d})

# 위치 저장: (x,y,z)에서 (tx,ty,tz)를 바라보는 방향으로
function mBSaveLook(key: text, w: world, x: number, y: number, z: number, tx: number, ty: number, tz: number):
	set {_l} to new Location({_w}, {_x}, {_y}, {_z})
	set {_dx} to {_tx} - {_x}
	set {_dy} to {_ty} - {_y}
	set {_dz} to {_tz} - {_z}
	{_l}.setDirection(new Vector({_dx}, {_dy}, {_dz}))
	mLocSave({_key}, {_l})

# 위치 저장: 정한 방향(yaw)으로
function mBSaveYaw(key: text, w: world, x: number, y: number, z: number, yaw: number):
	set {_l} to new Location({_w}, {_x}, {_y}, {_z}, {_yaw}, 0)
	mLocSave({_key}, {_l})

# 기준점(ox, oz)에서 상대 좌표로 위치 저장
function mBSaveYawR(key: text, w: world, ox: number, oz: number, x: number, y: number, z: number, yaw: number):
	set {_ax} to {_ox} + {_x}
	set {_az} to {_oz} + {_z}
	mBSaveYaw({_key}, {_w}, {_ax}, {_y}, {_az}, {_yaw})

# 나무 하나(줄기 4칸 + 잎)
function mBTree(w: world, x: number, z: number):
	mBFillR({_w}, {_x}, {_z}, -2, 68, -2, 2, 69, 2, "minecraft:oak_leaves[persistent=true]")
	mBFillR({_w}, {_x}, {_z}, -1, 70, -1, 1, 71, 1, "minecraft:oak_leaves[persistent=true]")
	mBFill({_w}, {_x}, 65, {_z}, {_x}, 69, {_z}, "minecraft:oak_log")

# 가로등(울타리 3칸 + 랜턴)
function mBLamp(w: world, x: number, z: number):
	mBFill({_w}, {_x}, 65, {_z}, {_x}, 67, {_z}, "minecraft:dark_oak_fence")
	mBSet({_w}, {_x}, 68, {_z}, "minecraft:lantern")

# ---- 플레이어 집 12채(광장 둘레, 바깥 장면용). 각 참가자가 한 채씩 쓴다(mscene.sk 가 자리 순서대로 배정, 최대 12명).
# 집 = 바깥 7x7(x1~x1+6, z1~z1+6), 바닥 y=64, 벽 65~68, 지붕은 y=69부터. 안쪽 화면은 모든 집이 밤 방을 쓴다(안은 꾸며 두었지만 연출에 쓰지 않음).
# 문(side): n = 북쪽 벽 가운데, s = 남쪽 벽 가운데, w = 서쪽 벽 남쪽 끝, e = 동쪽 벽 북쪽 끝.
function mBHomeDef(i: number) :: text:
	if {_i} <= 4:
		set {_xs::*} to -17, -8, 1, 10
		return "%{_xs::%{_i}%}%|20|n|minecraft:white_terracotta"
	if {_i} <= 8:
		set {_xs::*} to -17, -8, 1, 10
		set {_k} to {_i} - 4
		return "%{_xs::%{_k}%}%|-27|s|minecraft:birch_planks"
	if {_i} <= 10:
		set {_zs::*} to -8, 2
		set {_k} to {_i} - 8
		return "21|%{_zs::%{_k}%}%|w|minecraft:bricks"
	set {_zs::*} to -8, 2
	set {_k} to {_i} - 10
	return "-27|%{_zs::%{_k}%}%|e|minecraft:bricks"

function mBHomeBuild(w: world, i: number):
	set {_d::*} to split mBHomeDef({_i}) at "|"
	set {_x} to ({_d::1} parsed as number)
	set {_z} to ({_d::2} parsed as number)
	set {_wall} to {_d::4}
	mBFillR({_w}, {_x}, {_z}, 0, 64, 0, 6, 64, 6, "minecraft:dark_oak_planks")
	mBFillR({_w}, {_x}, {_z}, 0, 65, 0, 6, 68, 6, {_wall})
	mBFillR({_w}, {_x}, {_z}, 1, 65, 1, 5, 68, 5, "minecraft:air")
	mBFillR({_w}, {_x}, {_z}, 0, 65, 0, 0, 68, 0, "minecraft:dark_oak_log")
	mBFillR({_w}, {_x}, {_z}, 6, 65, 0, 6, 68, 0, "minecraft:dark_oak_log")
	mBFillR({_w}, {_x}, {_z}, 0, 65, 6, 0, 68, 6, "minecraft:dark_oak_log")
	mBFillR({_w}, {_x}, {_z}, 6, 65, 6, 6, 68, 6, "minecraft:dark_oak_log")
	# 작은 창(문 자리는 아래에서 문으로 덮는다)
	mBSetR({_w}, {_x}, {_z}, 1, 66, 0, "minecraft:glass")
	mBSetR({_w}, {_x}, {_z}, 5, 66, 0, "minecraft:glass")
	mBSetR({_w}, {_x}, {_z}, 1, 66, 6, "minecraft:glass")
	mBSetR({_w}, {_x}, {_z}, 5, 66, 6, "minecraft:glass")
	mBSetR({_w}, {_x}, {_z}, 0, 66, 2, "minecraft:glass")
	# 동쪽 큰 창
	mBFillR({_w}, {_x}, {_z}, 6, 66, 2, 6, 68, 4, "minecraft:glass")
	# 지붕
	mBFillR({_w}, {_x}, {_z}, -1, 69, -1, 7, 69, 7, "minecraft:dark_oak_planks")
	mBFillR({_w}, {_x}, {_z}, 0, 70, 0, 6, 70, 6, "minecraft:dark_oak_planks")
	mBFillR({_w}, {_x}, {_z}, 1, 71, 1, 5, 71, 5, "minecraft:dark_oak_planks")
	mBFillR({_w}, {_x}, {_z}, 2, 72, 2, 4, 72, 4, "minecraft:dark_oak_slab[type=bottom]")
	# 가구
	mBSetR({_w}, {_x}, {_z}, 5, 65, 2, "minecraft:oak_slab[type=top]")
	mBSetR({_w}, {_x}, {_z}, 5, 65, 3, "minecraft:oak_slab[type=top]")
	mBSetR({_w}, {_x}, {_z}, 5, 66, 3, "minecraft:potted_poppy")
	mBSetR({_w}, {_x}, {_z}, 5, 66, 2, "minecraft:candle[candles=2,lit=true]")
	mBSetR({_w}, {_x}, {_z}, 5, 65, 4, "minecraft:spruce_stairs[facing=east]")
	mBFillR({_w}, {_x}, {_z}, 1, 65, 1, 1, 66, 2, "minecraft:bookshelf")
	mBFillR({_w}, {_x}, {_z}, 2, 65, 3, 3, 65, 4, "minecraft:brown_carpet")
	# 문
	set {_dl::*} to split mBHomeDoor({_i}) at "|"
	set {_dx} to ({_dl::1} parsed as number)
	set {_dz} to ({_dl::2} parsed as number)
	set {_face} to {_dl::3}
	mBSetR({_w}, {_x}, {_z}, {_dx}, 65, {_dz}, "minecraft:oak_door[half=lower,facing=%{_face}%,hinge=left,open=false]")
	mBSetR({_w}, {_x}, {_z}, {_dx}, 66, {_dz}, "minecraft:oak_door[half=upper,facing=%{_face}%,hinge=left,open=false]")

# 문(집 기준 상대 좌표): 문 블록 x|z|문 방향(안쪽)|바깥 방향 x|바깥 방향 z
function mBHomeDoor(i: number) :: text:
	set {_d::*} to split mBHomeDef({_i}) at "|"
	set {_s} to {_d::3}
	if {_s} is "n":
		return "3|0|south|0|-1"
	if {_s} is "s":
		return "3|6|north|0|1"
	if {_s} is "w":
		return "0|5|east|-1|0"
	return "6|1|west|1|0"

# 집 i 의 바깥 연출 자리를 저장한다(블록은 건드리지 않음). 키: h<i>door(문 아래 블록), out(문 바깥 한 칸, 바깥을 봄), ext(바깥 카메라, 문을 봄)
function mBHomeSpots(w: world, i: number):
	set {_d::*} to split mBHomeDef({_i}) at "|"
	set {_x} to ({_d::1} parsed as number)
	set {_z} to ({_d::2} parsed as number)
	set {_dl::*} to split mBHomeDoor({_i}) at "|"
	set {_rx} to ({_dl::1} parsed as number)
	set {_rz} to ({_dl::2} parsed as number)
	set {_ox} to ({_dl::4} parsed as number)
	set {_oz} to ({_dl::5} parsed as number)
	if {mcfg::house::%{_i}%::face} is not {_dl::3}:
		set {mcfg::house::%{_i}%::face} to {_dl::3}
	set {_k} to "h%{_i}%"
	mBSaveYawR("%{_k}%door", {_w}, {_x}, {_z}, {_rx}, 65, {_rz}, 0)
	# 문 바깥 한 칸: 문 블록 가운데 + 바깥 방향 1칸
	set {_px} to {_x} + {_rx}
	add 0.5 to {_px}
	add {_ox} to {_px}
	set {_pz} to {_z} + {_rz}
	add 0.5 to {_pz}
	add {_oz} to {_pz}
	set {_qx} to {_px} + {_ox}
	set {_qz} to {_pz} + {_oz}
	mBSaveLook("%{_k}%out", {_w}, {_px}, 65, {_pz}, {_qx}, 65, {_qz})
	# 바깥 카메라: 문 바깥에서 4칸 더 나가고 옆으로 1.6칸(남북 문은 동쪽, 동서 문은 남쪽으로 비켜 장터 가판대를 피함), 문 가운데를 본다
	set {_cx} to {_ox} * 4
	add {_px} to {_cx}
	set {_cz} to {_oz} * 4
	add {_pz} to {_cz}
	if {_ox} is 0:
		add 1.6 to {_cx}
	else:
		add 1.6 to {_cz}
	set {_lx} to {_x} + {_rx}
	add 0.5 to {_lx}
	set {_lz} to {_z} + {_rz}
	add 0.5 to {_lz}
	mBSaveLook("%{_k}%ext", {_w}, {_cx}, 66.9, {_cz}, {_lx}, 66.2, {_lz})

# 장터 가판대(통 3개 + 울타리 기둥 + 천막). 가운데 (x, z), 천막 색 wool
function mBStall(w: world, x: number, z: number, wool: text):
	mBFillR({_w}, {_x}, {_z}, -1, 65, 0, 1, 65, 0, "minecraft:barrel[facing=up]")
	mBSetR({_w}, {_x}, {_z}, -1, 66, 0, "minecraft:pumpkin")
	mBSetR({_w}, {_x}, {_z}, 1, 66, 0, "minecraft:melon")
	mBFillR({_w}, {_x}, {_z}, -1, 66, -1, -1, 67, -1, "minecraft:oak_fence")
	mBFillR({_w}, {_x}, {_z}, 1, 66, -1, 1, 67, -1, "minecraft:oak_fence")
	mBFillR({_w}, {_x}, {_z}, -1, 66, 1, -1, 67, 1, "minecraft:oak_fence")
	mBFillR({_w}, {_x}, {_z}, 1, 66, 1, 1, 67, 1, "minecraft:oak_fence")
	mBFillR({_w}, {_x}, {_z}, -1, 68, -1, 1, 68, 1, {_wool})

function mBuild():
	set {_w} to mBWorld()
	{_w}.setGameRule(GameRule.DO_MOB_SPAWNING, false)
	{_w}.setGameRule(GameRule.DO_DAYLIGHT_CYCLE, false)
	{_w}.setGameRule(GameRule.DO_WEATHER_CYCLE, false)
	# 서버 시간은 밤으로 둔다(스켈레톤 더미가 햇빛에 타지 않게). 화면의 낮/밤은 mscene.sk 가 플레이어별 하늘 시간으로 보여 준다.
	{_w}.setTime(18000)
	{_w}.setSpawnLocation(0, 65, -8)
	# ---- 예전 건물 지우기
	mBFill({_w}, -12, 65, -12, 12, 73, 12, "minecraft:air")
	mBFill({_w}, 35, 64, -5, 45, 70, 5, "minecraft:air")
	mBFill({_w}, 30, 64, 14, 50, 70, 26, "minecraft:air")
	# ================= 낮: 원탁 광장 (0, 0), 카메라는 북쪽에서 남쪽을 본다
	mBFill({_w}, -45, 64, -35, 45, 64, 45, "minecraft:grass_block")
	loop integers between -14 and 14:
		set {_x} to loop-value-1
		loop integers between -14 and 14:
			set {_z} to loop-value-2
			set {_d2} to {_x} * {_x}
			add {_z} * {_z} to {_d2}
			if {_d2} <= 196:
				if {_d2} > 100:
					mBSet({_w}, {_x}, 64, {_z}, "minecraft:stone_bricks")
				else if {_d2} > 64:
					mBSet({_w}, {_x}, 64, {_z}, "minecraft:polished_andesite")
				else:
					mBSet({_w}, {_x}, 64, {_z}, "minecraft:stone_bricks")
				if {_d2} <= 25:
					mBSet({_w}, {_x}, 65, {_z}, "minecraft:red_carpet")
	# 원탁: 반지름 2 안쪽 반 블록 판자
	loop integers between -2 and 2:
		set {_x} to loop-value-1
		loop integers between -2 and 2:
			set {_z} to loop-value-2
			set {_e2} to {_x} * {_x}
			add {_z} * {_z} to {_e2}
			if {_e2} <= 5:
				mBSet({_w}, {_x}, 65, {_z}, "minecraft:dark_oak_slab[type=bottom]")
	# 가로등 8개(반지름 11), 꽃밭, 벤치
	mBLamp({_w}, 0, 11)
	mBLamp({_w}, 0, -11)
	mBLamp({_w}, 11, 0)
	mBLamp({_w}, -11, 0)
	mBLamp({_w}, 8, 8)
	mBLamp({_w}, -8, 8)
	mBLamp({_w}, 8, -8)
	mBLamp({_w}, -8, -8)
	loop -6, 6:
		set {_x} to loop-value
		mBFillR({_w}, {_x}, 0, -1, 64, 12, 1, 64, 13, "minecraft:grass_block")
		mBSetR({_w}, {_x}, 0, -1, 65, 12, "minecraft:poppy")
		mBSet({_w}, {_x}, 65, 12, "minecraft:dandelion")
		mBSetR({_w}, {_x}, 0, 1, 65, 12, "minecraft:cornflower")
		mBSetR({_w}, {_x}, 0, -1, 65, 13, "minecraft:oxeye_daisy")
		mBSet({_w}, {_x}, 65, 13, "minecraft:allium")
		mBSetR({_w}, {_x}, 0, 1, 65, 13, "minecraft:poppy")
		mBFillR({_w}, {_x}, 0, -1, 65, 9, 1, 65, 9, "minecraft:spruce_stairs[facing=south]")
	mBFill({_w}, 12, 64, -2, 13, 64, 2, "minecraft:grass_block")
	mBFill({_w}, 12, 65, -2, 13, 65, 2, "minecraft:azure_bluet")
	mBFill({_w}, -13, 64, -2, -12, 64, 2, "minecraft:grass_block")
	mBFill({_w}, -13, 65, -2, -12, 65, 2, "minecraft:red_tulip")
	# 광장 둘레: 사방에 집, 사이사이 나무와 가판대, 맨 바깥은 잎 울타리 벽(투표 선택 화면처럼 바깥을 향한 카메라에도 다른 공간/빈 지평선이 안 보이게)
	mBFill({_w}, -31, 65, 15, 31, 74, 31, "minecraft:air")
	mBFill({_w}, -31, 65, -31, 31, 74, -15, "minecraft:air")
	mBFill({_w}, 15, 65, -14, 31, 74, 14, "minecraft:air")
	mBFill({_w}, -31, 65, -14, -15, 74, 14, "minecraft:air")
	loop 12 times:
		mBHomeBuild({_w}, loop-value)
	loop -30, 30:
		set {_a} to loop-value
		mBFill({_w}, -30, 65, {_a}, 30, 69, {_a}, "minecraft:oak_leaves[persistent=true]")
		mBFill({_w}, {_a}, 65, -30, {_a}, 69, 30, "minecraft:oak_leaves[persistent=true]")
	mBTree({_w}, 24, 24)
	mBTree({_w}, -24, 24)
	mBTree({_w}, 24, -24)
	mBTree({_w}, -24, -24)
	mBTree({_w}, 17, 12)
	mBTree({_w}, -17, 12)
	mBTree({_w}, 17, -12)
	mBTree({_w}, -17, -12)
	mBStall({_w}, 10, 16, "minecraft:red_wool")
	mBStall({_w}, -10, 16, "minecraft:yellow_wool")
	mBStall({_w}, 10, -16, "minecraft:blue_wool")
	mBStall({_w}, -10, -16, "minecraft:lime_wool")
	# ================= 밤: 달이 보이는 작은 방 (x 100~107, z -4~4), 동쪽 창, 카메라는 서쪽에서 동쪽을 본다
	mBFill({_w}, 75, 64, -30, 135, 64, 30, "minecraft:grass_block")
	mBRoom({_w}, 100, -4, 107, 4, 64, 71, "minecraft:dark_oak_planks", "minecraft:spruce_planks", "minecraft:spruce_planks")
	loop 99, 108:
		set {_x} to loop-value-1
		loop -5, 5:
			mBFill({_w}, {_x}, 65, loop-value-2, {_x}, 70, loop-value-2, "minecraft:dark_oak_log")
	# 동쪽 창(달), 창 앞 탁자와 꽃병, 촛불
	mBFill({_w}, 108, 66, -1, 108, 70, 1, "minecraft:glass")
	mBSet({_w}, 107, 65, -1, "minecraft:oak_slab[type=top]")
	mBSet({_w}, 107, 65, 0, "minecraft:oak_slab[type=top]")
	mBSet({_w}, 107, 66, 0, "minecraft:potted_poppy")
	mBSet({_w}, 107, 66, -1, "minecraft:candle[candles=2,lit=true]")
	# 창 옆 의자(자기 더미가 앉는 자리)
	mBSet({_w}, 107, 65, 2, "minecraft:spruce_stairs[facing=east]")
	# 방 꾸밈: 책장, 카펫
	mBFill({_w}, 101, 65, -4, 104, 66, -4, "minecraft:bookshelf")
	mBFill({_w}, 102, 65, -1, 105, 65, 1, "minecraft:brown_carpet")
	# 동쪽 벽 문(킬/방문 연출에서 방문자가 들어오는 곳. 열림/닫힘은 mfx.sk 가 보는 사람 화면에만 바꾼다)
	mBSet({_w}, 108, 65, -3, "minecraft:oak_door[half=lower,facing=west,hinge=left,open=false]")
	mBSet({_w}, 108, 66, -3, "minecraft:oak_door[half=upper,facing=west,hinge=left,open=false]")
	# ================= 밤 대상 선택: 붉은 침대 3개 (x -2, 0, 2, z -100), 조명 없음, 카메라는 남쪽에서 북쪽을 본다
	mBFill({_w}, -20, 64, -125, 20, 64, -80, "minecraft:grass_block")
	mBFill({_w}, -4, 64, -102, 4, 64, -97, "minecraft:spruce_planks")
	mBFill({_w}, -3, 65, -101, 3, 65, -98, "minecraft:air")
	loop -2, 0, 2:
		mBSet({_w}, loop-value, 65, -99, "minecraft:red_bed[part=head,facing=south]")
		mBSet({_w}, loop-value, 65, -100, "minecraft:red_bed[part=foot,facing=south]")
	mBFill({_w}, -5, 65, -103, 5, 66, -103, "minecraft:oak_leaves[persistent=true]")
	# ---- 위치와 설정(맵 버전 기록)
	mBSaveSpots({_w})
	set {mcfg::mapver} to mBVer()

# 맵 구조 버전. 블록 배치(건물)를 바꾸면 이 숫자를 올린다. 서버 맵이 이 버전보다 낮으면 관리자에게 /mbuild 를 다시 하라고 알린다.
function mBVer() :: number:
	return 9

# 게임 위치, 연출 장소 6곳, 숫자 설정을 저장한다. 블록은 건드리지 않는다.
# 스크립트를 불러올 때(on load)도 자동으로 다시 저장하므로, 카메라 위치만 바꾼 경우에는 /sk reload 만 하면 적용된다.
function mBSaveSpots(w: world):
	mBSaveYaw("game", {_w}, 0.5, 65, -5, 0)
	mBSaveYaw("table", {_w}, 0.5, 65, 0.5, 0)
	# 낮: 원탁 가까이(원탁 가운데까지 약 6칸)에서 남쪽으로 내려다본다
	mBSaveLook("daycam", {_w}, 0.5, 67.6, -5, 0.5, 65.4, 0.5)
	# 플레이어 집 12채의 바깥 연출 자리(문, 문 바깥, 바깥 카메라). 집 안 화면은 모든 집이 아래의 밤 방(x 100~107)을 같이 쓴다
	loop 12 times:
		mBHomeSpots({_w}, loop-value)
	set {mcfg::house::n} to 12
	# 밤 방(모든 집의 안쪽 화면): 자기 더미 자리, 카메라, 문 안쪽(방문자가 나타남), 문 블록, 방 가운데(돌아 걷는 점), 대상 앞, 수호자 자리, 불타는 바닥 범위
	mBSaveYaw("room", {_w}, 107.5, 65.5, 2.5, 90)
	mBSaveLook("nightcam", {_w}, 103.3, 66.7, 0.9, 108, 67.6, 0.9)
	mBSaveYaw("fxdoor", {_w}, 107.5, 65, -3, 90)
	mBSaveYaw("fxdoorblock", {_w}, 108, 65, -3, 0)
	mBSaveYaw("fxmid", {_w}, 106.6, 65, -1.5, 0)
	mBSaveYaw("fxvisit", {_w}, 106.2, 65, 1.6, 0)
	mBSaveYaw("fxguard", {_w}, 106.2, 65, 3.6, 180)
	mBSaveYaw("fxfireA", {_w}, 100, 65, -3, 0)
	mBSaveYaw("fxfireB", {_w}, 106, 65, 3, 0)
	# 침대 더미: 위치 = 발끝(침대 북쪽 끝), yaw 90 = 머리가 남쪽 베개
	mBSaveYaw("bed", {_w}, 0.5, 65.5625, -100.1, 90)
	# 침대 카메라: 가운데 침대 바로 위에서 거의 수직으로 내려다본다. 화면 위쪽 = 남쪽(베개와 얼굴), 양옆 침대는 화면 가장자리에 반쯤
	mBSaveLook("bedcam", {_w}, 0.5, 66.35, -98.65, 0.5, 65.6, -98.55)

# 맵이 있으면 연출 위치를 지금 코드 값으로 다시 저장하고, 맵 버전이 낮으면 관리자에게 알린다(월드는 world.sk 의 on load 가 불러온다)
on load:
	wait 2 seconds
	set {_w} to Bukkit.getWorld("mafia_map")
	if {_w} is not set:
		stop
	mBSaveSpots({_w})
	mBVerWarn()

function mBVerWarn():
	if {mcfg::mapver} is mBVer():
		stop
	loop all players:
		if loop-player is op:
			send "&e맵 구조가 바뀌었습니다. /mbuild 를 다시 실행해 주세요." to loop-player

on join:
	if player is op:
		if Bukkit.getWorld("mafia_map") is set:
			wait 1 second
			mBVerWarn()

command /mbuild [<text>]:
	permission: minecraft.command.op
	permission message: &c권한이 없습니다.
	description: 마피아 게임 맵 자동 생성 (관리자 전용)
	executable by: players
	trigger:
		if player is not op:
			send "&c관리자만 사용할 수 있습니다."
			stop
		if arg-1 is "tp":
			set {_l} to mLocLoad("game")
			if {_l} is not set:
				send "&c아직 맵이 없습니다. /mbuild 로 먼저 지어 주세요."
				stop
			mTp(player, {_l})
			stop
		if mState() is not "lobby":
			send "&c게임 중에는 지을 수 없습니다."
			stop
		send "&7맵을 짓는 중입니다... (잠깐 멈출 수 있습니다)"
		mBuild()
		send "&a맵을 지었습니다. 게임 월드 위치와 연출 장소 6곳을 정했습니다. &7(/mbuild tp 로 이동, /madmin 에서 조정)"
		mTp(player, mLocLoad("game"))
