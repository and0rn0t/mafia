# ==============================================================================
# [mbuild.sk] 마피아 게임 맵 자동 생성(관리자 전용). 빈 월드 "mafia_map" 에 원탁 마당, 밤 방, 밤 대상 선택 침대 줄을 짓고
#             게임 월드 위치와 연출 장소 6곳(mscene.sk), 원탁 반지름 등 숫자 설정까지 정한다.
# 명령: /mbuild        맵을 짓는다(이미 있으면 같은 자리에 다시 덮어 짓는다. 예전 건물도 지운다). 짓는 동안 서버가 잠깐 멈출 수 있다.
#       /mbuild tp     원탁 마당으로 이동
# 낮/밤 구분: 하늘이 보이게 지붕 없는 야외로 짓고, mscene.sk 가 단계마다 플레이어별 하늘 시간을 바꾼다(밤 = 자정, 낮 = 정오).
#   둘레 넓게 풀밭을 깔아 지평선이 보이게 했다.
# 배치(월드 mafia_map, 바닥 블록 y=64, 바닥 위 y=65):
#   풀밭      x -30~70, z -30~45 (y=64 잔디)
#   원탁 마당 x,z -10~10, 지붕 없음. 둘레 낮은 담(±11, 1칸 + 반 블록)과 기둥 8개(위에 랜턴). 원탁(반 블록 판자)은 (0,0) 중심, 더미 자리 반지름 3.2
#             낮 카메라: 남쪽 담 가까이 높은 곳(눈 y=69)에서 원탁과 하늘을 같이 본다
#   밤 방     x 37~43, z -3~3, 지붕 있음. 북쪽 벽은 유리창(밤하늘이 보임). 조명은 촛불 하나. 자기 더미는 방 가운데, 카메라는 남쪽 위에서 창 쪽을 본다
#   침대 줄   야외(지붕 없음), 조명 없음(달빛만). 가문비나무 바닥 x 32~48, z 18~21 위에 붉은 침대 7개(x 34,36,...,46, 머리 북쪽 z=19)
#             가운데 침대(x=40)가 지금 후보, 양옆(x=42 화면 왼쪽, x=38 화면 오른쪽)이 이전/다음 후보. 카메라는 머리 쪽(북쪽) 위에서 남쪽을 내려다본다
# 월드 설정: 몹 생성 끔, 시간 정오 고정, 날씨 고정, 구조물 없음. world.sk 의 자동 불러오기 목록({worldlist::mafia_map})에 넣는다.
# 미검증: 전체(서버 실행 불가). 특히 마네킹이 앉는 높이와 침대에 눕는 위치/방향은 실제로 보고 조정해야 한다
#   (숫자는 /madmin 장소·카메라 메뉴에서 바꿀 수 있고, /mbuild 를 다시 하면 여기 값으로 돌아간다).
# ==============================================================================

import:
	org.bukkit.Bukkit
	org.bukkit.Location
	org.bukkit.Material
	org.bukkit.GameRule
	org.bukkit.WorldCreator
	org.bukkit.WorldType
	org.bukkit.util.Vector

function mBWorld() :: world:
	set {_w} to Bukkit.getWorld("mafia_map")
	if {_w} is set:
		return {_w}
	set {_c} to new WorldCreator("mafia_map")
	{_c}.type(WorldType.FLAT)
	{_c}.generatorSettings("{""layers"":[{""block"":""minecraft:air"",""height"":1}],""biome"":""minecraft:the_void""}")
	{_c}.generateStructures(false)
	set {_w} to Bukkit.createWorld({_c})
	set {worldlist::mafia_map} to "mafia_map"
	return {_w}

# 블록 하나(블록 데이터 문자열, 예: "minecraft:stone_bricks" 또는 "minecraft:red_bed[part=head,facing=north]")
function mBSet(w: world, x: number, y: number, z: number, d: text):
	{_w}.getBlockAt({_x}, {_y}, {_z}).setBlockData(Bukkit.createBlockData({_d}), false)

# 직육면체 채우기(양 끝 포함)
function mBFill(w: world, x1: number, y1: number, z1: number, x2: number, y2: number, z2: number, d: text):
	set {_bd} to Bukkit.createBlockData({_d})
	loop integers between {_x1} and {_x2}:
		set {_x} to loop-value-1
		loop integers between {_y1} and {_y2}:
			set {_y} to loop-value-2
			loop integers between {_z1} and {_z2}:
				{_w}.getBlockAt({_x}, {_y}, loop-value-3).setBlockData({_bd}, false)

# 방 하나: 바닥(y0), 벽, 천장(y1), 안은 비운다. 안쪽 범위는 x1~x2, z1~z2.
function mBRoom(w: world, x1: number, z1: number, x2: number, z2: number, y0: number, y1: number, floor: text, wall: text, ceil: text):
	mBFill({_w}, {_x1} - 1, {_y0}, {_z1} - 1, {_x2} + 1, {_y1}, {_z2} + 1, {_wall})
	mBFill({_w}, {_x1}, {_y0} + 1, {_z1}, {_x2}, {_y1} - 1, {_z2}, "minecraft:air")
	mBFill({_w}, {_x1}, {_y0}, {_z1}, {_x2}, {_y0}, {_z2}, {_floor})
	mBFill({_w}, {_x1}, {_y1}, {_z1}, {_x2}, {_y1}, {_z2}, {_ceil})

# 위치 저장: (x,y,z)에서 (tx,ty,tz)를 바라보는 방향으로
function mBSaveLook(key: text, w: world, x: number, y: number, z: number, tx: number, ty: number, tz: number):
	set {_l} to new Location({_w}, {_x}, {_y}, {_z})
	{_l}.setDirection(new Vector({_tx} - {_x}, {_ty} - {_y}, {_tz} - {_z}))
	mLocSave({_key}, {_l})

# 위치 저장: 정한 방향(yaw)으로
function mBSaveYaw(key: text, w: world, x: number, y: number, z: number, yaw: number):
	set {_l} to new Location({_w}, {_x}, {_y}, {_z}, {_yaw}, 0)
	mLocSave({_key}, {_l})

function mBuild():
	set {_w} to mBWorld()
	{_w}.setGameRule(GameRule.DO_MOB_SPAWNING, false)
	{_w}.setGameRule(GameRule.DO_DAYLIGHT_CYCLE, false)
	{_w}.setGameRule(GameRule.DO_WEATHER_CYCLE, false)
	{_w}.setTime(6000)
	{_w}.setSpawnLocation(0, 65, -8)
	# ---- 예전 건물 지우기(지붕 있던 홀/침대 방)
	mBFill({_w}, -12, 64, -12, 12, 73, 12, "minecraft:air")
	mBFill({_w}, 35, 64, -5, 45, 70, 5, "minecraft:air")
	mBFill({_w}, 30, 64, 14, 50, 70, 26, "minecraft:air")
	# ---- 풀밭(지평선)
	mBFill({_w}, -30, 64, -30, 70, 64, 45, "minecraft:grass_block")
	# ---- 원탁 마당(지붕 없음)
	mBFill({_w}, -10, 64, -10, 10, 64, 10, "minecraft:dark_oak_planks")
	loop -11, 11:
		set {_a} to loop-value
		mBFill({_w}, {_a}, 64, -11, {_a}, 65, 11, "minecraft:stone_bricks")
		mBFill({_w}, {_a}, 66, -11, {_a}, 66, 11, "minecraft:stone_brick_slab[type=bottom]")
		mBFill({_w}, -11, 64, {_a}, 11, 65, {_a}, "minecraft:stone_bricks")
		mBFill({_w}, -11, 66, {_a}, 11, 66, {_a}, "minecraft:stone_brick_slab[type=bottom]")
	loop -11, 0, 11:
		set {_x} to loop-value-1
		loop -11, 0, 11:
			set {_z} to loop-value-2
			if {_x} is not 0:
				mBFill({_w}, {_x}, 65, {_z}, {_x}, 68, {_z}, "minecraft:stone_bricks")
				mBSet({_w}, {_x}, 69, {_z}, "minecraft:lantern")
			else if {_z} is not 0:
				mBFill({_w}, {_x}, 65, {_z}, {_x}, 68, {_z}, "minecraft:stone_bricks")
				mBSet({_w}, {_x}, 69, {_z}, "minecraft:lantern")
	# 바닥 무늬: 가운데 붉은 원(반지름 5 안쪽)은 붉은 카펫
	loop integers between -5 and 5:
		set {_x} to loop-value-1
		loop integers between -5 and 5:
			set {_z} to loop-value-2
			if {_x} * {_x} + {_z} * {_z} <= 25:
				mBSet({_w}, {_x}, 65, {_z}, "minecraft:red_carpet")
	# 원탁: 반지름 2 안쪽 반 블록 판자
	loop integers between -2 and 2:
		set {_x} to loop-value-1
		loop integers between -2 and 2:
			set {_z} to loop-value-2
			if {_x} * {_x} + {_z} * {_z} <= 5:
				mBSet({_w}, {_x}, 65, {_z}, "minecraft:dark_oak_slab[type=bottom]")
	# ---- 밤 방(지붕 있음, 북쪽 유리창, 촛불 하나)
	mBRoom({_w}, 37, -3, 43, 3, 64, 69, "minecraft:spruce_planks", "minecraft:deepslate_bricks", "minecraft:spruce_planks")
	mBFill({_w}, 37, 65, -4, 43, 68, -4, "minecraft:glass")
	mBSet({_w}, 40, 65, 0, "minecraft:black_carpet")
	mBSet({_w}, 42, 65, 2, "minecraft:candle[candles=1,lit=true]")
	# ---- 밤 대상 선택 침대 줄(야외, 조명 없음)
	mBFill({_w}, 32, 64, 18, 48, 64, 21, "minecraft:spruce_planks")
	loop 34, 36, 38, 40, 42, 44, 46:
		mBSet({_w}, loop-value, 65, 19, "minecraft:red_bed[part=head,facing=north]")
		mBSet({_w}, loop-value, 65, 20, "minecraft:red_bed[part=foot,facing=north]")
	# ---- 위치와 설정
	mBSaveYaw("game", {_w}, 0.5, 65, -8.5, 0)
	mBSaveYaw("table", {_w}, 0.5, 65, 0.5, 0)
	mBSaveLook("daycam", {_w}, 0.5, 69, -9, 0.5, 65.8, 0.5)
	mBSaveYaw("room", {_w}, 40.5, 65, 0.5, 0)
	mBSaveLook("nightcam", {_w}, 40.5, 67, 3, 40.5, 65.9, 0.5)
	mBSaveYaw("bed", {_w}, 40.5, 65.6875, 19.5, 180)
	mBSaveLook("bedcam", {_w}, 40.5, 67.6, 17.4, 40.5, 65.7, 19.9)
	set {mcfg::scene::radius} to 3.2
	set {mcfg::scene::facedist} to 1.4
	set {mcfg::scene::faceh} to 1.1
	set {mcfg::scene::bedgap} to 2

command /mbuild [<text>]:
	permission: minecraft.command.op
	permission message: &c권한이 없습니다.
	description: 마피아 게임 맵 자동 생성 (관리자 전용)
	executable by: players
	trigger:
		if player is not op:
			send "&c관리자만 사용할 수 있습니다."
			stop
		if arg-1 is "tp":
			set {_l} to mLocLoad("game")
			if {_l} is not set:
				send "&c아직 맵이 없습니다. /mbuild 로 먼저 지어 주세요."
				stop
			mTp(player, {_l})
			stop
		if mState() is not "lobby":
			send "&c게임 중에는 지을 수 없습니다."
			stop
		send "&7맵을 짓는 중입니다... (잠깐 멈출 수 있습니다)"
		mBuild()
		send "&a맵을 지었습니다. 게임 월드 위치와 연출 장소 6곳을 정했습니다. &7(/mbuild tp 로 이동, /madmin 에서 조정)"
		mTp(player, mLocLoad("game"))
