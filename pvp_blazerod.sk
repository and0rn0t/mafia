# [blazerod.sk] 블레이즈 지팡이 스킬(우클릭, 쿨 4초): 사용 0.2초 후 화염구 발사, 맞으면 폭발해서 범위 피해 5(블럭 피해 없음), 불꽃 이펙트로 궤적. 3번째 사용은 플레이어 뒤쪽 5개 지점에서 바라보는 지점으로 화염구 5개가 날아간다.
# 환경, 작업 규칙, 변수 목록, 스킬 추가 절차는 skill_core.sk 맨 위 주석을 먼저 읽을 것.
# 이 파일이 쓰는 변수: {-brcd}(쿨타임 종료 시각), {-brcount}(연속 사용 횟수), {-brlast}(마지막 사용 시각), {-fb::화염구uuid}(우리 화염구 표시, main.sk 가 읽어서 직접 맞은 피해를 취소), {-fbowner::화염구uuid}(쏜 플레이어),
#   {-fbhit::uuid}(폭발 피해 순간 표시, 킬로그가 화염구 아이콘을 고르는 데 씀), {-skilldmg}(피해를 주는 동안만), {-skillitems::blaze_rod}
# 쿨 4초는 발사 딜레이(0.2초)를 뺀 값이라 사용 시점부터 4.2초로 건다. 3번째 사용 때 화염구 5개를 5틱 간격으로 떨어뜨리고 횟수는 0 으로 돌아간다.
# 횟수는 마지막 사용 후 brReset() 초 동안 안 쓰면 0 으로 돌아간다(기획에 없어서 내가 정한 값, 확인 필요).
# 화염구: 큰 화염구(fireball) 엔티티(작은 화염구보다 큼). 바닐라 폭발은 위력 0(setYield(0)) + 점화 끔(setIsIncendiary(false))이라 블럭/불 피해가 없고,
#   바닐라 폭발은 on explosion 에서 취소하고, 맞는 순간(on projectile hit) 같은 자리에서 폭발 이펙트와 범위(brRadius) 안 모두에게 고정 피해 실 체력 5 를 우리가 직접 준다(TNT 의 tntBlast 와 같은 방식, 피해 출처는 쏜 사람).
#   쏜 사람 본인과 아군({-team} isAlly)은 피해를 안 받고 갑옷 거치대는 제외한다. 직접 맞은 바닐라 피해는 main.sk 에서 취소한다(이중 피해 방지).
# 화염구 속도는 brSpeed()(현재 2칸/틱). 3번째 사용은 낙하 직전마다 폭격 지점 brHomeRange()(8칸) 안 가장 가까운 적을 찾아 그 적 위치 반경 1.5칸 안으로 목표를 옮긴다(적 없으면 기존대로).
# 3번째 사용: 바라보는 지점(블럭이면 그 블럭 윗면, 아니면 30칸 앞) 반경 3칸 안 무작위 지점이 낙하 목표. 발사 지점은 플레이어 눈 기준 뒤 4칸, 위 3칸에서 좌우 2칸 간격 5곳(목표/유도는 그대로, 각 화염구는 자기 발사 지점에서 목표로 날아간다).
# 사운드: 사용 시 item.firecharge.use + entity.evoker.prepare_summon(3번째 사용은 낮고 크게). 미검증(사운드 체감): evoker 소리 길이/크기.
# 미검증: brHome(함수 반환 location 비교 `is not`, gamemode/distance 문법), fireball 스폰/setShooter/setDirection/setYield/setIsIncendiary, getTargetBlockExact, 파티클 FLAME, projectile hit 에서 shooter 읽기.

using damage sources

import:
	org.bukkit.Particle

on load:
	set {-skillitems::blaze_rod} to blaze rod

# 연속 사용 횟수가 0 으로 돌아가는 시간(초). 이 시간 안에 계속 써야 3번째 사용이 된다.
function brReset() :: number:
	return 10

# 폭발 범위(반경, 칸)
function brRadius() :: number:
	return 3

# 화염구 속도(칸/틱). 기존 1 에서 상향
function brSpeed() :: number:
	return 2

# 3번째 사용 폭격 유도 반경(칸). 폭격 지점 이 반경 안에 적이 있으면 그 적 쪽으로 목표가 옮겨진다
function brHomeRange() :: number:
	return 8

# 폭격 지점 tp 근처(brHomeRange 안)에 적(본인/아군/관전자 제외)이 있으면 가장 가까운 적의 위치를, 없으면 tp 를 돌려준다.
function brHome(owner: player, tp: location) :: location:
	set {_oid} to "%uuid of {_owner}%"
	set {_best} to brHomeRange()
	set {_res} to {_tp}
	loop all players:
		set {_e} to loop-player
		set {_vid} to "%uuid of {_e}%"
		if {_vid} is not {_oid}:
			if gamemode of {_e} is not spectator:
				if health of {_e} > 0:
					if isAlly({_oid}, {_vid}) is false:
						set {_el} to location of {_e}
						if world of {_el} is world of {_tp}:
							set {_dd} to distance between {_el} and {_tp}
							if {_dd} < {_best}:
								set {_best} to {_dd}
								set {_res} to {_el}
	return {_res}

# 폭발: 이펙트 + 범위 안 피해 5(쏜 사람/아군/갑옷 거치대 제외, 블럭 피해 없음)
function brBlast(owner: player, loc: location):
	set {_r} to brRadius()
	soundAround("entity.generic.explode", {_loc}, 1, 1.3)
	play 1 large explosion at {_loc} in radius of 100
	{_loc}.getWorld().spawnParticle(Particle.FLAME, {_loc}, 60, 1.2, 1.2, 1.2, 0.08, null, true)
	set {_hasp} to false
	if {_owner} is online:
		set {_hasp} to true
	set {_oid} to "%uuid of {_owner}%"
	if {_hasp} is true:
		set {_src} to a custom damage source:
			set the damage type to player explosion
			set the causing entity to {_owner}
			set the direct entity to {_owner}
		set {-skilldmg::%{_oid}%} to true
	delete {_hit::*}
	loop all living entities in radius {_r} around {_loc}:
		set {_e} to loop-entity
		if {_e} is not an armor stand:
			set {_vid} to "%uuid of {_e}%"
			if {_vid} is not {_oid}:
				if isAlly({_oid}, {_vid}) is false:
					set {-fbhit::%{_vid}%} to true
					add {_vid} to {_hit::*}
					if {_hasp} is true:
						damage {_e} by hp(5) hearts using {_src}
					else:
						damage {_e} by hp(5) hearts
	delete {-skilldmg::%{_oid}%}
	wait 1 tick
	loop {_hit::*}:
		delete {-fbhit::%loop-value%}

# from 에서 to 방향으로 화염구 하나를 쏘고 궤적을 그린다. 맞거나 사라질 때까지 따라가며 불꽃을 뿌린다.
function brFire(p: player, from: location, to: location):
	set {_d} to vector from {_from} to {_to}
	set {_vel} to (normalized {_d}) * brSpeed()
	spawn a fireball at {_from}:
		set {_f} to event-entity
		# 표시를 먼저 한다(아래 reflect 호출이 오류로 중간에 멈춰도 on explosion 이 바닐라 폭발을 취소할 수 있게)
		set {-fb::%uuid of event-entity%} to true
		set {-fbowner::%uuid of event-entity%} to {_p}
		{_f}.setShooter({_p})
		{_f}.setIsIncendiary(false)
		{_f}.setYield(0)
		{_f}.setDirection({_vel})
		set velocity of event-entity to {_vel}
	set {_fid} to uuid of {_f}
	soundAround("entity.blaze.shoot", {_from}, 1, 1)
	loop 80 times:
		if {_f} is not alive:
			exit loop
		set {_l} to location of {_f}
		{_l}.getWorld().spawnParticle(Particle.FLAME, {_l}, 4, 0.15, 0.15, 0.15, 0.01, null, true)
		wait 1 tick
	delete {_f}
	delete {-fb::%{_fid}%}
	delete {-fbowner::%{_fid}%}

# 우리 화염구의 바닐라 폭발(블럭 피해/바닐라 피해)을 취소한다. 피해와 이펙트는 아래 맞는 순간 처리(brBlast)가 한다.
on explosion:
	set {_e} to event-entity
	if {_e} is a fireball:
		if {-fb::%uuid of {_e}%} is set:
			cancel event

# 우리 화염구가 어딘가에 맞으면 그 자리에서 폭발시킨다
on projectile hit:
	if {-fb::%uuid of projectile%} is set:
		set {_fid} to uuid of projectile
		set {_o} to {-fbowner::%{_fid}%}
		set {_l} to location of projectile
		# 표시를 지우지 않고 화염구도 지우지 않는다: 이 이벤트 뒤에 바닐라가 같은 틱에 폭발시키는데, 그 폭발을 아래 on explosion 이 취소해야 한다.
		# (엔티티를 여기서 지워도 바닐라 폭발은 그대로 일어나서 블럭/피해가 생기고 킬로그가 건파우더로 나왔다.) 표시는 brFire 의 궤적 루프가 끝나면 지운다.
		if {_o} is a player:
			brBlast({_o}, {_l})
		else:
			soundAround("entity.generic.explode", {_l}, 1, 1.3)

on rightclick:
	if skillHand(player, blaze rod) is false:
		stop
	cancel event
	set {_p} to player
	set {_id} to "%player's uuid%"
	if {-brcd::%{_id}%} is set:
		if {-brcd::%{_id}%} > now:
			stop
	set {-brcd::%{_id}%} to now + 4200 milliseconds
	set item cooldown of blaze rod for {_p} to 4200 milliseconds
	set {_n} to {-brcount::%{_id}%}
	if {_n} is not a number:
		set {_n} to 0
	if {-brlast::%{_id}%} is set:
		set {_lim} to brReset()
		set {_since} to now - {-brlast::%{_id}%}
		set {_ms} to {_since}.getMilliSeconds()
		if {_ms} > {_lim} * 1000:
			set {_n} to 0
	set {_n} to {_n} + 1
	set {-brlast::%{_id}%} to now
	set {_triple} to false
	if {_n} >= 3:
		set {_triple} to true
		set {-brcount::%{_id}%} to 0
	else:
		set {-brcount::%{_id}%} to {_n}
	soundAround("item.firecharge.use", location of {_p}, 0.9, 0.8)
	# 시전음: 에보커 소환 준비음을 약하게 겹친다(주문을 외우는 느낌). 3번째 사용은 더 낮은 음으로 구분한다.
	if {_triple} is true:
		soundAround("entity.evoker.prepare_summon", location of {_p}, 0.7, 0.8)
	else:
		soundAround("entity.evoker.prepare_summon", location of {_p}, 0.5, 1.3)
	wait 4 ticks
	if {_p} is not online:
		stop
	if health of {_p} <= 0:
		stop
	if {_triple} is false:
		set {_eye} to {_p}.getEyeLocation()
		set {_dir} to {_eye}.getDirection()
		set {_from} to {_eye} ~ {_dir}
		set {_to} to {_eye} ~ ({_dir} * 30)
		brFire({_p}, {_from}, {_to})
		stop
	# 3번째 사용: 바라보는 지점 위쪽에서 사선으로 떨어지는 화염구 5개(목표는 그 지점 반경 3칸 안 무작위)
	set {_eye} to {_p}.getEyeLocation()
	set {_dir} to {_eye}.getDirection()
	set {_blk} to {_p}.getTargetBlockExact(40)
	if {_blk} is set:
		set {_tp} to {_blk}.getLocation() ~ vector(0.5, 1, 0.5)
	else:
		set {_tp} to {_eye} ~ ({_dir} * 30)
	# 발사 지점 5곳: 플레이어 뒤쪽(바라보는 방향의 반대 {_bk}칸, 위로 {_up}칸)에서 좌우로 {_sp}칸 간격으로 나란히. 수직으로 볼 때를 대비해 수평 길이가 너무 짧으면 앞쪽 기본값 사용
	set {_bk} to 4
	set {_up} to 3
	set {_sp} to 2
	set {_hx} to x of {_dir}
	set {_hz} to z of {_dir}
	set {_hl} to sqrt({_hx} * {_hx} + {_hz} * {_hz})
	if {_hl} < 0.01:
		set {_hx} to 0
		set {_hz} to 1
		set {_hl} to 1
	set {_bx} to 0 - {_hx} / {_hl} * {_bk}
	set {_bz} to 0 - {_hz} / {_hl} * {_bk}
	set {_sx} to 0 - {_hz} / {_hl}
	set {_sz} to {_hx} / {_hl}
	loop 5 times:
		if {_p} is not online:
			stop
		if health of {_p} <= 0:
			stop
		set {_ang} to random number between 0 and 360
		set {_hm} to brHome({_p}, {_tp})
		set {_rd} to random number between 0 and 3
		if {_hm} is not {_tp}:
			set {_rd} to random number between 0 and 1.5
		set {_lx} to cos({_ang}) * {_rd}
		set {_lz} to sin({_ang}) * {_rd}
		set {_to} to {_hm} ~ vector({_lx}, 0, {_lz})
		set {_sd} to (loop-value - 3) * {_sp}
		set {_from} to {_eye} ~ vector({_bx} + {_sx} * {_sd}, {_up}, {_bz} + {_sz} * {_sd})
		brFire({_p}, {_from}, {_to})
		wait 5 ticks

on join:
	delete {-brcd::%player's uuid%}
	delete {-brcount::%player's uuid%}
