# ==============================================================================
# [mstage.sk] 낮/처형/종료/시작 컷신. 규칙은 ROLES.md "화면 연출", 구조는 DESIGN.md. 밤 처리 연출은 mfx.sk.
#   아침 발표(mStgMorning): 낮이 시작되면 모두에게 "N일차 낮" → 지난 밤 사망자마다 원탁 자리(해골) 얼굴 클로즈업 + 타이틀 빨간 닉네임 / 서브타이틀 흰색 사망 안내, 1.5초씩
#     → 기자 특종: 취재 대상 얼굴 클로즈업 + 타이틀 "특종" / 서브타이틀 닉네임 → 액션바와 채팅으로 직업 공개 → 각자 기본 화면. 발표 시간만큼 토론 시간이 늘어난다(mStartDay).
#   화형(mStgBurn): 투표로 처형되면 모두 처형된 사람 얼굴 클로즈업, 더미에 불이 붙고 둘레 바닥이 불탄 뒤 해골이 된다(그동안 처형 단계). 테러리스트면 이어서 길동무 선택 화면.
#   길동무 TNT(mStgTnt): 원탁 전체 화면에서 테러리스트 자리에서 길동무 자리로 TNT 가 날아가 터지고(블록 피해 없음, 실제 폭발이 아니라 소리와 파티클) 길동무가 해골이 된 뒤 밤이 된다.
#   승리 라인업(mStgLineup): 게임이 끝나면 관리자 메뉴에서 정한 위치({mcfg::loc::lineup::...}, mbuild 가 건드리지 않음)에 승리 팀 더미를 일렬로 세우고
#     모두 그 앞 카메라로 본다(결과창은 나중에 그 뒤에 세울 예정). 위치가 없으면 하지 않는다. 무승부도 하지 않는다.
#   시작 로딩: mBegin 이 5초 loading 단계를 만들고, 그동안 원탁 전체 화면 + 액션바 노란 "loading..."(이 파일의 every second).
#     끝나면 mStgReveal: 채팅창과 액션바를 비우고 직업 안내(mjoin.sk 의 mRoleReveal, 팀 색), 마피아끼리 알림.
# 해골 바꾸기 미루기: 컷신이 있는 사망은 mStgHold 로 표시해 두고 mSceneDead 가 바로 해골로 바꾸지 않게 한 뒤, 컷신이 끝날 때 mStgRelease 가 바꾼다.
# 변수: {-ms::hold::uuid}(해골 미루기) {-ms::stage}(컷신 중: 관전자 A/D 시점 바꾸기를 막음)
# 미검증: 전체(서버 실행 불가). TNT 엔티티 이동, 더미 불 붙이기(setFireTicks), 다른 월드 라인업 카메라.
# ==============================================================================

import:
	org.bukkit.Bukkit
	org.bukkit.Location
	org.bukkit.Particle
	org.bukkit.entity.EntityType
	org.bukkit.util.Vector
	org.bukkit.Color
	org.bukkit.Material
	org.bukkit.inventory.ItemStack
	org.bukkit.potion.PotionEffect
	org.bukkit.potion.PotionEffectType
	org.bukkit.entity.Display$Billboard as StgBillboard
	net.kyori.adventure.text.serializer.legacy.LegacyComponentSerializer

# 카메라가 있는 모든 사람(참가자 + 관전자)
function mStgViewers() :: texts:
	loop {-m::players::*}:
		if {-ms::cam::%loop-value%} is set:
			add loop-value to {_l::*}
	loop {-ms::spec::*}:
		add loop-value to {_l::*}
	return {_l::*}

function mStgTitle(vid: text, t: text, s: text, ticks: number):
	set {_p} to mPlayerOf({_vid})
	if {_p} is set:
		# 표시 시간은 변수로 "N ticks" 를 쓸 수 없어서 글자를 시간으로 바꿔 넘긴다
		set {_ts} to "%{_ticks}% ticks" parsed as timespan
		send title {_t} with subtitle {_s} to {_p} for {_ts} with fadein 5 ticks and fade out 5 ticks

function mStgSoundAll(s: text, v: number, pi: number):
	loop mStgViewers():
		set {_p} to mPlayerOf(loop-value)
		if {_p} is set:
			mSound({_p}, {_s}, {_v}, {_pi})

function mStgShakeAll(n: number, amp: number):
	loop mStgViewers():
		mCamShake(loop-value, {_n}, {_amp})

# 원탁 자리 위(높이 dy)에 파티클
function mStgSeatPart(id: text, name: text, n: number, dy: number):
	set {_i} to {-ms::seat::%{_id}%}
	if {_i} is not set:
		stop
	set {_s} to mScSeatLoc({_i})
	set {_y} to {_s}.getY()
	add {_dy} to {_y}
	set {_l} to new Location({_s}.getWorld(), {_s}.getX(), {_y}, {_s}.getZ())
	mStgPartAll({_name}, {_l}, {_n})

function mStgPartAll(name: text, l: location, n: number):
	loop mStgViewers():
		set {_p} to mPlayerOf(loop-value)
		if {_p} is set:
			{_p}.spawnParticle(Particle.valueOf({_name}), {_l}, {_n}, 0.4, 0.4, 0.4, 0)

# ------------------------------------------------------------------ 해골 바꾸기 미루기

function mStgHold(id: text):
	if mSceneOn() is true:
		set {-ms::hold::%{_id}%} to true

function mStgRelease(id: text):
	delete {-ms::hold::%{_id}%}
	mSceneDead({_id})

# ------------------------------------------------------------------ 아침 발표

# 발표에 걸리는 초(낮 제목 2 + 사망자마다 2 + 특종마다 4)
function mStgMorningLen() :: number:
	if mSceneOn() is not true:
		return 0
	set {_r} to size of {-m::dead::*}
	set {_r} to {_r} * 2
	set {_q} to size of {-m::rep::*}
	set {_q} to {_q} * 4
	set {_s} to size of {-m::solrev::*}
	set {_s} to {_s} * 2
	return 2 + {_r} + {_q} + {_s}

function mStgMorning():
	if mSceneOn() is not true:
		stop
	set {-ms::stage} to true
	set {_dead::*} to {-m::dead::*}
	set {_rep::*} to {-m::rep::*}
	set {_sol::*} to {-m::solrev::*}
	set {_sub} to "&7지난 밤에는 아무도 사망하지 않았습니다"
	if size of {_dead::*} > 0:
		set {_sub} to ""
	loop mStgViewers():
		mViewAuto(loop-value)
		mStgTitle(loop-value, "&e%{-m::day}%일차 낮", {_sub}, 35)
	wait 40 ticks
	loop {_dead::*}:
		set {_d} to loop-value
		set {_dn} to mNameOf({_d})
		loop mStgViewers():
			mCamFace(loop-value-2, {_d})
			mStgTitle(loop-value-2, "&c%{_dn}%", "&f님이 사망했습니다", 35)
		mStgSoundAll("block.bell.use", 0.6, 0.6)
		mStgSoundAll("block.bell.resonate", 0.4, 0.8)
		mStgSeatPart({_d}, "SOUL", 20, 1)
		mStgSeatPart({_d}, "SMOKE", 10, 1)
		wait 40 ticks
		if mSceneOn() is not true:
			stop
	# 공격을 버텨낸 군인: 얼굴을 비추고 직업 공개(확정)
	loop {_sol::*}:
		set {_sd} to loop-value
		set {_sn} to mNumName({_sd})
		loop mStgViewers():
			mCamFace(loop-value-2, {_sd})
			mStgTitle(loop-value-2, "&a군인", "%{_sn}%&7 님이 공격을 버텨냈습니다", 35)
		mStgSoundAll("item.shield.block", 1, 1)
		mStgSoundAll("block.anvil.place", 0.6, 1.8)
		mStgSeatPart({_sd}, "ELECTRIC_SPARK", 20, 1.2)
		mBc("%{_sn}%&7 님은 &a군인&7이었습니다! 공격을 버텨냈습니다.")
		wait 40 ticks
		if mSceneOn() is not true:
			stop
	loop {_rep::*}:
		set {_r} to loop-value
		set {_rn} to mNameOf({_r})
		set {_role} to mRoleName({-m::role::%{_r}%})
		loop mStgViewers():
			mCamFace(loop-value-2, {_r})
			mStgTitle(loop-value-2, "&6특종", "&f%{_rn}%", 40)
		mStgSoundAll("ui.cartography_table.take_result", 1, 1)
		wait 20 ticks
		mStgSoundAll("entity.firework_rocket.blast", 0.7, 1.4)
		mStgSeatPart({_r}, "END_ROD", 25, 1.2)
		mStgSeatPart({_r}, "FIREWORK", 20, 1.2)
		wait 20 ticks
		if mSceneOn() is not true:
			stop
		mBc("&6[특종] &f%{_rn}%&e 님의 직업은 &f%{_role}%&e입니다.")
		loop mStgViewers():
			set {_p} to mPlayerOf(loop-value-2)
			if {_p} is set:
				send action bar colored "&6[특종] &f%{_rn}%&e 님의 직업은 &f%{_role}%&e입니다." to {_p}
		wait 40 ticks
		if mSceneOn() is not true:
			stop
	delete {-ms::stage}
	# 사망자·특종 화면으로 옮겼을 때만 원래 화면으로 돌린다(아무 일 없던 아침에는 카메라를 다시 움직이지 않는다)
	set {_moved} to size of {_dead::*}
	add size of {_rep::*} to {_moved}
	add size of {_sol::*} to {_moved}
	if {_moved} > 0:
		loop mStgViewers():
			mViewAuto(loop-value)

# ------------------------------------------------------------------ 화형

function mStgBurnLen() :: number:
	if mSceneOn() is not true:
		return 1
	return 5

function mStgBurn(x: text):
	if mSceneOn() is not true:
		mStgAfterBurn({_x})
		stop
	set {-ms::stage} to true
	set {_xn} to mNameOf({_x})
	loop mStgViewers():
		mCamFace(loop-value, {_x})
		mStgTitle(loop-value, "&c%{_xn}%", "&f화형에 처해졌습니다", 70)
	set {_m} to {-ms::dummy::%{_x}%}
	set {_i} to {-ms::seat::%{_x}%}
	if {_i} is set:
		set {_s} to mScSeatLoc({_i})
	mStgSoundAll("entity.villager.no", 0.6, 0.8)
	wait 10 ticks
	mStgSoundAll("item.flintandsteel.use", 1, 1)
	mStgSoundAll("item.firecharge.use", 1, 0.9)
	mStgShakeAll(6, 0.05)
	mStgSeatPart({_x}, "FLAME", 30, 0.8)
	if {_m} is set:
		{_m}.setFireTicks(200)
		{_m}.playHurtAnimation(0)
	# 둘레 바닥 불(모두의 화면에만, 실제 블록은 그대로)
	if {_s} is set:
		set {_fire} to Bukkit.createBlockData("minecraft:fire")
		loop -1, 0, 1:
			set {_dx} to loop-value-1
			loop -1, 0, 1:
				set {_dz} to loop-value-2
				set {_mid} to false
				if {_dx} is 0:
					if {_dz} is 0:
						set {_mid} to true
				if {_mid} is false:
					set {_fx2} to {_s}.getBlockX()
					add {_dx} to {_fx2}
					set {_fz2} to {_s}.getBlockZ()
					add {_dz} to {_fz2}
					set {_fy2} to {_s}.getBlockY()
					set {_sw} to {_s}.getWorld()
					set {_l} to new Location({_sw}, {_fx2}, {_fy2}, {_fz2})
					add {_l} to {_fl::*}
		loop mStgViewers():
			set {_p} to mPlayerOf(loop-value-1)
			if {_p} is set:
				loop {_fl::*}:
					{_p}.sendBlockChange(loop-value-2, {_fire})
	wait 10 ticks
	mStgSoundAll("entity.blaze.shoot", 1, 0.8)
	mStgSeatPart({_x}, "LAVA", 8, 0.8)
	wait 15 ticks
	mStgSoundAll("entity.player.hurt_on_fire", 1, 1)
	if {_m} is set:
		{_m}.playHurtAnimation(0)
	# 타는 동안 불소리·불꽃·연기(10틱마다)
	loop 3 times:
		mStgSoundAll("block.fire.ambient", 1, 1)
		mStgSeatPart({_x}, "FLAME", 15, 0.6)
		mStgSeatPart({_x}, "LARGE_SMOKE", 6, 1.6)
		wait 10 ticks
	wait 5 ticks
	if mSceneOn() is not true:
		stop
	mStgRelease({_x})
	mStgSoundAll("block.fire.extinguish", 1, 1)
	mStgSeatPart({_x}, "LARGE_SMOKE", 25, 1)
	mStgSeatPart({_x}, "SOUL", 15, 1)
	mStgShakeAll(4, 0.03)
	wait 15 ticks
	loop mStgViewers():
		set {_p} to mPlayerOf(loop-value-1)
		if {_p} is set:
			loop {_fl::*}:
				set {_l} to loop-value-2
				{_p}.sendBlockChange({_l}, {_l}.getBlock().getBlockData())
	delete {-ms::stage}
	mStgAfterBurn({_x})

# 화형이 끝난 뒤: 테러리스트면 길동무 선택 화면, 아니면 각자 기본 화면
function mStgAfterBurn(x: text):
	if {-m::exe} is {_x}:
		if mState() is "execute":
			mSceneTake({_x})
			stop
	loop mStgViewers():
		mViewAuto(loop-value)

# ------------------------------------------------------------------ 길동무 TNT

function mStgTntLen() :: number:
	return 6

function mStgTnt(t: text, v: text):
	if mSceneOn() is not true:
		mStgRelease({_v})
		stop
	set {-ms::stage} to true
	set {_vn} to mNameOf({_v})
	loop mStgViewers():
		mCamTo(loop-value, "daycam")
	set {_a} to mScSeatLoc({-ms::seat::%{_t}%})
	set {_b} to mScSeatLoc({-ms::seat::%{_v}%})
	set {_w} to {_a}.getWorld()
	wait 10 ticks
	set {_ax} to {_a}.getX()
	set {_az} to {_a}.getZ()
	set {_ay} to {_a}.getY()
	add 1.5 to {_ay}
	set {_ddx} to {_b}.getX()
	subtract {_ax} from {_ddx}
	set {_ddz} to {_b}.getZ()
	subtract {_az} from {_ddz}
	set {_tl} to new Location({_w}, {_ax}, {_ay}, {_az})
	set {_tnt} to {_w}.spawnEntity({_tl}, EntityType.TNT)
	{_tnt}.setGravity(false)
	{_tnt}.setFuseTicks(400)
	{_tnt}.setPersistent(false)
	{_tnt}.addScoreboardTag("mafia_tmp")
	mScTrack({_tnt})
	mStgSoundAll("entity.tnt.primed", 1, 1)
	# 포물선으로 25틱 동안 날아간다
	set {_k} to 0
	while {_k} < 25:
		wait 1 tick
		add 1 to {_k}
		set {_f} to {_k} / 25
		set {_x} to {_ddx} * {_f}
		add {_ax} to {_x}
		set {_z} to {_ddz} * {_f}
		add {_az} to {_z}
		set {_arc} to 1 - {_f}
		set {_arc} to {_arc} * {_f}
		set {_arc} to {_arc} * 12
		set {_y} to {_ay} + {_arc}
		{_tnt}.teleport(new Location({_w}, {_x}, {_y}, {_z}))
	{_tnt}.remove()
	set {_bx2} to {_b}.getX()
	set {_by2} to {_b}.getY()
	add 1 to {_by2}
	set {_bz2} to {_b}.getZ()
	set {_bl} to new Location({_w}, {_bx2}, {_by2}, {_bz2})
	mStgSoundAll("entity.generic.explode", 1, 1)
	mStgSoundAll("entity.dragon_fireball.explode", 0.6, 0.8)
	mStgPartAll("EXPLOSION_EMITTER", {_bl}, 1)
	mStgPartAll("LARGE_SMOKE", {_bl}, 20)
	mStgPartAll("FLAME", {_bl}, 30)
	mStgShakeAll(12, 0.15)
	if mSceneOn() is not true:
		stop
	mStgRelease({_v})
	loop mStgViewers():
		mStgTitle(loop-value, "&c%{_vn}%", "&f테러리스트의 길동무가 되었습니다", 50)
	wait 50 ticks
	delete {-ms::stage}
	loop mStgViewers():
		mViewAuto(loop-value)

# ------------------------------------------------------------------ 승리 라인업

# 승리 팀 참가자 uuid 목록
function mStgWinners(w: text) :: texts:
	if {_w} is "draw":
		return {_none::*}
	if {_w} starts with "neutral:":
		set {_id} to {_w}
		replace all "neutral:" in {_id} with ""
		add {_id} to {_l::*}
		return {_l::*}
	loop {-m::players::*}:
		set {_tm} to {-m::team::%loop-value%}
		if {_w} is "mafia":
			if {_tm} is "mafia":
				add loop-value to {_l::*}
			else if mRolePool({-m::role::%loop-value%}) is "support":
				add loop-value to {_l::*}
		else if {_w} is "citizen":
			if {_tm} is "citizen":
				add loop-value to {_l::*}
	return {_l::*}

function mStgLineup(w: text):
	if mSceneOn() is not true:
		stop
	if mLocSet("lineup") is false:
		stop
	set {_win::*} to mStgWinners({_w})
	set {_n} to size of {_win::*}
	set {_c} to mLocLoad("lineup")
	set {_yaw} to {_c}.getYaw()
	# 더미가 보는 방향(앞) f, 오른쪽 r
	set {_fx} to -1 * sin({_yaw})
	set {_fz} to cos({_yaw})
	set {_rx} to -1 * cos({_yaw})
	set {_rz} to -1 * sin({_yaw})
	set {_i} to 0
	loop {_win::*}:
		add 1 to {_i}
		set {_half} to {_n} + 1
		set {_half} to {_half} / 2
		set {_o} to {_i} - {_half}
		set {_o} to {_o} * 1.2
		set {_lx} to {_rx} * {_o}
		add {_c}.getX() to {_lx}
		set {_lz} to {_rz} * {_o}
		add {_c}.getZ() to {_lz}
		set {_ly} to {_c}.getY()
		set {_lw} to {_c}.getWorld()
		set {_l} to new Location({_lw}, {_lx}, {_ly}, {_lz}, {_yaw}, 0)
		set {_m} to {_l}.getWorld().spawnEntity({_l}, EntityType.MANNEQUIN)
		mScDummySetup({_m}, loop-value)
		mScNameTag({_m}, loop-value)
		# 다음 게임이 시작될 때까지 남겨 둔다(mscene.sk 의 mSceneClear 가 지우지 않음)
		{_m}.addScoreboardTag("mafia_keep")
		{_m}.setRotation({_yaw}, 0)
	# 결과창: 줄 가운데 조금 위(머리 위 이름표보다 위)에 텍스트 디스플레이
	mStgBoard({_w}, {_win::*}, {_c})
	# 카메라: 줄 앞(결과창까지 들어오게 조금 멀리), 줄과 결과창 사이 높이를 본다
	set {_d} to 4.5 + {_n} * 0.25
	set {_cx} to {_fx} * {_d}
	add {_c}.getX() to {_cx}
	set {_cz} to {_fz} * {_d}
	add {_c}.getZ() to {_cz}
	set {_cy} to {_c}.getY()
	add 2.2 to {_cy}
	set {_cw} to {_c}.getWorld()
	set {_cam} to new Location({_cw}, {_cx}, {_cy}, {_cz})
	set {_nfx} to 0 - {_fx}
	set {_nfz} to 0 - {_fz}
	set {_vx} to {_nfx} * {_d}
	set {_vz} to {_nfz} * {_d}
	{_cam}.setDirection(new Vector({_vx}, 0.7, {_vz}))
	loop mStgViewers():
		mCamCut(loop-value, {_cam})

# ------------------------------------------------------------------ 시작 로딩, 직업 안내

function mStgClearChat(p: player):
	loop 100 times:
		send " " to {_p}
	send action bar "" to {_p}

# 로딩이 끝나면(mday.sk): 채팅창/액션바 비우기 → 직업 안내 → 마피아끼리 알림
function mStgReveal():
	loop all players:
		set {_p} to loop-player
		mStgClearChat({_p})
		if mIsPlayer({_p}) is true:
			mRoleReveal({_p})
		else:
			send "&7게임이 시작되었습니다. 관전 중입니다. &8(A/D: 시점 바꾸기)" to {_p}
	mMafiaReveal()

every second:
	if mState() is not "loading":
		stop
	loop all players:
		send action bar colored "&eloading..." to loop-player

# ------------------------------------------------------------------ 결과창

# 승리 팀 라인업 자리 조금 위에 뜨는 결과창(텍스트 디스플레이, 모두에게). 승리 팀 / 무승부 이유, 참가자마다 번호·이름·직업(바뀌었으면 처음 → 마지막)·생사.
function mStgBoard(w: text, win: texts, c: location):
	if {_w} is "draw":
		set {_why} to {-m::drawwhy}
		if {_why} is not set:
			set {_why} to ""
		set {_t} to "&7&l무승부|&7%{_why}%"
	else if {_w} is "mafia":
		set {_t} to "&c&l마피아 팀 승리"
	else if {_w} is "citizen":
		set {_t} to "&a&l시민 팀 승리"
	else:
		set {_nid} to {_w}
		replace all "neutral:" in {_nid} with ""
		set {_t} to "&b&l중립 %mRoleName({-m::role::%{_nid}%})% 승리"
	if {_w} is not "draw":
		if {-m::winwhy} is set:
			set {_t} to "%{_t}%|&8%{-m::winwhy}%"
	set {_t} to "%{_t}%| "
	loop {-m::players::*}:
		set {_id} to loop-value
		set {_o} to {-m::orig::%{_id}%}
		set {_r} to {-m::role::%{_id}%}
		set {_rc} to mTeamColor(mRolePool({_o}))
		set {_rs} to "%{_rc}%%mRoleName({_o})%"
		if {_r} is not {_o}:
			set {_rs} to "%{_rs}% &7→ %mTeamColor(mRolePool({_r}))%%mRoleName({_r})%"
		set {_nc} to "&f"
		if {_win::*} contains {_id}:
			set {_nc} to "&e"
		set {_st} to ""
		if {-m::alive::%{_id}%} is not true:
			set {_st} to " &8(사망)"
		set {_t} to "%{_t}%|&6%{-m::num::%{_id}%}% %{_nc}%%mNameOf({_id})% &7- %{_rs}%%{_st}%"
	replace all "|" in {_t} with nl
	replace all "&" in {_t} with "§"
	set {_y} to {_c}.getY()
	add 2.6 to {_y}
	set {_l} to new Location({_c}.getWorld(), {_c}.getX(), {_y}, {_c}.getZ())
	set {_e} to {_l}.getWorld().spawnEntity({_l}, EntityType.TEXT_DISPLAY)
	{_e}.setPersistent(false)
	{_e}.addScoreboardTag("mafia_keep")
	mScTrack({_e})
	{_e}.text(LegacyComponentSerializer.legacySection().deserialize({_t}))
	{_e}.setBillboard(StgBillboard.VERTICAL)
	{_e}.setLineWidth(400)
	{_e}.setBackgroundColor(Color.fromARGB(150, 0, 0, 0))

# ------------------------------------------------------------------ 승리 효과음

# 접속한 모두에게(연출 카메라가 없어도) 소리
function mStgSoundEvery(s: text, v: number, pi: number):
	loop all players:
		mSound(loop-player, {_s}, {_v}, {_pi})

# 음 높이: 소리 블록 n 칸(0 = F#3, 12 = F#4, 24 = F#5)
function mStgNote(n: number) :: number:
	set {_e} to {_n} - 12
	set {_e} to {_e} / 12
	return 2 ^ {_e}

# 화음 한 번(벨 + 플링, 아래는 베이스)
function mStgChord(a: number, b: number, c: number, v: number):
	mStgSoundEvery("block.note_block.bell", {_v}, mStgNote({_a}))
	mStgSoundEvery("block.note_block.pling", {_v}, mStgNote({_b}))
	mStgSoundEvery("block.note_block.pling", {_v}, mStgNote({_c}))

# 게임이 끝날 때 팡파르(배경음악 없이 효과음만). 승부가 났으면 도-미-솔-도 올라가는 팡파르 + 불꽃, 무승부면 낮은 종 두 번.
#   도4 = 6칸, 미4 = 10칸, 솔4 = 13칸, 도5 = 18칸, 미5 = 22칸
function mStgFanfare(w: text):
	if {_w} is "draw":
		mStgSoundEvery("block.bell.use", 0.8, 0.6)
		wait 20 ticks
		mStgSoundEvery("block.bell.use", 0.8, 0.5)
		mStgSoundEvery("block.bell.resonate", 0.5, 0.6)
		stop
	wait 10 ticks
	mStgSoundEvery("block.note_block.bass", 0.8, mStgNote(6))
	mStgSoundEvery("block.note_block.pling", 0.8, mStgNote(6))
	wait 3 ticks
	mStgSoundEvery("block.note_block.pling", 0.8, mStgNote(10))
	wait 3 ticks
	mStgSoundEvery("block.note_block.pling", 0.8, mStgNote(13))
	wait 3 ticks
	mStgChord(18, 13, 10, 0.9)
	mStgSoundEvery("block.note_block.bass", 0.8, mStgNote(6))
	wait 8 ticks
	mStgSoundEvery("block.note_block.pling", 0.8, mStgNote(13))
	wait 3 ticks
	mStgChord(22, 18, 13, 1)
	mStgSoundEvery("block.note_block.bass", 0.9, mStgNote(6))
	mStgSoundEvery("ui.toast.challenge_complete", 0.7, 1)
	# 불꽃(라인업 자리가 있으면 그 위에서)
	set {_c} to mLocLoad("lineup")
	loop 3 times:
		mStgSoundEvery("entity.firework_rocket.launch", 0.7, 1)
		wait 8 ticks
		mStgSoundEvery("entity.firework_rocket.large_blast", 0.7, 1)
		mStgSoundEvery("entity.firework_rocket.twinkle", 0.5, 1)
		if {_c} is set:
			set {_y} to {_c}.getY()
			add 5 to {_y}
			set {_rx} to random number between -2 and 2
			add {_c}.getX() to {_rx}
			set {_l} to new Location({_c}.getWorld(), {_rx}, {_y}, {_c}.getZ())
			loop all players:
				set {_pl} to loop-player
				{_pl}.spawnParticle(Particle.FIREWORK, {_l}, 60, 0.6, 0.6, 0.6, 0.15)
				{_pl}.spawnParticle(Particle.END_ROD, {_l}, 20, 0.8, 0.8, 0.8, 0.05)
		wait 6 ticks

# ------------------------------------------------------------------ 광대 승리 컷신

# 광대 컷신 길이(초). 연출이 없으면 1초 뒤 바로 종료
function mStgJesterLen() :: number:
	if mSceneOn() is not true:
		return 1
	return 8

function mStgBlindAll(t: number):
	loop mStgViewers():
		set {_p} to mPlayerOf(loop-value)
		if {_p} is set:
			{_p}.addPotionEffect(new PotionEffect(PotionEffectType.BLINDNESS, {_t}, 0, false, false))

# 투표로 당선된 광대: 화형 대신 "어라...?"(얼굴 클로즈업) → 암전(그동안 호박 머리로 변신) → 서커스 팡파르와 광대 승리 → 게임 종료 화면(mday.sk 처형 단계가 끝나면 mCheckEnd)
function mStgJester(x: text):
	if mSceneOn() is not true:
		stop
	set {-ms::stage} to true
	set {_xn} to mNameOf({_x})
	set {_m} to {-ms::dummy::%{_x}%}
	# 1) 어라...? (0~40틱): 얼굴 클로즈업, 갸웃하는 소리
	loop mStgViewers():
		mCamFace(loop-value, {_x})
		mStgTitle(loop-value, "&e어라...?", "", 45)
	mStgSoundAll("entity.villager.ambient", 1, 1.5)
	wait 6 ticks
	mStgSoundAll("block.note_block.bit", 0.8, mStgNote(14))
	wait 4 ticks
	mStgSoundAll("block.note_block.bit", 0.8, mStgNote(11))
	wait 4 ticks
	mStgSoundAll("block.note_block.bit", 0.8, mStgNote(7))
	wait 16 ticks
	mStgSoundAll("block.note_block.basedrum", 1, 0.8)
	wait 5 ticks
	mStgSoundAll("block.note_block.basedrum", 1, 0.8)
	wait 5 ticks
	if mSceneOn() is not true:
		stop
	# 2) 암전 (40~75틱): 화면이 꺼지고 그 사이 광대 더미가 호박 머리를 쓴다
	mStgBlindAll(38)
	mStgSoundAll("block.beacon.deactivate", 1, 0.8)
	if {_m} is set:
		{_m}.getEquipment().setHelmet(new ItemStack(Material.JACK_O_LANTERN))
	wait 15 ticks
	mStgSoundAll("block.note_block.snare", 0.8, 1)
	wait 4 ticks
	mStgSoundAll("block.note_block.snare", 0.8, 1)
	wait 4 ticks
	mStgSoundAll("block.note_block.snare", 0.8, 1.2)
	wait 12 ticks
	if mSceneOn() is not true:
		stop
	# 3) 팡파르와 광대 승리 (75틱~): 서커스풍 플링 → 화음 + 발전과제 소리, 토템·음표·불꽃 파티클, 흔들림, 더미가 팔을 흔든다
	loop mStgViewers():
		mStgTitle(loop-value, "&d&l광대 승리!", "&f%{_xn}%&7 님은 처형당하길 원했습니다", 70)
	mStgShakeAll(8, 0.08)
	mStgSoundAll("entity.firework_rocket.large_blast", 1, 1)
	mStgSeatPart({_x}, "TOTEM_OF_UNDYING", 80, 1.2)
	mStgSeatPart({_x}, "NOTE", 15, 2)
	loop 18, 20, 22, 18:
		mStgSoundAll("block.note_block.pling", 0.9, mStgNote(loop-value))
		mStgSoundAll("block.note_block.bit", 0.6, mStgNote(loop-value))
		if {_m} is set:
			{_m}.swingMainHand()
		wait 3 ticks
	mStgSoundAll("block.note_block.bell", 1, mStgNote(22))
	mStgSoundAll("block.note_block.pling", 1, mStgNote(18))
	mStgSoundAll("block.note_block.pling", 1, mStgNote(13))
	mStgSoundAll("block.note_block.bass", 0.9, mStgNote(6))
	mStgSoundAll("ui.toast.challenge_complete", 0.8, 1)
	loop 3 times:
		mStgSoundAll("entity.firework_rocket.launch", 0.7, 1.1)
		wait 6 ticks
		mStgSoundAll("entity.firework_rocket.twinkle", 0.7, 1)
		mStgSeatPart({_x}, "FIREWORK", 40, 2.5)
		mStgSeatPart({_x}, "NOTE", 6, 2)
		if {_m} is set:
			{_m}.swingOffHand()
		wait 4 ticks
		if {_m} is set:
			{_m}.swingMainHand()
		wait 4 ticks
	delete {-ms::stage}
