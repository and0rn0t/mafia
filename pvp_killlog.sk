# [killlog.sk] 킬로그: 플레이어가 죽으면 채팅에 [검] [공격자 얼굴] 공격자이름 [사망 원인 아이콘] [피격자 얼굴] 피격자이름 을 띄운다. 바닐라 사망 메시지는 지운다.
# 환경, 작업 규칙, 변수 목록, 스킬 추가 절차는 skill_core.sk 맨 위 주석을 먼저 읽을 것.
# 이 파일이 쓰는 변수: 없음(전부 지역 변수). 팀 판정은 skill_core.sk 의 isAlly() 가 {-team} 변수를 읽는다.
# 맨 앞 검 아이콘: 보는 사람 기준으로 공격자가 아군이면 다이아몬드 검, 적군이면 구리 검. 그래서 메시지를 접속자마다 따로 보낸다.
#   아군 = 보는 사람이 공격자 본인이거나 isAlly(보는 사람, 공격자) 가 true. 팀이 없으면(둘 중 하나라도 {-team} 없음) 모두 적군으로 본다.
# 공격자가 없으면(낙사, 용암, 스킬 데미지 등) 검/공격자 부분 없이 [사망 원인 아이콘] [피격자 얼굴] 피격자이름 만 모두에게 똑같이 띄운다.
# 아이콘은 마인크래프트 기본 텍스트 컴포넌트(리소스팩 없음, 1.21.9 이상)로 넣는다.
#   아이템: {"object":"atlas","atlas":"minecraft:items","sprite":"minecraft:item/이름"} (사용자가 /tellraw 로 확인함)
#   블럭(TNT 킬): {"object":"atlas","atlas":"minecraft:blocks","sprite":"minecraft:block/tnt_side"} (미검증. 안 나오면 /tellraw 로 먼저 시험)
#   얼굴:   {"object":"player","player":{"name":"플레이어이름"}} (미검증. 안 보이면 이 형태를 /tellraw 로 먼저 시험)
#   컴포넌트는 skript-reflect 로 Adventure 의 GsonComponentSerializer 에 JSON 을 넣어 만들고 sendMessage 로 보낸다(미검증).
# 사망 원인 아이콘은 아래 killCauseSprite 한 곳에서 정한다. 스프라이트 이름이 틀리거나 item/ 에 텍스처가 없으면 보라/검정 체크무늬가 뜬다.
# 킬로그는 killLogShow(피격자, 공격자, 원인, 피해종류) 함수 하나로 보낸다. 진짜 사망(on death)과 킬 연출(killcine.sk)이 같이 쓴다.
# 한계: TNT 처럼 공격자 정보 없이 주는 스킬 데미지는 공격자 없음 + 원인 barrier 로 나온다. 낚싯대 데미지는 플레이어 공격으로 잡혀 낚싯대 아이콘이 나온다.

import:
	org.bukkit.Bukkit
	net.kyori.adventure.text.serializer.gson.GsonComponentSerializer

# 아이템 스프라이트 하나를 가리키는 JSON 조각(문자열 안의 따옴표는 "" 로 쓴다)
function killIcon(s: text) :: text:
	# "block/" 로 시작하는 이름은 블럭 텍스처(blocks 아틀라스), 아니면 아이템 텍스처(items 아틀라스)
	if {_s} starts with "block/":
		return "{""object"":""atlas"",""atlas"":""minecraft:blocks"",""sprite"":""minecraft:%{_s}%""}"
	# "mck:" 로 시작하는 이름은 리소스팩의 전용 스프라이트(assets/mck/textures/item/이름.png, 예: mck:potion_heal)
	if {_s} starts with "mck:":
		set {_n} to {_s}
		replace "mck:" in {_n} with ""
		return "{""object"":""atlas"",""atlas"":""minecraft:items"",""sprite"":""mck:item/%{_n}%""}"
	return "{""object"":""atlas"",""atlas"":""minecraft:items"",""sprite"":""minecraft:item/%{_s}%""}"

# 플레이어 얼굴 하나를 가리키는 JSON 조각(미검증)
function killFace(n: text) :: text:
	return "{""object"":""player"",""player"":{""name"":""%{_n}%""}}"

# 사망 원인에 맞는 아이콘 스프라이트 이름을 돌려준다. a 는 공격자(없으면 피격자 본인을 넘긴다).
# c: 피해 원인 이름(EntityDamageEvent.DamageCause 의 name, 예 ENTITY_ATTACK), dt: 피해 종류 키(damage type, 예 player_explosion).
#   진짜 사망(on death)에서는 마지막 피해에서, 킬 연출(killcine.sk)에서는 취소한 치명타 피해 이벤트에서 읽어 넘긴다.
# 근접(ENTITY_ATTACK/ENTITY_SWEEP_ATTACK)은 공격자가 메인핸드에 든 아이템 이름을 그대로 쓰고(예: diamond_sword), 맨손이면 stick.
function killCauseSprite(v: player, a: entity, c: text, dt: text) :: text:
	if {_c} is "ENTITY_ATTACK":
		return killWeaponSprite({_a})
	if {_c} is "ENTITY_SWEEP_ATTACK":
		return killWeaponSprite({_a})
	if {_c} is "PROJECTILE":
		return "arrow"
	if {_c} is "FALL":
		return "feather"
	if {_c} is "FIRE":
		return "flint_and_steel"
	if {_c} is "FIRE_TICK":
		return "flint_and_steel"
	if {_c} is "LAVA":
		return "lava_bucket"
	if {_c} is "VOID":
		return "ender_pearl"
	# 폭발: 블레이즈 지팡이 화염구 킬이면 화염구(fire_charge), TNT 스킬 킬(피해 종류 player_explosion)이면 TNT 블럭 아이콘(tnt_side, 미검증), 그 외 gunpowder
	if {_c} is "ENTITY_EXPLOSION":
		if {-fbhit::%uuid of {_v}%} is set:
			return "fire_charge"
		if {_dt} is "player_explosion":
			return "block/tnt_side"
		return "gunpowder"
	if {_c} is "BLOCK_EXPLOSION":
		return "gunpowder"
	if {_c} is "DROWNING":
		return "water_bucket"
	if {_c} is "THORNS":
		return "cactus"
	return "barrier"

function killWeaponSprite(a: entity) :: text:
	if {_a} is not a living entity:
		return "stick"
	set {_eq} to {_a}.getEquipment()
	if {_eq} is not set:
		return "stick"
	set {_n} to {_eq}.getItemInMainHand().getType().name()
	if {_n} is "AIR":
		return "stick"
	# 금속 아이템은 재질이 네더라이트지만 겉모습이 철이라(items.sk 의 item_model) 킬로그 아이콘도 철 아이콘으로 바꾼다.
	# 문자열 가공 대신 이름을 하나씩 직접 비교해서 바꾼다.
	if {_n} is "NETHERITE_AXE":
		return "iron_axe"
	if {_n} is "NETHERITE_PICKAXE":
		return "iron_pickaxe"
	if {_n} is "NETHERITE_HOE":
		return "iron_hoe"
	if {_n} is "NETHERITE_SHOVEL":
		return "iron_shovel"
	if {_n} is "NETHERITE_SWORD":
		return "iron_sword"
	if {_n} is "NETHERITE_SPEAR":
		return "iron_spear"
	return {_n}.toLowerCase()

# 킬로그 한 줄을 접속자 모두에게 보낸다. v: 피격자, ae: 공격자(없으면 피격자 본인), c/dt: 피해 원인 이름/피해 종류 키.
function killLogShow(v: player, ae: entity, c: text, dt: text):
	set {_vn} to {_v}'s name
	set {_ci} to killIcon(killCauseSprite({_v}, {_ae}, {_c}, {_dt}))
	set {_vf} to killFace({_vn})
	set {_gap} to "{""text"":"" ""}"
	set {_vnj} to "{""text"":""%{_vn}%""}"
	set {_pvp} to false
	if {_ae} is a player:
		if {_ae} is not {_v}:
			set {_pvp} to true
	if {_pvp} is false:
		set {_json} to "{""text"":"""",""extra"":[%{_ci}%,%{_gap}%,%{_vf}%,%{_gap}%,%{_vnj}%]}"
		# broadcast 는 콘솔에도 찍히므로 접속자에게만 보낸다.
		set {_cc} to GsonComponentSerializer.gson().deserialize({_json})
		loop all players:
			loop-player.sendMessage({_cc})
		stop
	set {_an} to {_ae}'s name
	set {_af} to killFace({_an})
	set {_anj} to "{""text"":""%{_an}%""}"
	set {_mid} to "%{_af}%,%{_gap}%,%{_anj}%,%{_gap}%,%{_ci}%,%{_gap}%,%{_vf}%,%{_gap}%,%{_vnj}%"
	set {_swa} to killIcon("diamond_sword")
	set {_swe} to killIcon("copper_sword")
	set {_jsona} to "{""text"":"""",""extra"":[%{_swa}%,%{_gap}%,%{_mid}%]}"
	set {_jsone} to "{""text"":"""",""extra"":[%{_swe}%,%{_gap}%,%{_mid}%]}"
	set {_ca} to GsonComponentSerializer.gson().deserialize({_jsona})
	set {_ce} to GsonComponentSerializer.gson().deserialize({_jsone})
	set {_aid} to "%uuid of {_ae}%"
	loop all players:
		set {_vw} to loop-player
		set {_ally} to false
		if {_vw} is {_ae}:
			set {_ally} to true
		if isAlly("%uuid of {_vw}%", {_aid}) is true:
			set {_ally} to true
		if {_ally} is true:
			{_vw}.sendMessage({_ca})
		else:
			{_vw}.sendMessage({_ce})

# 진짜 사망(킬 연출을 못 거친 사망: /kill, 연출 중 사망 등)의 킬로그. 연출이 켜져 있으면 치명타를 취소하고 연출이 대신 killLogShow 를 부른다(killcine.sk).
on death of player:
	if pvpEnt(victim) is false:
		stop
	set the death message to ""
	set {_v} to victim
	set {_ae} to {_v}
	if attacker is set:
		set {_ae} to attacker
	set {_c} to "CUSTOM"
	set {_dt} to ""
	set {_ldc} to {_v}.getLastDamageCause()
	if {_ldc} is set:
		set {_c} to {_ldc}.getCause().name()
		set {_dt} to {_ldc}.getDamageSource().getDamageType().getKey().getKey()
	killLogShow({_v}, {_ae}, {_c}, {_dt})
