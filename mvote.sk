# ==============================================================================
# [mvote.sk] 투표, 처형, 테러리스트 길동무, 승리 판정. 규칙은 ROLES.md, 구조는 DESIGN.md. 단계 진행은 mday.sk 의 진행 루프가 부른다.
# 함수: mVoteStart() 투표 시작 / mVoteCast(투표자, 대상) 투표(한 번만, 바꿀 수 없음 - 확정) / mTally() 집계·처형 / mTakeStart(테러리스트) / mTakePick(테러리스트, 대상)
#       mWeight(id) 표 수(정치인 2) / mWinCheck() "" 진행, "draw", "mafia", "citizen", "neutral:uuid" / mEnd(승자) 종료 처리(mday.sk 의 mToLobby 로 복귀)
# 변수: {-m::vote::uuid}(투표 대상), {-m::votes::uuid}(받은 표), {-m::exe}(처형된 테러리스트 uuid, 길동무 선택 대기 중)
# 처형: 화형 컷신(mstage.sk 의 mStgBurn, 그동안 execute 단계). 테러리스트는 화형 뒤 길동무 선택(시간 mTimeTake, 관리자 메뉴), 길동무는 TNT 컷신.
# 명령: /mvote <닉네임>, /mtake <닉네임>(테러리스트 길동무). 화면 선택(좌/우클릭, F)은 mscene.sk 가 같은 함수를 부른다.
# 마담: 투표 시간에 마담에게 투표당한 사람은 직후 밤 능력 불가({-m::sealed}). 대상이 마피아 직업이면 봉인 대신 접선. 마담의 표도 일반 표로 센다.
# 미검증: 전체(서버 실행 불가).
# ==============================================================================

function mWeight(id: text) :: number:
	if {-m::role::%{_id}%} is "politician":
		return 2
	return 1

function mVoteStart():
	delete {-m::vote::*}
	delete {-m::votes::*}
	set {-m::state} to "vote"
	set {-m::left} to mTimeVote()
	mAuUpdate()
	mBc("&7투표 시간입니다. W 로 대상을 고르거나 /투표 <번호 또는 닉네임> 으로 투표하세요. (%{-m::left}%초)")
	mSceneVote()

function mVoteCast(v: text, t: text) :: text:
	if mState() is not "vote":
		return "투표 시간이 아닙니다."
	if {-m::alive::%{_v}%} is not true:
		return "사망한 플레이어는 투표할 수 없습니다."
	if {-m::away::%{_v}%} is true:
		return "자리비움 상태입니다."
	if {-m::novote::%{_v}%} is true:
		return "건달에게 협박당해 오늘은 투표할 수 없습니다."
	if {-m::vote::%{_v}%} is set:
		return "이미 투표했습니다. 투표한 뒤에는 대상을 바꿀 수 없습니다."
	if {-m::alive::%{_t}%} is not true:
		return "살아 있는 참가자에게만 투표할 수 있습니다."
	set {-m::vote::%{_v}%} to {_t}
	add mWeight({_v}) to {-m::votes::%{_t}%}
	set {_n} to mNameOf({_t})
	set {_c} to {-m::votes::%{_t}%}
	loop {-m::players::*}:
		set {_p} to mPlayerOf(loop-value)
		if {_p} is set:
			send "&f%{_n}%&7 님 &e%{_c}%표" to {_p}
	return ""

function mTally():
	# 마담 효과(투표 결과와 무관하게 마담의 표 대상에 적용)
	delete {-m::sealed::*}
	loop {-m::players::*}:
		if {-m::role::%loop-value%} is "madam":
			if {-m::alive::%loop-value%} is true:
				set {_t} to {-m::vote::%loop-value%}
				if {_t} is set:
					if {-m::role::%{_t}%} is "mafia":
						set {-m::contact::%loop-value%} to true
						set {-m::team::%loop-value%} to "mafia"
						mContactNotify(loop-value, true)
					else:
						set {-m::sealed::%{_t}%} to true
	# 종합 알림
	set {_max} to 0
	loop {-m::players::*}:
		set {_v} to {-m::votes::%loop-value%}
		if {_v} is set:
			if {_v} > 0:
				set {_nm} to mNameOf(loop-value)
				mBc("&f%{_nm}%&7 님 &e%{_v}%표")
			if {_v} > {_max}:
				set {_max} to {_v}
	if {_max} is 0:
		mBc("&7투표한 사람이 없어 처형은 없습니다.")
		stop
	loop {-m::players::*}:
		if {-m::votes::%loop-value%} is {_max}:
			add loop-value to {_top::*}
	if size of {_top::*} > 1:
		mBc("&7최다 득표자가 여럿이라 처형은 없습니다.")
		stop
	set {_x} to {_top::1}
	set {_xn} to mNameOf({_x})
	if {-m::role::%{_x}%} is "politician":
		# 정치인은 처형되지 않고 직업이 모두에게 공개된다(확정)
		set {-m::pubrole::%{_x}%} to "politician"
		mBc("&f%{_xn}%&7 님이 최다 득표했지만 &a정치인&7이라 처형되지 않았습니다.")
		mTabUpdateAll()
		stop
	# 광대: 화형 대신 "어라...?" → 암전 → 팡파르와 광대 승리(mstage.sk mStgJester), 그 뒤 게임 종료 화면
	if {-m::role::%{_x}%} is "jester":
		set {-m::jwin} to {_x}
		set {-m::state} to "execute"
		mAuUpdate()
		set {-m::left} to mStgJesterLen()
		mStgJester({_x})
		stop
	# 연출이 있으면 화형 컷신이 끝날 때 해골로 바꾼다(mstage.sk). 처형 단계(execute)에서 컷신 시간만큼 기다린다.
	mStgHold({_x})
	mDie({_x})
	mBc("&f%{_xn}%&7 님이 투표로 처형되었습니다.")
	set {-m::state} to "execute"
	mAuUpdate()
	set {-m::left} to mStgBurnLen()
	if {-m::role::%{_x}%} is "terrorist":
		set {-m::exe} to {_x}
		set {-m::left} to mStgBurnLen() + mTimeTake()
		set {_tp} to mPlayerOf({_x})
		if {_tp} is set:
			send "&c화형이 끝나면 길동무를 고르세요. A/D 로 고르고 스페이스로 확정(또는 /길동무 <번호 또는 닉네임>). %mTimeTake()%초가 지나면 무작위로 정해집니다." to {_tp}
	# 화형 컷신(연출이 없으면 바로 해골, 테러리스트면 컷신 뒤 길동무 선택 화면)
	mStgBurn({_x})

function mTakePick(t: text, v: text) :: text:
	if mState() is not "execute":
		return "지금은 선택할 수 없습니다."
	if {-m::exe} is not {_t}:
		return "테러리스트가 아닙니다."
	if {_v} is {_t}:
		return "자기 자신은 고를 수 없습니다."
	if {-m::alive::%{_v}%} is not true:
		return "살아 있는 참가자만 고를 수 있습니다."
	mStgHold({_v})
	mDie({_v})
	set {_n} to mNameOf({_v})
	mBc("&f%{_n}%&7 님이 테러리스트의 길동무가 되어 사망했습니다.")
	delete {-m::exe}
	# TNT 컷신(연출이 있으면 그동안 처형 단계를 유지한다)
	if mSceneOn() is true:
		set {-m::left} to mStgTntLen()
	else:
		set {-m::left} to 1
	mStgTnt({_t}, {_v})
	return ""

# 승패 판정: 기본 승리 조건(mWinBase)으로 승부가 안 났을 때만 끝나지 않는 판을 무승부로 본다(확정)
function mWinCheck() :: text:
	# 광대가 투표로 당선됐으면 광대 승리(다른 판정보다 먼저)
	if {-m::jwin} is set:
		set {-m::winwhy} to "광대가 투표로 처형됨"
		return "neutral:%{-m::jwin}%"
	set {_w} to mWinBase()
	if {_w} is not "":
		return {_w}
	# 둘만 남았는데 어느 쪽도 상대를 없앨 방법이 없음
	if mStalemate() is true:
		set {-m::drawwhy} to "남은 사람끼리는 승부가 날 수 없어 무승부입니다."
		return "draw"
	# 사망자 없이 정해진 날 수가 지남(자리비움 등으로 멈춘 판)
	if {-m::calm} is set:
		if {-m::calm} >= mCalmMax():
			set {-m::drawwhy} to "%mCalmMax()%일 동안 아무도 죽지 않아 무승부입니다."
			return "draw"
	return ""

# 기본 승리 조건(ROLES.md 표)
function mWinBase() :: text:
	set {_a} to 0
	set {_m} to 0
	set {_c} to 0
	set {_ch} to 0
	set {_nn} to 0
	set {_thug} to false
	set {_mk} to 0
	loop {-m::players::*}:
		if {-m::alive::%loop-value%} is true:
			# 광대는 투표로 처형당해야만 이기므로 다른 팀 승패 계산에는 넣지 않는다(살아 있어도 게임 종료를 막지 않음)
			if {-m::role::%loop-value%} is "jester":
				continue
			add 1 to {_a}
			set {_tm} to {-m::team::%loop-value%}
			if {_tm} is "mafia":
				add 1 to {_m}
				if {-m::role::%loop-value%} is "mafia":
					add 1 to {_mk}
			else if {_tm} is "citizen":
				add mWeight(loop-value) to {_c}
				add 1 to {_ch}
				if {-m::role::%loop-value%} is "thug":
					set {_thug} to true
			else if {_tm} is "neutral":
				add 1 to {_nn}
				set {_last} to loop-value
	# 마피아 직업이 모두 죽으면 남은 보조 직업(접선한 스파이·마담·마녀 등)만으로는 마피아 팀이 이길 수 없다(확정): 마피아 팀이 없는 것으로 본다
	set {_mdead} to false
	if {_mk} is 0:
		if {_m} > 0:
			set {_mdead} to true
		set {_m} to 0
	if {_a} is 0:
		set {-m::drawwhy} to "생존자가 없어 무승부입니다."
		loop {-m::players::*}:
			if {-m::alive::%loop-value%} is true:
				set {-m::drawwhy} to "승부를 낼 사람이 남지 않아 무승부입니다."
		return "draw"
	if {_nn} > 0:
		if {_m} is 0:
			if {_c} is 0:
				if {_nn} is 1:
					set {-m::winwhy} to "중립 혼자 생존"
					return "neutral:%{_last}%"
		return ""
	set {_mv} to {_m}
	# 보조 직업(접선 전/후)의 표는 마피아 팀 승리 계산에서 접선한 경우만 센다(team 변수가 mafia 면 이미 {_m} 에 들어 있음)
	if {_thug} is true:
		subtract 1 from {_mv}
	if {_m} > 0:
		# 마피아 팀 표가 시민 팀 표 이상이면(같아도) 시민 팀이 표로 이길 수 없으니 마피아 팀 승리(확정)
		if {_mv} >= {_c}:
			set {-m::winwhy} to "마피아 팀 표 %{_mv}% ≥ 시민 팀 표 %{_c}%"
			return "mafia"
		# 마지막 1:1(마피아 팀 1명, 시민 팀 1명)은 표로 정한다: 시민 쪽 표가 더 많으면(정치인 2표, 건달 협박) 시민 팀 승리(확정)
		if {_m} is 1:
			if {_ch} is 1:
				set {-m::winwhy} to "마지막 1:1, 시민 팀 표 %{_c}% > 마피아 팀 표 %{_mv}%"
				return "citizen"
		return ""
	set {-m::winwhy} to "마피아 팀이 모두 사망"
	if {_mdead} is true:
		set {-m::winwhy} to "마피아가 모두 사망(남은 보조 직업만으로는 이길 수 없음)"
	return "citizen"

# 사망자 없이 이만큼의 날(밤+낮)이 지나면 무승부. {mcfg::calm}, 기본 3
function mCalmMax() :: number:
	if {mcfg::calm} is set:
		return {mcfg::calm}
	return 3

# k 가 밤에 t 를 반드시 죽일 수 있는지(t 가 매일 막을 방법이 있으면 false)
function mCanKill(k: text, t: text) :: boolean:
	set {_r} to {-m::role::%{_k}%}
	set {_tr} to {-m::role::%{_t}%}
	# 방화(기름 → 점화)는 어떤 능력으로도 막히지 않는다
	if {_r} is "arsonist":
		return true
	set {_can} to false
	if {_r} is "mafia":
		if {_tr} is not "mafia":
			set {_can} to true
	else if {_r} is "assassin":
		set {_can} to true
	else if {_r} is "vigilante" or "thief":
		if {-m::used::%{_k}%} is not true:
			set {_can} to true
	if {_can} is false:
		return false
	# 의사는 매일 밤 자기 자신을 치료할 수 있어 살해로는 끝낼 수 없다(군인은 한 번만 버티므로 결국 죽는다)
	if {_tr} is "doctor":
		return false
	return true

# 둘만 남았고, 투표로도 밤 능력으로도 어느 쪽도 상대를 없앨 수 없으면 true(승패가 이미 났으면 이 함수까지 오지 않는다)
function mStalemate() :: boolean:
	loop {-m::players::*}:
		if {-m::alive::%loop-value%} is true:
			add loop-value to {_l::*}
	if size of {_l::*} is not 2:
		return false
	set {_x} to {_l::1}
	set {_y} to {_l::2}
	# 낮: 건달이 협박하면 상대가 투표를 못 해 처형이 된다 / 표 수가 다르면(정치인) 처형이 된다
	if {-m::role::%{_x}%} is "thug":
		return false
	if {-m::role::%{_y}%} is "thug":
		return false
	if mWeight({_x}) is not mWeight({_y}):
		return false
	# 밤: 한쪽이라도 상대를 반드시 죽일 수 있으면 끝날 수 있다
	if mCanKill({_x}, {_y}) is true:
		return false
	if mCanKill({_y}, {_x}) is true:
		return false
	return true

function mEnd(w: text):
	set {-m::state} to "end"
	mAuUpdate()
	set {-m::left} to 10
	if {_w} is "draw":
		set {_why} to {-m::drawwhy}
		if {_why} is not set:
			set {_why} to "무승부입니다."
		mBc("&7%{_why}%")
	else if {_w} is "mafia":
		mBc("&c마피아 팀&7이 승리했습니다.")
	else if {_w} is "citizen":
		mBc("&a시민 팀&7이 승리했습니다.")
	else:
		set {_id} to {_w}
		replace all "neutral:" in {_id} with ""
		set {_n} to mNameOf({_id})
		set {_rn} to mRoleName({-m::role::%{_id}%})
		mBc("&e중립 %{_rn}% &f%{_n}%&7 님이 승리했습니다.")
	# 승리 이유(표 계산 등)를 같이 알려 준다(기록과 콘솔에도 남는다)
	if {_w} is not "draw":
		if {-m::winwhy} is set:
			mBc("&8(승리 이유: %{-m::winwhy}%)")
	mBc("&7최초 직업 공개")
	loop {-m::players::*}:
		set {_n} to mNameOf(loop-value)
		set {_rn} to mRoleName({-m::orig::%loop-value%})
		mBc("&7- &f%{_n}% &7: &e%{_rn}%")

# 번호 또는 닉네임 → 참가자 uuid(없으면 "")
function mFindTarget(s: text) :: text:
	set {_no} to {_s} parsed as integer
	if {_no} is set:
		loop {-m::players::*}:
			if {-m::num::%loop-value%} is {_no}:
				return loop-value
		return ""
	loop {-m::players::*}:
		if mNameOf(loop-value) is {_s}:
			return loop-value
	set {_tp} to {_s} parsed as player
	if {_tp} is set:
		return "%uuid of {_tp}%"
	return ""

command /mvote <text>:
	aliases: /투표, /vote
	description: 투표 (마피아 게임) - 번호 또는 닉네임
	usage: &7사용법: /투표 <번호 또는 닉네임>
	executable by: players
	trigger:
		set {_t} to mFindTarget(arg-1)
		if {_t} is "":
			send "&c그런 참가자가 없습니다. 번호나 닉네임을 확인해 주세요."
			stop
		set {_why} to mVoteCast("%uuid of player%", {_t})
		if {_why} is not "":
			send "&c%{_why}%"

command /mtake <text>:
	aliases: /길동무, /take
	description: 테러리스트 길동무 선택 (마피아 게임) - 번호 또는 닉네임
	usage: &7사용법: /길동무 <번호 또는 닉네임>
	executable by: players
	trigger:
		set {_t} to mFindTarget(arg-1)
		if {_t} is "":
			send "&c그런 참가자가 없습니다. 번호나 닉네임을 확인해 주세요."
			stop
		set {_why} to mTakePick("%uuid of player%", {_t})
		if {_why} is not "":
			send "&c%{_why}%"
