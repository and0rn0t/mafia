# [mjoin.sk] 로비: 준비/관전 선택, 준비 완료 시 자동 시작, 시작(직업 배정, 이동, 직업 안내), 게임 중 퇴장/재접속(자리비움), 탭리스트 이름 색.
# 규칙은 ROLES.md, 구조는 DESIGN.md, 변수는 mcore.sk 맨 위 목록. PvP 서버(andornot)의 ready.sk 와 같은 방식이다.
# 동작:
#   - 로비 상태(mState 가 lobby)에서 핫바 8번째(인덱스 7)에 준비 블록(녹색=준비됨, 붉은색=준비되지 않음), 7번째(인덱스 6)에 관전 선택 블록(흰색=게임 참여, 회색=게임 관전). 우클릭하면 토글, 버리기/옮기기는 막는다.
#   - 준비 상태는 탭리스트 이름 색: 준비됨 녹색, 준비 안 됨 붉은색, 게임 관전 회색. 게임 중에는 생존 흰색, 사망/관전 짙은 회색, 자리비움 회색.
#   - 접속 중인 참가자(관전 제외)가 모두 준비됨이면 5초 카운트다운 후 시작. 인원(6~12), 켜진 직업 수, 게임 월드 위치 검사에 걸리면 이유를 액션바로 알리고 시작하지 않는다.
#   - 시작하면 직업 배정, 준비 블록 제거, 참가자를 게임 월드 위치로 이동, 각자 직업 안내(제목 + 채팅). 관전자는 스펙테이터 모드로 같은 곳에 둔다.
#   - 게임 중 접속을 끊은 참가자는 자리비움(생존 유지). 재접속하면 같은 자리로 계속한다. 참가자가 아니었던 사람이 게임 중에 들어오면 관전자(스펙테이터)가 된다(중간 참가 불가).
#   - 관리자: /mstart (준비와 상관없이 지금 시작, 검사는 같이 한다), /mstop (게임 강제 종료 후 로비로).
# 광인의 가짜 직업: 켜진 시민 팀 직업 중 무작위(경찰, 의사 포함, 광인 제외). 시작할 때 마피아끼리는 서로를 알고(이름 목록 안내), 보조 직업은 접선 전이라 모른다.
# 미검증: 전체(서버 실행 불가). 특히 우클릭/인벤토리 클릭 취소, 탭 이름 색(playerListName), 스펙테이터/어드벤처 전환, 월드 이동.

import:
	org.bukkit.Bukkit
	net.kyori.adventure.text.serializer.gson.GsonComponentSerializer
	java.util.UUID

function mReadyOn(p: player) :: boolean:
	if {-m::ready::%uuid of {_p}%} is true:
		return true
	return false

function mSpecOn(p: player) :: boolean:
	if {-m::spec::%uuid of {_p}%} is true:
		return true
	return false

# 로비에서 준비/관전 블록이 나오는 때
function mLobbyActive() :: boolean:
	if mState() is "lobby":
		return true
	return false

function mReadyName(on: boolean) :: text:
	if {_on} is true:
		return "&a준비됨"
	return "&c준비되지 않음"

function mReadyItem(on: boolean) :: itemtype:
	if {_on} is true:
		set {_i} to lime concrete named mReadyName(true)
		set lore of {_i} to "&7준비를 해제합니다.", "&7모두 준비되면 5초 뒤 게임이 시작됩니다."
		return {_i}
	set {_i} to red concrete named mReadyName(false)
	set lore of {_i} to "&7준비합니다.", "&7모두 준비되면 5초 뒤 게임이 시작됩니다."
	return {_i}

function mSpecName(on: boolean) :: text:
	if {_on} is true:
		return "&7게임 관전"
	return "&f게임 참여"

function mSpecItem(on: boolean) :: itemtype:
	if {_on} is true:
		set {_i} to gray concrete named mSpecName(true)
		set lore of {_i} to "&7게임 관전 중입니다.", "&7우클릭하면 게임에 참여합니다."
		return {_i}
	set {_i} to white concrete named mSpecName(false)
	set lore of {_i} to "&7게임에 참여합니다.", "&7우클릭하면 게임 관전으로 바꿉니다."
	return {_i}

# 이 이름이 로비 블록(준비/관전)의 이름인지
function mLobbyItemName(n: text) :: boolean:
	if {_n} is mReadyName(true):
		return true
	if {_n} is mReadyName(false):
		return true
	if {_n} is mSpecName(true):
		return true
	if {_n} is mSpecName(false):
		return true
	return false

# 8번 칸(인덱스 7)과 7번 칸(인덱스 6)에 지금 상태의 블록을 고정하고, 왼손에 들어간 블록은 치운다.
function mLobbyEnsure(p: player):
	set {_want} to mReadyName(mReadyOn({_p}))
	set {_n} to name of slot 7 of {_p}'s inventory
	set {_ok} to false
	if {_n} is set:
		if {_n} is {_want}:
			set {_ok} to true
	if {_ok} is false:
		set slot 7 of {_p}'s inventory to mReadyItem(mReadyOn({_p}))
	set {_want} to mSpecName(mSpecOn({_p}))
	set {_n} to name of slot 6 of {_p}'s inventory
	set {_ok} to false
	if {_n} is set:
		if {_n} is {_want}:
			set {_ok} to true
	if {_ok} is false:
		set slot 6 of {_p}'s inventory to mSpecItem(mSpecOn({_p}))
	set {_o} to name of slot 40 of {_p}'s inventory
	if {_o} is set:
		if mLobbyItemName({_o}) is true:
			clear slot 40 of {_p}'s inventory
	# 안내서 책(핫바 9번 칸, mhelp.sk)
	mGuideGive({_p})

# 로비 블록을 치운다(게임이 시작될 때)
function mLobbyClear(p: player):
	loop 3 times:
		set {_s} to 7
		if loop-value is 2:
			set {_s} to 6
		if loop-value is 3:
			set {_s} to 40
		set {_n} to name of slot {_s} of {_p}'s inventory
		if {_n} is set:
			if mLobbyItemName({_n}) is true:
				clear slot {_s} of {_p}'s inventory

# 탭리스트 이름 색. 로비: 관전 회색 / 준비됨 녹색 / 준비 안 됨 붉은색. 게임 중: 자리비움 회색 / 생존 흰색 / 사망 또는 관전 짙은 회색.
function mTabColor(p: player) :: text:
	set {_id} to "%uuid of {_p}%"
	if mState() is "lobby":
		if mSpecOn({_p}) is true:
			return "#aaaaaa"
		if mReadyOn({_p}) is true:
			return "#55ff55"
		return "#ff5555"
	if {-m::away::%{_id}%} is true:
		return "#aaaaaa"
	if {-m::alive::%{_id}%} is true:
		return "#ffffff"
	return "#555555"

# 탭 이름과 채팅 이름: 게임 중 참가자는 앞에 번호를 붙인다(예: "3 닉네임"). 로비에서는 번호 없음.
function mTabUpdate(p: player):
	set {_nm} to name of {_p}
	set {_c} to mTabColor({_p})
	set {_no} to mNum("%uuid of {_p}%")
	if {_no} is "":
		set {_json} to "{""text"":""%{_nm}%"",""color"":""%{_c}%""}"
		{_p}.playerListName(GsonComponentSerializer.gson().deserialize({_json}))
		{_p}.displayName(null)
		stop
	set {_json} to "[{""text"":""%{_no}% "",""color"":""#ffaa00""},{""text"":""%{_nm}%"",""color"":""%{_c}%""}]"
	{_p}.playerListName(GsonComponentSerializer.gson().deserialize({_json}))
	set {_dj} to "[{""text"":""%{_no}% "",""color"":""#ffaa00""},{""text"":""%{_nm}%""}]"
	{_p}.displayName(GsonComponentSerializer.gson().deserialize({_dj}))

# 번호 + 닉네임(대상 고르기 화면 등). 번호가 없으면 닉네임만
function mNumName(id: text) :: text:
	set {_no} to mNum({_id})
	if {_no} is "":
		return "&f%mNameOf({_id})%"
	return "&6%{_no}% &f%mNameOf({_id})%"

# 게임 중 플레이어 번호(참가자가 아니거나 로비면 "")
function mNum(id: text) :: text:
	if mState() is "lobby":
		return ""
	if {-m::num::%{_id}%} is not set:
		return ""
	return "%{-m::num::%{_id}%}%"

function mTabUpdateAll():
	loop all players:
		mTabUpdate(loop-player)

# 이 uuid 문자열의 온라인 플레이어(없으면 값 없음)
function mPlayerOf(id: text) :: player:
	return Bukkit.getPlayer(UUID.fromString({_id}))

# 참가자 uuid 목록에 들어 있는지
function mIsPlayer(p: player) :: boolean:
	if {-m::players::*} contains "%uuid of {_p}%":
		return true
	return false

# 로비에서 참가할 사람(접속 중이고 관전을 고르지 않은 사람)의 uuid 목록
function mLobbyPlayers() :: texts:
	loop all players:
		if mSpecOn(loop-player) is not true:
			add "%uuid of loop-player%" to {_l::*}
	return {_l::*}

function mLobbyBar(p: player) :: text:
	if mSpecOn({_p}) is true:
		return "&7게임 관전"
	if mReadyOn({_p}) is true:
		return "&f게임 참여 &8| &a준비됨"
	return "&f게임 참여 &8| &c준비되지 않음"

# 광인에게 보여 줄 가짜 직업(켜진 시민 팀 직업 중 무작위, 경찰/의사 포함, 광인 제외).
function mFakeRole() :: text:
	loop mCandidates("citizen"):
		if loop-value is not "madman":
			add loop-value to {_c::*}
	return random element of {_c::*}

# 시작할 때 각자에게 직업 안내(제목 + 채팅)
function mRoleReveal(p: player):
	set {_id} to "%uuid of {_p}%"
	set {_r} to {-m::role::%{_id}%}
	if {_r} is not set:
		stop
	set {_shown} to {_r}
	if {_r} is "madman":
		set {_shown} to mFakeRole()
		set {-m::fake::%{_id}%} to {_shown}
	set {_nm} to mRoleName({_shown})
	set {_ds} to mRoleDesc({_shown})
	set {_pool} to mRolePool({_shown})
	set {_c} to mTeamColor({_pool})
	send title "&e당신의 직업" with subtitle "%{_c}%%{_nm}%" to {_p} for 4 seconds with fadein 5 ticks and fade out 10 ticks
	send "&7당신의 직업은 %{_c}%%{_nm}%&7입니다." to {_p}
	mLogP({_id}, "&7당신의 직업은 %{_c}%%{_nm}%&7입니다.")
	loop mRoleDescLines({_shown}):
		send "&7 %loop-value%" to {_p}
	if {_pool} is "support":
		send "&7마피아와 접선하기 전에는 어느 팀도 아니지만, 승패는 마피아 팀을 따릅니다." to {_p}
	else if {_pool} is "mafia":
		send "&c마피아 팀입니다." to {_p}
	else if {_pool} is "citizen":
		send "&a시민 팀입니다." to {_p}
	else:
		send "&e중립입니다. 혼자 남으면 승리합니다." to {_p}

# 팀 색: 마피아 팀(마피아, 보조) 붉은색, 시민 팀 초록색, 중립 하늘색(확정)
function mTeamColor(pool: text) :: text:
	if {_pool} is "mafia" or "support":
		return "&c"
	if {_pool} is "citizen":
		return "&a"
	return "&b"

# 시작할 때 마피아(직업)끼리 서로를 알려 준다. 보조 직업은 접선 전이라 모르고, 다른 마피아가 없으면 아무것도 보내지 않는다.
function mMafiaReveal():
	loop {-m::players::*}:
		if {-m::role::%loop-value%} is "mafia":
			add loop-value to {_m::*}
	if size of {_m::*} < 2:
		stop
	loop {_m::*}:
		set {_a} to mPlayerOf(loop-value)
		if {_a} is set:
			set {_names::*} to ""
			delete {_names::*}
			loop {_m::*}:
				if loop-value-2 is not loop-value-1:
					add mNameOf(loop-value-2) to {_names::*}
			send "&c함께하는 마피아: &f%{_names::*}%" to {_a}

# 게임을 시작한다. 성공하면 true, 검사에 걸리면 이유를 보내고 false. by 는 결과를 받을 사람(없으면 전체 알림 없음).
function mStart(by: object) :: boolean:
	if mState() is not "lobby":
		return false
	set {-m::players::*} to mLobbyPlayers()
	add mTestBots() to {-m::players::*}
	set {_n} to size of {-m::players::*}
	set {_why} to mStartCheck({_n})
	if {_why} is "":
		set {_why} to mWorldCheck()
	if {_why} is not "":
		delete {-m::players::*}
		if {_by} is a player:
			send "&c%{_why}%" to {_by}
		return false
	if mAssign() is not true:
		delete {-m::players::*}
		return false
	set {_no} to 0
	loop {-m::players::*}:
		set {-m::alive::%loop-value%} to true
		# 플레이어 번호(1부터, 탭 목록과 채팅에 표시)
		add 1 to {_no}
		set {-m::num::%loop-value%} to {_no}
		# 표시 이름을 시작할 때 저장(나간 사람도 닉네임 그대로)
		set {_np} to mPlayerOf(loop-value)
		if {_np} is set:
			set {-m::nm::%loop-value%} to name of {_np}
	delete {-m::ready::*}
	delete {-m::cd}
	set {_gl} to mGameLoc()
	loop all players:
		set {_p} to loop-player
		mLobbyClear({_p})
		if mIsPlayer({_p}) is true:
			if {_p} is not op:
				set {_p}'s gamemode to adventure
			mTp({_p}, {_gl})
		else:
			set {_p}'s gamemode to spectator
			mTp({_p}, {_gl})
			send "&7게임이 시작되었습니다. 관전 중입니다." to {_p}
	# 직업 안내(mRoleReveal, mMafiaReveal)는 5초 로딩 뒤 mstage.sk 의 mStgReveal 이 한다
	mSceneStart()
	mBegin()
	mTabUpdateAll()
	return true

# 접속: 로비면 로비로 이동하고 블록을 받는다. 게임 중이면 참가자는 같은 자리로 복귀, 아니면 관전자.
on join:
	set {_p} to player
	set {_id} to "%uuid of {_p}%"
	if mState() is "lobby":
		delete {-m::ready::%{_id}%}
		# 게임 도중 서버가 꺼졌다 켜진 경우: 관전 모드·밤하늘이 남아 있으면 되돌린다
		{_p}.resetPlayerTime()
		{_p}.resetPlayerWeather()
		if gamemode of {_p} is spectator:
			{_p}.setSpectatorTarget(null)
			if {_p} is op:
				set {_p}'s gamemode to creative
		if {_p} is not op:
			clear {_p}'s inventory
			set {_p}'s gamemode to adventure
		mTp({_p}, mLobbyLoc())
		mLobbyEnsure({_p})
		mLobbyTick(false)
	else:
		if mIsPlayer({_p}) is true:
			delete {-m::away::%{_id}%}
			send "&7게임에 다시 참여했습니다." to {_p}
			mSceneRejoin({_p})
		else:
			set {_p}'s gamemode to spectator
			send "&7게임이 진행 중이라 관전자로 들어왔습니다." to {_p}
			mSceneSpecJoin({_p})
	mTabUpdateAll()

# 퇴장: 로비면 준비 상태를 지운다. 게임 중 참가자는 자리비움.
on quit:
	set {_id} to "%uuid of player%"
	if mState() is "lobby":
		delete {-m::ready::%{_id}%}
		delete {-m::spec::%{_id}%}
	else:
		if mIsPlayer(player) is true:
			set {-m::away::%{_id}%} to true
		else:
			remove {_id} from {-ms::spec::*}
			delete {-ms::watch::%{_id}%}
	delete {-m::cd}

# 준비/관전 블록 우클릭
on right click:
	if mLobbyActive() is not true:
		stop
	set {_h} to event.getHand()
	if {_h} is not set:
		stop
	if {_h}.name() is not "HAND":
		stop
	set {_tn} to name of player's tool
	if {_tn} is not set:
		stop
	if mLobbyItemName({_tn}) is not true:
		stop
	cancel the event
	if {_tn} is mReadyName(true):
		delete {-m::ready::%uuid of player%}
		mSound(player, "block.note_block.bass", 0.6, 1)
	else if {_tn} is mReadyName(false):
		if mSpecOn(player) is true:
			send "&c게임 관전 중에는 준비할 수 없습니다." to player
			stop
		set {-m::ready::%uuid of player%} to true
		mSound(player, "block.note_block.chime", 0.6, 1.4)
	else if {_tn} is mSpecName(false):
		set {-m::spec::%uuid of player%} to true
		delete {-m::ready::%uuid of player%}
		mSound(player, "block.note_block.bass", 0.6, 1)
	else:
		delete {-m::spec::%uuid of player%}
		mSound(player, "block.note_block.chime", 0.6, 1.4)
	delete {-m::cd}
	mLobbyEnsure(player)
	mTabUpdate(player)
	# 액션바(인원, 준비 상태, 카운트다운)를 다음 초를 기다리지 않고 바로 바꾼다
	mLobbyTick(false)

# 준비/관전 블록은 버리거나 인벤토리에서 옮길 수 없다
on drop:
	set {_dn} to name of event-item
	if {_dn} is not set:
		stop
	if mLobbyItemName({_dn}) is true:
		cancel the event

on inventory click:
	if mLobbyActive() is not true:
		stop
	set {_cn} to name of event-item
	if {_cn} is set:
		if mLobbyItemName({_cn}) is true:
			cancel the event
			stop
	set {_ci} to player.getItemOnCursor()
	set {_cu} to name of {_ci}
	if {_cu} is set:
		if mLobbyItemName({_cu}) is true:
			cancel the event

# 1초마다: 로비에서 블록 고정, 액션바, 전원 준비 시 자동 시작 카운트다운
every second:
	mLobbyTick(true)

# 로비 상태를 모두의 액션바에 보여 준다. step 이 true 면 1초가 지난 것(카운트다운을 줄이고 0이면 시작), false 면 보여 주기만(준비/관전을 바꾼 순간 등)
function mLobbyTick(step: boolean):
	if mLobbyActive() is not true:
		delete {-m::cd}
		stop
	set {_n} to 0
	set {_all} to true
	loop all players:
		mLobbyEnsure(loop-player)
		if mSpecOn(loop-player) is not true:
			add 1 to {_n}
			if mReadyOn(loop-player) is not true:
				set {_all} to false
	if {_n} < mMinPlayers():
		delete {-m::cd}
		set {_need} to mMinPlayers()
		loop all players:
			send action bar colored "&7인원 대기 중 %{_n}%/%{_need}% &8| %mLobbyBar(loop-player)%" to loop-player
		stop
	if {_all} is not true:
		delete {-m::cd}
		loop all players:
			send action bar colored mLobbyBar(loop-player) to loop-player
		stop
	set {_why} to mStartCheck({_n})
	if {_why} is "":
		set {_why} to mWorldCheck()
	if {_why} is not "":
		delete {-m::cd}
		loop all players:
			send action bar colored "&c%{_why}%" to loop-player
		stop
	if {-m::cd} is not set:
		set {-m::cd} to 5
	else if {_step} is true:
		subtract 1 from {-m::cd}
	if {-m::cd} <= 0:
		delete {-m::cd}
		mStart({_none})
		stop
	set {_c} to {-m::cd}
	loop all players:
		send action bar colored "&b게임 시작까지 %{_c}%초 &8| %mLobbyBar(loop-player)%" to loop-player
		if {_step} is true:
			mSound(loop-player, "block.comparator.click", 1, 1.5)

command /mstart:
	permission: minecraft.command.op
	permission message: &c권한이 없습니다.
	description: 마피아 게임을 지금 시작 (관리자 전용)
	trigger:
		if sender is a player:
			if player is not op:
				send "&c관리자만 사용할 수 있습니다."
				stop
			if mState() is not "lobby":
				send "&c게임이 이미 진행 중입니다."
				stop
			mStart(player)
			stop
		send "&c게임 안에서 사용해 주세요."

command /mstop:
	permission: minecraft.command.op
	permission message: &c권한이 없습니다.
	description: 마피아 게임을 강제 종료하고 로비로 (관리자 전용)
	trigger:
		if sender is a player:
			if player is not op:
				send "&c관리자만 사용할 수 있습니다."
				stop
		mToLobby()
		mBc("&7게임이 종료되어 로비로 돌아왔습니다.")
