# ==============================================================================
# [mtest.sk] 혼자 시험하기: 가짜 참가자(봇)를 넣어 게임을 진행한다. 관리자 전용. 실제 게임에는 영향 없음(봇을 넣지 않으면 아무 일도 안 함). 운영 서버에서는 이 파일을 빼도 된다.
# 명령(관리자 전용):
#   /mtest start [봇 수]       로비에서 봇(기본 7명)을 넣고 바로 시작한다. 접속 중인 사람(관전 선택 제외) + 봇이 참가자
#   /mtest role <직업id> [이름]  내(또는 그 참가자의) 직업을 게임 중에 바꾼다(시험용, 직업 중복 검사 없음). 이름은 봇 이름 또는 닉네임
#   /mtest info                모든 참가자의 직업/팀/생존/이번 밤 선택/투표와 남은 시간
#   /mtest skip                지금 단계를 바로 끝낸다(남은 시간 1초)
#   /mtest kill <이름>          그 참가자를 바로 사망 처리한다(승패 판정은 다음 단계 끝에서)
#   /mtest auto                내 입력도 봇처럼 자동으로 할지 켜고 끈다
#   /mtest ai <이름>            그 봇이 아는 것과 의심 점수를 본다
#   /mtest llm url|key|model|on|off|test|status   봇 말하기 AI(OpenAI 호환 API) 설정. 아래 "봇 말하기: AI(LLM) 연결"
#   /mtest stop                게임을 끝내고 로비로(= /mstop)
# 봇 동작(규칙 기반 AI, 아래 "봇 AI"): 밤·투표 시간 중 무작위 시점에 직업과 아는 것·의심 점수로 판단해 능력을 쓰고 투표한다.
#   낮에는 말도 한다(아침마다 번호 순서로 직업과 지난밤 행적 보고: 시민은 사실, 마피아 팀·중립은 가짜 직업으로 거짓. 보고끼리 모순을 찾아 짚는다. 경찰 결과 밝히기, 의심 가는 사람 말하기, 고발당하면 해명, 마피아는 거짓 고발·거짓 경찰 주장). 사람 채팅의 고발/변호도 듣는다.
#   테러리스트 봇은 화형 컷신 뒤 가장 의심 가는 사람을 길동무로 고른다.
#   추리: 투표가 끝나면 확인된 시민을 찍은 사람(+20), 아는 마피아 대신 다른 사람을 찍은 사람(+8), 나를 찍은 사람(+15)을 의심하고,
#   밤에 죽은 사람을 어제 찍은 사람(+12)도 의심한다. 한 명뿐인 직업을 두 사람이 주장하면 충돌로 보고(진짜는 상대를 강하게 의심, 구경꾼은 둘 다 의심) 짚어서 말한다.
#   말: 종류마다 여러 문장(mBotLine), 하루 세 마디까지, 말하는 때는 무작위(두세 번), 맞장구·충돌 지적·투표 알림은 몇 초 뒤에 예약해서 말한다.
# 봇의 밤 결과(조사 결과 등)는 다른 사람에게 보여 주지 않는다(실제 게임처럼 조사한 본인에게만 간다. 봇은 받을 사람이 없어서 아무에게도 안 보임).
# 변수: {-mt::bots::*}(봇 uuid 목록), {-mt::name::uuid}(봇 이름), {-mt::when::uuid}(이번 단계에 행동할 남은 초), {-mt::phase}(단계 바뀜 감지),
#       {-mt::auto::uuid}(관리자 자동 입력). mReset 이 {-mt::*} 를 지운다.
# 미검증: 전체(서버 실행 불가).
# ==============================================================================

import:
	java.util.UUID
	org.bukkit.Bukkit
	java.util.ArrayList
	java.util.EnumSet
	com.comphenix.protocol.ProtocolLibrary
	com.comphenix.protocol.PacketType$Play$Server as MtPT
	com.comphenix.protocol.wrappers.PlayerInfoData
	com.comphenix.protocol.wrappers.WrappedGameProfile
	com.comphenix.protocol.wrappers.WrappedChatComponent
	com.comphenix.protocol.wrappers.EnumWrappers$PlayerInfoAction as MtPIA
	com.comphenix.protocol.wrappers.EnumWrappers$NativeGameMode as MtGM
	java.net.URI
	java.time.Duration
	java.net.http.HttpClient
	java.net.http.HttpClient$Version as HttpVer
	java.net.http.HttpRequest
	java.net.http.HttpRequest$BodyPublishers as HBodyPub
	java.net.http.HttpResponse$BodyHandlers as HBodyHand
	com.google.gson.JsonObject
	com.google.gson.JsonArray
	com.google.gson.JsonParser

# mTestBots, mTestName, mIsBot(게임 코드가 부르는 것)은 mcore.sk 에 있다(이 파일을 빼도 게임이 돌게).

# 이름(봇 이름 또는 닉네임)으로 참가자 uuid 찾기. 없으면 ""
function mTestFind(n: text) :: text:
	loop {-m::players::*}:
		if mNameOf(loop-value) is {_n}:
			return loop-value
	return ""

# 자동으로 행동할 참가자: 봇 + 자동 입력을 켠 관리자
function mTestAutoOn(id: text) :: boolean:
	if mIsBot({_id}) is true:
		return true
	if {-mt::auto::%{_id}%} is true:
		return true
	return false

# ------------------------------------------------------------------ 봇 AI(규칙 기반)
# 봇마다 아는 것과 의심 점수를 들고 판단한다.
#   아는 것 {-mt::k::봇::대상} = "mafia"(마피아 팀) / "town"(마피아 아님) / "evil"(중립 살인 직업 등). 출처: 자기 조사 결과, 기자 특종, 같은 마피아 팀.
#   의심 {-mt::sus::봇::대상} 숫자(높을수록 의심). 시작할 때 0~15 무작위. 주장(채팅)·투표·조사로 바뀐다.
#   공개 주장 {-mt::claim::사람} = 주장한 직업("police" 등). 의사·수호자가 지킬 사람을 고를 때 쓴다.
#   채팅 {-mt::said::봇} = 이번 낮에 한 말 수(낮마다 2마디까지)
# 밤: 직업별로 고른다(마피아끼리는 같은 대상). 투표: 아는 마피아 → 가장 의심 + 지금 표가 몰린 사람(따라가기). 마피아 팀은 팀원을 피하고 위협(주장한 사람, 팀원을 고발한 사람)을 노린다.
# 낮 채팅: 경찰 봇은 조사 결과를 밝히고, 의심 가는 사람을 말하고, 고발당하면 해명한다. 마피아 봇은 가끔 거짓 고발이나 거짓 경찰 주장을 한다.
# 사람 채팅도 듣는다: 말에 참가자 번호나 닉네임과 "마피아"가 있으면 고발, "시민"/"아니" 가 있으면 변호로 받아들인다.

# 봇 b 가 t 를 어떻게 아는지("" = 모름)
function mBotK(b: text, t: text) :: text:
	if {-mt::k::%{_b}%::%{_t}%} is set:
		return {-mt::k::%{_b}%::%{_t}%}
	return ""

function mBotSus(b: text, t: text) :: number:
	if {-mt::sus::%{_b}%::%{_t}%} is set:
		return {-mt::sus::%{_b}%::%{_t}%}
	return 0

function mBotAddSus(b: text, t: text, d: number):
	set {-mt::sus::%{_b}%::%{_t}%} to mBotSus({_b}, {_t}) + {_d}

# 봇 b 가 t 를 의심하는 사실 근거(AI 에게 주는 글, 색 없음). 없으면 ""
function mBotWhy(b: text, t: text) :: text:
	set {_w} to ""
	set {_tn} to "%mNum({_t})%번"
	if mBotK({_b}, {_t}) is "mafia":
		if mBotEvilSide({_b}) is false:
			set {_w} to "네 조사로 %{_tn}% 이(가) 마피아인 걸 안다. "
	if {-mt::cxw::%{_t}%} is set:
		set {_w} to "%{_w}%%mBotPlain({-mt::cxw::%{_t}%})%. "
	set {_tc} to ""
	if {-mt::claim::%{_t}%} is set:
		set {_tc} to {-mt::claim::%{_t}%}
	loop {-m::players::*}:
		set {_p} to loop-value
		if {_p} is not {_t}:
			if {-mt::claim::%{_p}%} is "police":
				loop {-mt::rep::%{_p}%::*}:
					set {_f::*} to split loop-value-2 at "|"
					if {_f::1} is "police":
						if {_f::2} is {_t}:
							if {_f::3} is "mafia":
								set {_w} to "%{_w}%%mNum({_p})%번(경찰 주장)이 %{_tn}% 을(를) 마피아라고 했다. "
			if {_tc} is not "":
				if {-m::alive::%{_p}%} is true:
					if {-mt::claim::%{_p}%} is {_tc}:
						if mBotUniqueRole({_tc}) is true:
							set {_w} to "%{_w}%%{_tn}% 와(과) %mNum({_p})%번이 둘 다 %mRoleName({_tc})% 이라고 주장했다. "
	replace all "|" in {_w} with "/"
	return {_w}

# 봇이 마피아 팀(마피아 직업이거나 접선한 보조)인지
function mBotEvilSide(b: text) :: boolean:
	if {-m::team::%{_b}%} is "mafia":
		return true
	return false

# 직업 id → 봇이 아는 값
function mBotKOfRole(r: text) :: text:
	set {_po} to mRolePool({_r})
	if {_po} is "mafia":
		return "mafia"
	if {_po} is "neutral":
		if {_r} is "jester":
			return "town"
		return "evil"
	if {_po} is "support":
		return "evil"
	return "town"

# 게임 시작 때 한 번: 의심 초기값, 마피아 팀은 서로 안다
function mBotInit():
	delete {-mt::dec::*}
	delete {-mt::sum::*}
	delete {-mtllm::sf}
	delete {-mtllm::sd}
	delete {-mt::chat::*}
	delete {-mt::pmem::*}
	delete {-mt::k::*}
	delete {-mt::sus::*}
	delete {-mt::claim::*}
	delete {-mt::lastvote::*}
	delete {-mt::told::*}
	delete {-mt::qm::*}
	delete {-mt::qt::*}
	delete {-mt::defend::*}
	delete {-mt::conflict::*}
	delete {-mt::mk::*}
	delete {-mt::rep::*}
	delete {-mt::fakerole::*}
	delete {-mt::cx::*}
	delete {-mt::cxw::*}
	delete {-mt::repdue::*}
	delete {-mt::noparse::*}
	loop {-m::players::*}:
		set {_b} to loop-value
		if mIsBot({_b}) is true:
			loop {-m::players::*}:
				set {_t} to loop-value-2
				if {_t} is not {_b}:
					set {-mt::sus::%{_b}%::%{_t}%} to random integer between 0 and 15
			if mBotEvilSide({_b}) is true:
				loop {-m::players::*}:
					if {-m::team::%loop-value-2%} is "mafia":
						set {-mt::k::%{_b}%::%loop-value-2%} to "mafia"

# 낮이 시작될 때: 지난 밤 자기 조사 결과와 기자 특종, 새로 접선한 팀원을 반영한다
function mBotLearn():
	loop {-m::players::*}:
		set {_b} to loop-value
		if mIsBot({_b}) is true:
			set {_r} to {-m::inv::%{_b}%}
			set {_t} to {-m::act::%{_b}%}
			if {_r} is set:
				if {_t} is set:
					if {_r} is "mafia":
						set {-mt::k::%{_b}%::%{_t}%} to "mafia"
						set {-mt::sus::%{_b}%::%{_t}%} to 100
					else if {_r} is "town":
						set {-mt::k::%{_b}%::%{_t}%} to "town"
						set {-mt::sus::%{_b}%::%{_t}%} to -50
					else if {_r} starts with "role:":
						set {_ro} to {_r}
						replace all "role:" in {_ro} with ""
						set {_kv} to mBotKOfRole({_ro})
						set {-mt::k::%{_b}%::%{_t}%} to {_kv}
						if {_kv} is "town":
							set {-mt::sus::%{_b}%::%{_t}%} to -50
						else:
							set {-mt::sus::%{_b}%::%{_t}%} to 90
					else if {_r} starts with "tgt:":
						# 탐정: 대상이 누군가에게 능력을 썼다 = 조금 수상
						mBotAddSus({_b}, {_t}, 10)
					mBotPMem({_b}, "밤에 %mNum({_t})%번 %mNameOf({_t})% 조사 결과: %mBotResText({_r})%")
			loop {-m::rep::*}:
				set {-mt::k::%{_b}%::%loop-value-2%} to mBotKOfRole({-m::role::%loop-value-2%})
			if mBotEvilSide({_b}) is true:
				loop {-m::players::*}:
					if {-m::team::%loop-value-2%} is "mafia":
						set {-mt::k::%{_b}%::%loop-value-2%} to "mafia"
	# 밤 사망자를 어제 찍은 사람은 조금 수상
	mBotDeathReview()
	# 지난 보고들을 밤사이 공개된 직업·어제 투표와 맞춰 본다
	mBotContraSweep()

# 조사 결과 값을 글로
function mBotResText(r: text) :: text:
	if {_r} is "mafia":
		return "마피아"
	if {_r} is "town":
		return "마피아 아님"
	if {_r} starts with "role:":
		set {_x} to {_r}
		replace all "role:" in {_x} with ""
		return "직업은 %mRoleName({_x})%"
	if {_r} starts with "tgt:":
		set {_x} to {_r}
		replace all "tgt:" in {_x} with ""
		return "%mNum({_x})%번 %mNameOf({_x})% 에게 능력을 씀"
	if {_r} is "ign":
		return "대상 없이 능력을 씀"
	return "아무에게도 능력을 쓰지 않음"

# 살아 있는 다른 참가자 중 점수가 가장 높은 사람(c 목록 안에서). 같은 마피아 팀원은 마피아 팀 봇이 고르지 않는다
function mBotBest(b: text, c: texts, mode: text) :: text:
	set {_best} to ""
	set {_bs} to -9999
	loop {_c::*}:
		set {_t} to loop-value
		set {_ok} to true
		if {_t} is {_b}:
			set {_ok} to false
		if {-m::alive::%{_t}%} is not true:
			set {_ok} to false
		if mBotEvilSide({_b}) is true:
			if {-m::team::%{_t}%} is "mafia":
				set {_ok} to false
		if {_ok} is true:
			set {_s} to random number between 0 and 8
			if {_mode} is "sus":
				add mBotSus({_b}, {_t}) to {_s}
				if mBotK({_b}, {_t}) is "town":
					subtract 200 from {_s}
				if mBotK({_b}, {_t}) is "mafia":
					add 200 to {_s}
			else if {_mode} is "unknown":
				# 조사: 아직 모르는 사람, 그중 의심 가는 사람
				if mBotK({_b}, {_t}) is not "":
					subtract 500 from {_s}
				add mBotSus({_b}, {_t}) to {_s}
			else if {_mode} is "threat":
				# 마피아 팀: 직업을 밝힌 사람, 팀원을 의심하는 사람
				if {-mt::claim::%{_t}%} is set:
					add 60 to {_s}
				add mBotSus({_b}, {_t}) to {_s}
			else if {_mode} is "protect":
				# 지키기: 경찰 등 직업을 밝힌 사람, 시민으로 아는 사람
				if {-mt::claim::%{_t}%} is set:
					add 60 to {_s}
				if mBotK({_b}, {_t}) is "town":
					add 30 to {_s}
				subtract mBotSus({_b}, {_t}) from {_s}
			if {_s} > {_bs}:
				set {_bs} to {_s}
				set {_best} to {_t}
	return {_best}

# 밤 능력
function mTestNight(id: text):
	if mActCheck({_id}) is not "":
		stop
	# AI 가 이번 밤에 이미 정했으면(쓰지 않기로 한 것 포함) 그대로 둔다
	if {-mt::dec::%{_id}%} is "%mState()%-%{-m::day}%":
		stop
	set {_role} to mActRole({_id})
	set {_c::*} to mTargets({_id})
	if size of {_c::*} is 0:
		stop
	set {_t} to ""
	if {_role} is "mafia":
		# 마피아끼리 같은 대상(먼저 고른 봇의 선택을 따른다)
		set {_key} to "%{-m::day}%"
		if {-mt::mk::%{_key}%} is set:
			if {_c::*} contains {-mt::mk::%{_key}%}:
				set {_t} to {-mt::mk::%{_key}%}
		if {_t} is "":
			set {_t} to mBotBest({_id}, {_c::*}, "threat")
			set {-mt::mk::%{_key}%} to {_t}
	else if {_role} is "doctor":
		if chance of 35%:
			if {_c::*} contains {_id}:
				set {_t} to {_id}
		if {_t} is "":
			set {_t} to mBotBest({_id}, {_c::*}, "protect")
	else if {_role} is "guardian":
		set {_t} to mBotBest({_id}, {_c::*}, "protect")
	else if {_role} is "police" or "spy" or "detective":
		set {_t} to mBotBest({_id}, {_c::*}, "unknown")
	else if {_role} is "reporter":
		if {-m::day} < 2:
			stop
		set {_t} to mBotBest({_id}, {_c::*}, "sus")
	else if {_role} is "vigilante":
		# 확신할 때만(아는 마피아이거나 의심이 아주 높을 때)
		set {_t} to mBotBest({_id}, {_c::*}, "sus")
		if {_t} is not "":
			if mBotK({_id}, {_t}) is not "mafia":
				if mBotSus({_id}, {_t}) < 70:
					stop
	else if {_role} is "thief":
		if {-m::day} < 2:
			stop
		set {_t} to mBotBest({_id}, {_c::*}, "threat")
	else if {_role} is "assassin":
		set {_t} to mBotBest({_id}, {_c::*}, "threat")
	else if {_role} is "arsonist":
		set {_oil} to 0
		set {_al} to 0
		loop {-m::players::*}:
			if {-m::alive::%loop-value%} is true:
				add 1 to {_al}
				if {-m::oil::%loop-value%} is true:
					add 1 to {_oil}
		set {_need} to {_al} / 2
		if {_oil} >= {_need}:
			mSetIgnite({_id})
			stop
		if {_oil} >= 2:
			if chance of 30%:
				mSetIgnite({_id})
				stop
		loop {_c::*}:
			if {-m::oil::%loop-value%} is not true:
				add loop-value to {_dry::*}
		if size of {_dry::*} > 0:
			set {_t} to random element of {_dry::*}
	else if {_role} is "witch":
		if mBotEvilSide({_id}) is true:
			set {_t} to mBotBest({_id}, {_c::*}, "threat")
		else:
			set {_t} to mBotBest({_id}, {_c::*}, "sus")
	else if {_role} is "thug" or "shaman":
		set {_t} to mBotBest({_id}, {_c::*}, "sus")
	if {_t} is "":
		set {_t} to random element of {_c::*}
	mSetAct({_id}, {_t})

# 투표
function mTestVote(id: text):
	if mVoteCan({_id}) is not "":
		stop
	if chance of 8%:
		stop
	loop {-m::players::*}:
		if loop-value is not {_id}:
			if {-m::alive::%loop-value%} is true:
				add loop-value to {_c::*}
	if size of {_c::*} is 0:
		stop
	set {_role} to {-m::role::%{_id}%}
	if {_role} is "jester":
		mVoteCast({_id}, random element of {_c::*})
		stop
	# 지금 표가 몰린 만큼 점수를 더해(따라가기) 고른다
	set {_best} to ""
	set {_bs} to -9999
	loop {_c::*}:
		set {_t} to loop-value
		set {_s} to random number between 0 and 10
		set {_v} to {-m::votes::%{_t}%}
		if {_v} is set:
			add {_v} * 12 to {_s}
		if mBotEvilSide({_id}) is true:
			if {-m::team::%{_t}%} is "mafia":
				subtract 500 from {_s}
			if {-mt::claim::%{_t}%} is set:
				add 40 to {_s}
			add mBotSus({_id}, {_t}) to {_s}
		else:
			add mBotSus({_id}, {_t}) to {_s}
			if mBotK({_id}, {_t}) is "mafia":
				add 300 to {_s}
			else if mBotK({_id}, {_t}) is "evil":
				add 150 to {_s}
			else if mBotK({_id}, {_t}) is "town":
				subtract 300 from {_s}
		if {_s} > {_bs}:
			set {_bs} to {_s}
			set {_best} to {_t}
	if {_best} is "":
		stop
	if mVoteCast({_id}, {_best}) is "":
		# 가끔 누구 찍었는지 말한다
		if mIsBot({_id}) is true:
			if chance of 25%:
				mBotSpeak({_id}, "vote", {_best}, "", "")

# 테러리스트 봇의 길동무: 아는 마피아 → 가장 의심
function mTestTake(id: text):
	if {-m::exe} is not {_id}:
		stop
	loop {-m::players::*}:
		if loop-value is not {_id}:
			if {-m::alive::%loop-value%} is true:
				add loop-value to {_c::*}
	if size of {_c::*} is 0:
		stop
	set {_t} to mBotBest({_id}, {_c::*}, "sus")
	if {_t} is "":
		set {_t} to random element of {_c::*}
	mTakePick({_id}, {_t})

# ------------------------------------------------------------------ 봇 추리: 투표 기록, 밤 사망자, 직업 주장 충돌

# 한 사람만 있는 직업(같은 직업을 둘이 주장하면 적어도 하나는 거짓)
function mBotUniqueRole(r: text) :: boolean:
	if {_r} is "police" or "doctor" or "reporter" or "detective" or "soldier" or "politician" or "terrorist" or "guardian" or "shaman" or "vigilante" or "thug":
		return true
	return false

# 투표가 끝났을 때(다음 단계로 넘어가는 순간): 누가 누구를 찍었는지로 의심을 고친다
#   확인된 시민을 찍은 사람 +20, 확인된 마피아를 찍은 사람 -10, 아는 마피아가 있는데 다른 사람을 찍은 사람 +8, 나(시민)를 찍은 사람 +15
function mBotVoteReview():
	loop {-m::players::*}:
		set {_v} to loop-value
		set {_t} to {-m::vote::%{_v}%}
		if {_t} is set:
			set {-mt::lastvote::%{_v}%} to {_t}
			loop {-m::players::*}:
				set {_b} to loop-value-2
				if mIsBot({_b}) is true:
					if {_b} is not {_v}:
						if mBotEvilSide({_b}) is false:
							set {_kt} to mBotK({_b}, {_t})
							if {_kt} is "town":
								mBotAddSus({_b}, {_v}, 20)
							else if {_kt} is "mafia" or "evil":
								mBotAddSus({_b}, {_v}, -10)
							else:
								loop {-m::players::*}:
									if {-m::alive::%loop-value-3%} is true:
										if mBotK({_b}, loop-value-3) is "mafia":
											if loop-value-3 is not {_t}:
												mBotAddSus({_b}, {_v}, 8)
							if {_t} is {_b}:
								mBotAddSus({_b}, {_v}, 15)
		else:
			delete {-mt::lastvote::%{_v}%}

# 낮이 시작될 때: 밤에 죽은 사람은 대개 시민. 어제 그 사람을 찍은 사람은 조금 수상(+12)
function mBotDeathReview():
	loop {-m::dead::*}:
		set {_d} to loop-value
		loop {-m::players::*}:
			set {_v} to loop-value-2
			if {-mt::lastvote::%{_v}%} is {_d}:
				loop {-m::players::*}:
					set {_b} to loop-value-3
					if mIsBot({_b}) is true:
						if {_b} is not {_v}:
							if mBotEvilSide({_b}) is false:
								mBotAddSus({_b}, {_v}, 12)

# s 가 직업 r 을 주장했다. 한 사람만 있는 직업을 이미 다른 생존자가 주장했으면 충돌로 처리한다
function mBotSetClaim(s: text, r: text):
	if {-mt::claim::%{_s}%} is {_r}:
		stop
	set {-mt::claim::%{_s}%} to {_r}
	if mBotUniqueRole({_r}) is false:
		stop
	loop {-m::players::*}:
		set {_o} to loop-value
		if {_o} is not {_s}:
			if {-m::alive::%{_o}%} is true:
				if {-mt::claim::%{_o}%} is {_r}:
					mBotConflict({_s}, {_o}, {_r})

# a 와 b 가 같은 직업 r 을 주장했다
function mBotConflict(a: text, b: text, r: text):
	set {_any} to ""
	loop {-m::players::*}:
		set {_x} to loop-value
		if mIsBot({_x}) is true:
			if {-m::alive::%{_x}%} is true:
				if mBotEvilSide({_x}) is false:
					if {_x} is {_a} or {_b}:
						# 내가 진짜면 상대는 거짓말쟁이
						set {_other} to {_a}
						if {_x} is {_a}:
							set {_other} to {_b}
						if mActRole({_x}) is {_r}:
							mBotAddSus({_x}, {_other}, 100)
							set {-mt::conflict::%{_x}%} to {_other}
					else if mActRole({_x}) is {_r}:
						# 진짜 그 직업인 봇: 둘 다 거짓말
						mBotAddSus({_x}, {_a}, 100)
						mBotAddSus({_x}, {_b}, 100)
					else if mBotK({_x}, {_a}) is "town":
						mBotAddSus({_x}, {_b}, 60)
					else if mBotK({_x}, {_b}) is "town":
						mBotAddSus({_x}, {_a}, 60)
					else:
						mBotAddSus({_x}, {_a}, 30)
						mBotAddSus({_x}, {_b}, 30)
						if {_any} is "":
							set {_any} to {_x}
	# 구경하던 봇 하나가 충돌을 짚는다
	if {_any} is not "":
		mBotQueue({_any}, "conflict|%{_a}%|%{_b}%|%{_r}%", random integer between 2 and 5)


# ------------------------------------------------------------------ 아침 보고와 모순 찾기
# 낮이 시작되면 살아 있는 봇이 번호 순서대로 "직업 + 지난밤 한 일(결과)"을 말한다(첫 번째 말할 차례가 보고).
#   시민 팀 봇은 사실대로(진짜 직업, {-m::act} 대상, {-m::inv} 결과). 마피아 팀·중립 봇은 첫 보고 때 그럴듯한 가짜 직업을 정해
#   ({-mt::fakerole::봇}, 아직 아무도 주장하지 않은 직업 우선) 게임 내내 그 직업으로 가짜 행적을 꾸민다. 진짜 대상이 살아 있으면 그 사람을 대상으로 말해 탐정 결과와 어긋나지 않게 한다.
#   광인은 자기가 그 직업인 줄 알므로 사실대로(결과는 지어냄) 말한다.
# 보고 기록 {-mt::rep::사람::일차} = "직업|대상uuid 또는 -|결과 또는 -" (결과: 경찰 mafia/town, 의사 saved, 탐정 tgt:uuid/none/ign, 자경단 kill).
#   사람의 보고는 AI 가 말 뜻을 읽을 때 함께 기록한다(mBotApplyParse 의 night_target/night_result).
# 모순(mBotContraOne, 보고할 때와 낮이 시작될 때 검사, {-mt::cx::키} 로 한 번만):
#   주장한 직업이 공개된 직업(기자 특종 등)과 다름 / 의사·수호자가 지켰다는 사람이 그날 밤 죽음(방화 제외) /
#   경찰 결과가 나중에 공개된 직업과 다름 / 탐정 결과와 대상 본인의 보고가 다름(둘 다 의심) / 건달이 협박했다는 사람이 투표함.
#   찾으면 시민 팀 봇들이 의심을 크게 올리고(마피아 팀 봇은 팀원이면 모른 척), 봇 하나가 "contra" 로 짚는다.

# 한글 낱말 끝 받침이 있으면 a, 없으면 b (예: 경찰"이에요" / 의사"예요")
function mKoJ(w: text, a: text, b: text) :: text:
	set {_n} to {_w}.length()
	if {_n} is 0:
		return {_a}
	set {_i} to {_n} - 1
	set {_c} to {_w}.codePointAt({_i})
	if {_c} < 44032:
		return {_a}
	if {_c} > 55203:
		return {_a}
	set {_x} to {_c} - 44032
	if mod({_x}, 28) is 0:
		return {_b}
	return {_a}

# "이에요/예요", "이라고/라고"
function mKoIe(w: text) :: text:
	return mKoJ({_w}, "이에요", "예요")

function mKoIra(w: text) :: text:
	return mKoJ({_w}, "이라고", "라고")

# 색 코드를 뺀 글(AI 에게 줄 때)
function mBotPlain(s: text) :: text:
	return {_s}.replaceAll("[&§][0-9a-fk-orA-FK-OR]", "")

# 거짓 보고를 하는 봇인지: 시민 팀이 아니면(마피아 팀, 접선 전 보조, 중립) 거짓. 광인은 자기가 시민인 줄 안다
function mBotLiar(b: text) :: boolean:
	if {-m::role::%{_b}%} is "madman":
		return false
	if {-m::team::%{_b}%} is "citizen":
		return false
	return true

# 가짜 직업 고르기(한 번 정하면 유지). 많이 쓰이는 무난한 직업 위주, 이미 누가 주장했거나 공개된 직업은 피한다
function mBotFakePick(b: text) :: text:
	if {-mt::fakerole::%{_b}%} is set:
		return {-mt::fakerole::%{_b}%}
	set {_w::*} to "soldier", "soldier", "soldier", "politician", "politician", "terrorist", "terrorist", "shaman", "shaman", "doctor", "doctor", "guardian", "detective", "thug" and "police"
	loop {_w::*}:
		if mRoleOn(loop-value) is true:
			add loop-value to {_c::*}
	if size of {_c::*} is 0:
		set {_c::*} to "soldier" and "politician"
	set {_pick} to random element of {_c::*}
	set {_k} to 0
	while {_k} < 8:
		add 1 to {_k}
		set {_x} to random element of {_c::*}
		set {_ok} to true
		loop {-m::players::*}:
			if loop-value is not {_b}:
				if {-mt::claim::%loop-value%} is {_x}:
					set {_ok} to false
				if {-mt::fakerole::%loop-value%} is {_x}:
					set {_ok} to false
				if {-m::pubrole::%loop-value%} is {_x}:
					set {_ok} to false
				if {-m::alive::%loop-value%} is true:
					if mActRole(loop-value) is {_x}:
						# 마피아 팀은 팀원의 진짜 직업을 안다(겹치지 않게)
						if {-m::team::%loop-value%} is "mafia":
							if {-m::team::%{_b}%} is "mafia":
								set {_ok} to false
		if {_ok} is true:
			set {_pick} to {_x}
			set {_k} to 99
	set {-mt::fakerole::%{_b}%} to {_pick}
	return {_pick}

# 오늘 할 보고 만들기("직업|대상|결과"). 이미 했으면 ""
function mBotRepMake(b: text) :: text:
	set {_d} to {-m::day}
	if {-mt::rep::%{_b}%::%{_d}%} is set:
		return ""
	set {_at} to "-"
	if {-m::act::%{_b}%} is set:
		set {_at} to {-m::act::%{_b}%}
	set {_res} to "-"
	# ---- 거짓 보고(직업이 공개된 뒤에는 숨길 수 없으니 사실대로)
	if mBotLiar({_b}) is true:
		if {-m::pubrole::%{_b}%} is not set:
			set {_r} to mBotFakePick({_b})
			loop {-m::players::*}:
				if loop-value is not {_b}:
					if {-m::alive::%loop-value%} is true:
						add loop-value to {_al::*}
						if {-m::team::%loop-value%} is "mafia":
							if {-m::team::%{_b}%} is "mafia":
								add loop-value to {_mates::*}
							else:
								add loop-value to {_others::*}
						else:
							add loop-value to {_others::*}
			if size of {_al::*} is 0:
				return "%{_r}%|-|-"
			set {_t} to "-"
			if {_r} is "police" or "doctor" or "guardian" or "shaman" or "thug" or "detective":
				set {_t} to random element of {_al::*}
				# 진짜로 능력을 쓴 대상이 살아 있으면 그 사람을 말한다(탐정 결과와 맞게)
				if {_at} is not "-":
					if {_al::*} contains {_at}:
						if chance of 60%:
							set {_t} to {_at}
				if {_r} is "doctor":
					if chance of 25%:
						set {_t} to {_b}
			if {_r} is "police":
				# 둘째 날부터 가끔 시민을 마피아로 몬다. 아니면 팀원이나 아무나 "마피아 아님"
				set {_res} to "town"
				if {-m::day} >= 2:
					if chance of 35%:
						if size of {_others::*} > 0:
							set {_fr} to mBotBest({_b}, {_others::*}, "threat")
							if {_fr} is not "":
								set {_t} to {_fr}
								set {_res} to "mafia"
				if {_res} is "town":
					if size of {_mates::*} > 0:
						if chance of 40%:
							set {_t} to random element of {_mates::*}
			if {_r} is "detective":
				set {_res} to "none"
				if size of {_others::*} > 0:
					set {_t} to random element of {_others::*}
				if chance of 40%:
					set {_y} to random element of {_al::*}
					if {_y} is not {_t}:
						set {_res} to "tgt:%{_y}%"
			set {_spec} to "%{_r}%|%{_t}%|%{_res}%"
			mBotPMem({_b}, "%{-m::day}%일차 아침에 거짓 보고를 했다: %mBotPlain(mBotRepText({_b}, {_spec}))%")
			return {_spec}
	# ---- 사실대로
	set {_r} to mActRole({_b})
	set {_mad} to false
	if {-m::role::%{_b}%} is "madman":
		set {_mad} to true
	set {_t} to {_at}
	if {_r} is "police":
		if {_t} is not "-":
			if {-m::inv::%{_b}%} is set:
				set {_res} to {-m::inv::%{_b}%}
			else:
				# 광인: 결과가 없으니 지어낸다
				set {_res} to "town"
				if chance of 30%:
					set {_res} to "mafia"
	else if {_r} is "doctor":
		if {_t} is not "-":
			loop {-m::ev::*}:
				if loop-value starts with "healed|":
					if loop-value ends with "|%{_t}%":
						set {_res} to "saved"
	else if {_r} is "detective":
		if {_t} is not "-":
			set {_res} to "none"
			if {-m::inv::%{_b}%} is set:
				set {_res} to {-m::inv::%{_b}%}
	else if {_r} is "vigilante":
		if {_t} is not "-":
			loop {-m::ev::*}:
				if loop-value is "kill|%{_b}%|%{_t}%":
					set {_res} to "kill"
	else if {_r} is "reporter":
		if {_mad} is true:
			set {_t} to "-"
	else if {_r} is "guardian" or "shaman" or "thug":
		set {_res} to "-"
	else:
		set {_t} to "-"
	return "%{_r}%|%{_t}%|%{_res}%"

# 보고 문장(색 있는 글). s = 말하는 사람
function mBotRepText(s: text, spec: text) :: text:
	set {_f::*} to split {_spec} at "|"
	set {_r} to {_f::1}
	set {_t} to {_f::2}
	set {_res} to {_f::3}
	set {_rn} to mRoleName({_r})
	set {_head} to "%{_rn}%%mKoIe({_rn})%."
	set {_tr} to ""
	if {_t} is not "-":
		set {_tr} to mBotRef({_t})
	if {_r} is "police":
		if {_t} is "-":
			return "%{_head}% 어젯밤엔 조사를 못 했어요"
		if {_res} is "mafia":
			return "%{_head}% 어젯밤 %{_tr}% 조사했는데 마피아예요!"
		return "%{_head}% 어젯밤 %{_tr}% 조사했는데 마피아 아니에요"
	if {_r} is "doctor":
		if {_t} is "-":
			return "%{_head}% 어젯밤엔 아무도 못 살렸어요"
		set {_x} to "%{_tr}% 님을 살렸어요"
		if {_t} is {_s}:
			set {_x} to "저를 살렸어요"
		if {_res} is "saved":
			return "%{_head}% 어젯밤 %{_x}%. 공격도 막았어요"
		return "%{_head}% 어젯밤 %{_x}%"
	if {_r} is "guardian":
		if {_t} is "-":
			return "%{_head}% 어젯밤엔 아무도 안 지켰어요"
		return "%{_head}% 어젯밤 %{_tr}% 님을 지켰어요"
	if {_r} is "detective":
		if {_t} is "-":
			return "%{_head}% 어젯밤엔 조사를 못 했어요"
		if {_res} starts with "tgt:":
			set {_y} to {_res}
			replace all "tgt:" in {_y} with ""
			return "%{_head}% %{_tr}% 님이 어젯밤 %mBotRef({_y})% 님에게 능력을 썼어요"
		if {_res} is "ign":
			return "%{_head}% %{_tr}% 님이 어젯밤 대상 없이 능력을 썼어요"
		return "%{_head}% %{_tr}% 님은 어젯밤 아무에게도 능력을 안 썼어요"
	if {_r} is "reporter":
		if {_t} is "-":
			return "%{_head}% 특종은 아직 아껴 두고 있어요"
		return "%{_head}% 어젯밤 %{_tr}% 님 특종을 냈어요"
	if {_r} is "thug":
		if {_t} is "-":
			return "%{_head}% 어젯밤엔 아무도 협박 안 했어요"
		return "%{_head}% 어젯밤 %{_tr}% 님을 협박해서 오늘 투표 못 해요"
	if {_r} is "shaman":
		if {_t} is "-":
			return "%{_head}% 어젯밤엔 주술을 안 걸었어요"
		return "%{_head}% 어젯밤 %{_tr}% 님에게 주술을 걸었어요"
	if {_r} is "vigilante":
		if {_t} is "-":
			return "%{_head}% 처단은 아직 안 썼어요"
		if {_res} is "kill":
			return "%{_head}% 어젯밤 %{_tr}% 님을 처단했어요"
		return "%{_head}% 어젯밤 %{_tr}% 님을 노렸는데 실패했어요"
	return "%{_head}% 밤에 쓰는 능력은 없어요"

# 아침 보고 차례
function mBotReport(b: text):
	if {-m::alive::%{_b}%} is not true:
		stop
	set {_spec} to mBotRepMake({_b})
	if {_spec} is "":
		stop
	set {-mt::told::%{_b}%::%{-m::day}%} to true
	mBotRepApply({_b}, {_spec}, true)
	set {_f::*} to split {_spec} at "|"
	set {_t} to ""
	if {_f::2} is not "-":
		set {_t} to {_f::2}
	# 보고는 뜻이 정해져 있으니 AI 로 다시 읽지 않는다
	set {-mt::noparse::%{_b}%} to true
	mBotSpeak({_b}, "report", {_t}, "", mBotRepText({_b}, {_spec}))

# 보고를 기록하고 직업 주장·모순 검사를 한다. fx = 경찰 결과를 고발/변호로 반영(봇의 보고. 사람 말은 AI 해석이 이미 반영)
function mBotRepApply(s: text, spec: text, fx: boolean):
	set {_d} to {-m::day}
	set {-mt::rep::%{_s}%::%{_d}%} to {_spec}
	set {_f::*} to split {_spec} at "|"
	mBotSetClaim({_s}, {_f::1})
	mBotDbg("보고 %mNum({_s})%번: %{_spec}%")
	if {_fx} is true:
		if {_f::1} is "police":
			if {_f::2} is not "-":
				if {_f::3} is "mafia":
					mBotClaim({_s}, {_f::2}, "mafia")
				else if {_f::3} is "town":
					mBotClaim({_s}, {_f::2}, "town")
	mBotContraOne({_s}, {_d}, 0)
	# 이 사람을 본 탐정 보고와 맞춰 본다
	loop {-m::players::*}:
		set {_p} to loop-value
		if {_p} is not {_s}:
			set {_ps} to {-mt::rep::%{_p}%::%{_d}%}
			if {_ps} is set:
				set {_pf::*} to split {_ps} at "|"
				if {_pf::1} is "detective":
					if {_pf::2} is {_s}:
						mBotDetPair({_p}, {_s}, {_d}, 0)

# 사람 s 의 d 일차 보고에 모순이 있는지(dl = 짚기 전 더 기다릴 초)
function mBotContraOne(s: text, d: number, dl: number):
	set {_spec} to {-mt::rep::%{_s}%::%{_d}%}
	if {_spec} is not set:
		stop
	if {-m::alive::%{_s}%} is not true:
		stop
	set {_f::*} to split {_spec} at "|"
	set {_r} to {_f::1}
	set {_t} to {_f::2}
	set {_res} to {_f::3}
	set {_rs} to mBotRef({_s})
	set {_rn} to mRoleName({_r})
	# 주장한 직업과 공개된 직업이 다름
	set {_pr} to {-m::pubrole::%{_s}%}
	if {_pr} is set:
		if {_pr} is not {_r}:
			set {_pn} to mRoleName({_pr})
			mBotContra({_s}, "", "pub-%{_s}%", "%{_rs}% 님은 %{_rn}%%mKoIra({_rn})% 했는데 공개된 직업은 %{_pn}%%mKoIe({_pn})%", 80, {_dl})
			stop
	if {_t} is "-":
		stop
	set {_rt} to mBotRef({_t})
	# 지켰다는 사람이 그날 밤 죽음(방화는 무엇으로도 못 막는다)
	if {_d} is {-m::day}:
		if {_r} is "doctor" or "guardian":
			if {_t} is not {_s}:
				if {-m::dead::*} contains {_t}:
					set {_burn} to false
					loop {-m::ev::*}:
						if loop-value starts with "burn|":
							if loop-value ends with "|%{_t}%":
								set {_burn} to true
					if {_burn} is false:
						mBotContra({_s}, "", "save-%{_s}%-%{_d}%", "%{_rs}% 님이 어젯밤 %{_rt}% 님을 지켰다는데 %{_rt}% 님이 죽었어요", 60, {_dl})
	# 경찰 결과가 나중에 공개된 직업과 다름
	if {_r} is "police":
		set {_tp} to {-m::pubrole::%{_t}%}
		if {_tp} is set:
			set {_tpn} to mRoleName({_tp})
			if {_res} is "mafia":
				if {_tp} is not "mafia":
					mBotContra({_s}, "", "pol-%{_s}%-%{_d}%", "%{_rs}% 님이 %{_rt}% 님을 마피아라고 했는데 공개된 직업은 %{_tpn}%%mKoIe({_tpn})%", 80, {_dl})
			else if {_res} is "town":
				if {_tp} is "mafia":
					mBotContra({_s}, "", "pol-%{_s}%-%{_d}%", "%{_rs}% 님이 %{_rt}% 님은 마피아가 아니라고 했는데 마피아였어요", 80, {_dl})
	if {_r} is "detective":
		mBotDetPair({_s}, {_t}, {_d}, {_dl})

# 탐정 det 의 결과와 대상 x 본인의 보고(같은 날)가 맞는지. 어긋나면 둘 중 하나는 거짓말
function mBotDetPair(det: text, x: text, d: number, dl: number):
	set {_ds} to {-mt::rep::%{_det}%::%{_d}%}
	set {_xs} to {-mt::rep::%{_x}%::%{_d}%}
	if {_ds} is not set:
		stop
	if {_xs} is not set:
		stop
	set {_df::*} to split {_ds} at "|"
	set {_xf::*} to split {_xs} at "|"
	set {_res} to {_df::3}
	set {_bad} to false
	if {_res} starts with "tgt:":
		set {_y} to {_res}
		replace all "tgt:" in {_y} with ""
		if {_xf::2} is not {_y}:
			set {_bad} to true
	else if {_res} is "none":
		if {_xf::2} is not "-":
			set {_bad} to true
	if {_bad} is false:
		stop
	mBotContra({_x}, {_det}, "det-%{_det}%-%{_x}%-%{_d}%", "%mBotRef({_det})% 님 탐정 결과랑 %mBotRef({_x})% 님이 말한 행적이 달라요", 35, {_dl})

# s 의 말에 모순(why)이 있다. o = 함께 의심받는 사람(없으면 ""). w = 의심 점수, dl = 짚기 전 더 기다릴 초
function mBotContra(s: text, o: text, key: text, why: text, w: number, dl: number):
	if {-mt::cx::%{_key}%} is set:
		stop
	set {-mt::cx::%{_key}%} to true
	set {-mt::cxw::%{_s}%} to {_why}
	mBotDbg("모순 %mNum({_s})%번: %mBotPlain({_why})%")
	loop {-m::players::*}:
		set {_x} to loop-value
		if mIsBot({_x}) is true:
			if {-m::alive::%{_x}%} is true:
				if {_x} is not {_s}:
					if {_x} is not {_o}:
						set {_skip} to false
						if mBotEvilSide({_x}) is true:
							# 마피아 팀: 팀원의 거짓말은 모른 척
							if {-m::team::%{_s}%} is "mafia":
								set {_skip} to true
						if mBotK({_x}, {_s}) is "town":
							set {_skip} to true
						if {_skip} is false:
							mBotAddSus({_x}, {_s}, {_w})
							if {_o} is not "":
								if mBotK({_x}, {_o}) is not "town":
									mBotAddSus({_x}, {_o}, {_w})
							if {-mt::qm::%{_x}%} is not set:
								add {_x} to {_cand::*}
	if size of {_cand::*} is 0:
		stop
	set {_c} to random element of {_cand::*}
	set {_u} to {_o}
	if {_u} is "":
		set {_u} to {_s}
	set {_m} to {_why}
	replace all "|" in {_m} with "/"
	set {_sec} to {_dl} + random integer between 3 and 6
	mBotQueue({_c}, "contra|%{_s}%|%{_u}%|%{_m}%", {_sec})

# 낮이 시작될 때: 지난 보고들을 다시 맞춰 본다(밤사이 공개된 직업), 어제 협박당했다던 사람이 투표했는지
function mBotContraSweep():
	set {_dl} to mStgMorningLen() + 2
	set {_pd} to {-m::day} - 1
	loop {-m::players::*}:
		set {_p} to loop-value
		if {-m::alive::%{_p}%} is true:
			set {_i} to 0
			while {_i} < {-m::day}:
				add 1 to {_i}
				mBotContraOne({_p}, {_i}, {_dl})
			set {_ps} to {-mt::rep::%{_p}%::%{_pd}%}
			if {_ps} is set:
				set {_f::*} to split {_ps} at "|"
				if {_f::1} is "thug":
					if {_f::2} is not "-":
						if {-mt::lastvote::%{_f::2}%} is set:
							mBotContra({_p}, "", "thug-%{_p}%-%{_pd}%", "%mBotRef({_p})% 님이 %mBotRef({_f::2})% 님을 협박했다는데 %mBotRef({_f::2})% 님이 투표했어요", 60, {_dl})

# ------------------------------------------------------------------ 봇 채팅

# 말 고르기: 종류마다 여러 문장 중 하나. @t = 대상, @u = 두 번째 대상, @r = 직업 이름
function mBotLine(kind: text) :: text:
	if {_kind} is "police_mafia":
		set {_l::*} to "경찰입니다. @t 마피아에요!", "경찰인데 어젯밤 @t 조사했어요. 마피아입니다", "@t 마피아 확정이에요. 제가 경찰이에요", "다들 들어 보세요, 경찰인데 @t 마피아 나왔어요"
	else if {_kind} is "police_town":
		set {_l::*} to "경찰인데 @t 님은 시민 확인했어요", "@t 님 조사했는데 시민이에요. 저 경찰이에요", "경찰입니다. @t 님은 믿으셔도 돼요"
	else if {_kind} is "accuse":
		set {_l::*} to "@t 님이 제일 수상해요. 마피아 같아요", "저는 @t 님 의심돼요", "@t 님 말이 좀 이상해요. 마피아 아닐까요", "@t 님 오늘 좀 조용하신데 마피아 같네요", "솔직히 @t 님 마피아 같아요"
	else if {_kind} is "mafia_push":
		set {_l::*} to "@t 님 좀 마피아 같은데요", "@t 님 반응이 수상해요", "저는 @t 님 찍을래요. 마피아 같아요", "@t 님 어제부터 이상했어요"
	else if {_kind} is "defend_role":
		set {_l::*} to "저 @r이에요. 저 아니에요", "@r인데 왜 저를... 저 시민이에요", "저 진짜 @r이에요, 다른 사람 보세요"
	else if {_kind} is "defend":
		set {_l::*} to "저 시민이에요. @t 님이 더 수상해요", "저 아니에요! @t 님이 저 몰아가는 거예요", "왜 저예요? 저 시민이에요", "저 마피아 아니에요. @t 님 이상해요"
	else if {_kind} is "fake_police":
		set {_l::*} to "제가 경찰인데요, @t 님이 마피아에요. 저 몰아가는 거예요", "경찰입니다. 오히려 @t 님이 마피아 나왔어요", "제가 진짜 경찰이에요. @t 님 거짓말이에요"
	else if {_kind} is "agree":
		set {_l::*} to "그럼 @t 투표 가죠", "@t 님 저도 수상했어요", "@t 찍을게요", "오 @t 님이었구나"
	else if {_kind} is "conflict":
		set {_l::*} to "@r이 둘이네요? @t, @u 둘 중 하나는 거짓말이에요", "@t 님이랑 @u 님 둘 다 @r이라고요? 수상하네요", "@r 주장이 두 명이에요. 둘 다 조심해야겠어요"
	else if {_kind} is "real_vs_fake":
		set {_l::*} to "제가 진짜 @r이에요. @t 님 거짓말이에요!", "@t 님이 @r 사칭하는 거예요. 마피아에요", "@r은 저예요. @t 님 마피아 확실해요"
	else if {_kind} is "jester":
		set {_l::*} to "음... 저 뽑으셔도 괜찮아요 ㅎㅎ", "제가 마피아일 수도 있죠~", "저 찍어 보실래요?", "ㅋㅋ 저 수상하죠?"
	else if {_kind} is "reply":
		set {_l::*} to " 님, 저요? 저는 시민이에요", " 님 왜 저를 부르세요?", " 님 생각은 어떠세요?", "음...  님 말 좀 더 들어 볼게요", " 님, 저는 아직 확신이 없어요"
	else if {_kind} is "vote":
		set {_l::*} to "@t 갑니다", "저는 @t", "@t 찍었어요", "@t 님 투표했어요"
	else if {_kind} is "idle":
		set {_l::*} to "아직 잘 모르겠어요", "다들 의심 가는 사람 있어요?", "경찰 있으면 말해 주세요", "음... 누구지", "어젯밤 누가 움직였을까요"
	else if {_kind} is "report":
		# @x = 보고 문장(mBotRepText)
		set {_l::*} to "@x"
	else if {_kind} is "contra":
		# @x = 모순 내용
		set {_l::*} to "잠깐만요, @x. @t 님 설명해 보세요", "이상한데요? @x", "@x. @t 님 거짓말하는 거 아니에요?"
	if size of {_l::*} is 0:
		return ""
	return random element of {_l::*}

# 문장에 대상·직업을 넣는다
# 사람 부르는 말: "3번 민준"(번호와 이름을 같이)
function mBotRef(t: text) :: text:
	return "&6%mNum({_t})%번 &f%mNameOf({_t})%&r"

function mBotFill(line: text, t: text, u: text, r: text) :: text:
	set {_s} to {_line}
	# @x 는 r 을 글 그대로 넣는다(보고·모순 문장)
	if {_s} contains "@x":
		replace all "@x" in {_s} with {_r}
		set {_r} to ""
	if {_t} is not "":
		replace all "@t" in {_s} with mBotRef({_t})
	if {_u} is not "":
		replace all "@u" in {_s} with mBotRef({_u})
	if {_r} is not "":
		replace all "@r" in {_s} with mRoleName({_r})
	return {_s}

# 봇이 채팅에 말한다(생존자 대화처럼 모두에게 보이고 기록에도 남는다). 낮마다 다섯 마디까지(대답 포함)
function mBotSay(b: text, msg: text):
	if {-m::alive::%{_b}%} is not true:
		stop
	if {-mt::said::%{_b}%} is set:
		if {-mt::said::%{_b}%} >= 5:
			stop
	set {_line} to "&7<{{n:%{_b}%}}&7> &f%{_msg}%"
	mBotChatAdd({_b}, {_msg})
	# 받는 사람마다 그 사람의 메모를 봇 이름 옆에 붙인다(사람 채팅과 같은 모양)
	loop all players:
		set {_tag} to mMemoTag("%uuid of loop-player%", {_b})
		set {_nm} to mNumName({_b})
		if {_tag} is not "":
			set {_nm} to "%{_nm}% %{_tag}%"
		send colored "&7<%{_nm}%&7> &f%{_msg}%" to loop-player
	mLogAdd("*", {_line})
	add 1 to {-mt::said::%{_b}%}
	mBotDbg("말 %mNum({_b})%번 %mNameOf({_b})%: %{_msg}%")
	# 봇이 한 말은 AI 로 다시 읽지 않는다. 뜻은 말하기 전에 의도(mBotIntentEffect)로 이미 반영했다
	#   (작은 모델이 봇 말을 잘못 읽어 엉뚱한 사람을 몰고, 줄이 밀려 사람 말을 못 읽는 문제가 있었다)
	delete {-mt::noparse::%{_b}%}

# 조금 뒤에 할 말을 예약한다(spec = "종류|대상|두 번째|직업", 초 뒤)
function mBotQueue(b: text, spec: text, sec: number):
	if {-mt::qm::%{_b}%} is set:
		stop
	set {-mt::qm::%{_b}%} to {_spec}
	set {-mt::qt::%{_b}%} to {_sec}

function mBotSayQueued(b: text):
	set {_f::*} to split {-mt::qm::%{_b}%} at "|"
	delete {-mt::qm::%{_b}%}
	delete {-mt::qt::%{_b}%}
	set {_t} to ""
	set {_u} to ""
	set {_r} to ""
	if {_f::2} is set:
		set {_t} to {_f::2}
	if {_f::3} is set:
		set {_u} to {_f::3}
	if {_f::4} is set:
		set {_r} to {_f::4}
	if {_t} is not "":
		if {-m::alive::%{_t}%} is not true:
			stop
	mBotSpeak({_b}, {_f::1}, {_t}, {_u}, {_r})

# 말한 사람 s 가 t 를 고발(kind "mafia") 또는 변호(kind "town")했다. 봇들이 받아들인다
function mBotClaim(s: text, t: text, kind: text):
	if {_t} is {_s}:
		stop
	# 맞장구는 한 번에 한 봇만(우르르 몰아가지 않게)
	set {_ag} to false
	loop {-m::players::*}:
		set {_b} to loop-value
		if mIsBot({_b}) is true:
			if {_b} is not {_s}:
				if {-m::alive::%{_b}%} is true:
					if mBotEvilSide({_b}) is true:
						# 마피아 팀: 팀원을 고발한 사람은 위협, 시민이 고발당하면 맞장구
						if {_kind} is "mafia":
							if {-m::team::%{_t}%} is "mafia":
								mBotAddSus({_b}, {_s}, 60)
							else if chance of 15%:
								if {_ag} is false:
									set {_ag} to true
									mBotQueue({_b}, "agree|%{_t}%", random integer between 3 and 8)
					else if mBotK({_b}, {_s}) is "mafia":
						# 아는 마피아의 말은 거꾸로 받아들인다
						if {_kind} is "mafia":
							mBotAddSus({_b}, {_t}, -20)
					else if {_t} is {_b}:
						# 나를 고발했는데 나는 마피아가 아니다 = 말한 사람이 수상
						if {_kind} is "mafia":
							mBotAddSus({_b}, {_s}, 70)
					else:
						set {_kt} to mBotK({_b}, {_t})
						if {_kind} is "mafia":
							if {_kt} is "town":
								mBotAddSus({_b}, {_s}, 60)
							else:
								# 경찰이라고 밝힌 사람의 고발은 더 믿는다
								set {_w} to 30
								if {-mt::claim::%{_s}%} is "police":
									set {_w} to 55
								mBotAddSus({_b}, {_t}, {_w})
								if mBotSus({_b}, {_t}) >= 60:
									if chance of 20%:
										if {_ag} is false:
											set {_ag} to true
											mBotQueue({_b}, "agree|%{_t}%", random integer between 3 and 8)
						else:
							if {_kt} is "mafia":
								mBotAddSus({_b}, {_s}, 60)
							else:
								mBotAddSus({_b}, {_t}, -25)
					# 고발당한 봇은 해명한다
					if {_t} is {_b}:
						if {_kind} is "mafia":
							if mState() is "day" or "vote":
								set {-mt::defend::%{_b}%} to {_s}

# 말 한 줄에서 직업 주장과 참가자(번호 또는 닉네임)·고발/변호를 찾는다
function mBotHear(s: text, msg: text):
	# 색 코드는 빼고 읽는다
	set {_m} to {_msg}.replaceAll("[&§][0-9a-fk-orA-FK-OR]", "")
	# 직업 주장: "저/제가 ... <직업>", "<직업>입니다/이에요" (예: "제가 경찰인데", "저 의사에요"). 남 이야기("주장", "둘", "사칭", "있으면")는 뺀다
	set {_self} to false
	if {_m} contains "저" or "제가" or "입니다" or "이에요" or "인데":
		set {_self} to true
	if {_m} contains "주장" or "둘" or "사칭" or "있으면" or "있어요?":
		set {_self} to false
	if {_self} is true:
		loop mRoleIds():
			if {_m} contains mRoleName(loop-value):
				if loop-value is not "mafia":
					mBotSetClaim({_s}, loop-value)
	set {_kind} to ""
	set {_nm} to {_m}.replaceAll(" ", "")
	# 부정("노마피아", "마피아 아님/아니", "마피아가 아닌") 은 변호
	if {_nm} contains "노마피아" or "마피아아님" or "마피아아니" or "마피아가아" or "마피아는아":
		set {_kind} to "town"
	else if {_m} contains "마피아":
		set {_kind} to "mafia"
	else if {_m} contains "시민" or "아니" or "믿으셔도":
		set {_kind} to "town"
	if {_kind} is "":
		stop
	set {_w::*} to split {_m} at " "
	loop {_w::*}:
		set {_x} to loop-value
		replace all "번" in {_x} with ""
		set {_no} to {_x} parsed as integer
		if {_no} is set:
			loop {-m::players::*}:
				if {-m::num::%loop-value-2%} is {_no}:
					add loop-value-2 to {_hit::*}
	# 닉네임은 낱말이 닉네임과 같을 때만(뒤에 붙은 "님" 은 뺀다. 봇1 과 봇10 을 헷갈리지 않게)
	loop {_w::*}:
		set {_x} to loop-value
		replace all "님" in {_x} with ""
		loop {-m::players::*}:
			if mNameOf(loop-value-2) is {_x}:
				if {_hit::*} does not contain loop-value-2:
					add loop-value-2 to {_hit::*}
	loop {_hit::*}:
		if loop-value is not {_s}:
			mBotClaim({_s}, loop-value, {_kind})

# 낮 동안 봇 한 명이 말할 차례가 되면
function mBotTalk(b: text):
	if {-m::alive::%{_b}%} is not true:
		stop
	set {_role} to mActRole({_b})
	# 아침 보고 차례(번호 순서)
	if {-mt::repdue::%{_b}%} is set:
		delete {-mt::repdue::%{_b}%}
		mBotReport({_b})
		stop
	# 직업 사칭을 당했으면(내가 진짜) 반박
	if {-mt::conflict::%{_b}%} is set:
		set {_o} to {-mt::conflict::%{_b}%}
		delete {-mt::conflict::%{_b}%}
		if {-m::alive::%{_o}%} is true:
			mBotSpeak({_b}, "real_vs_fake", {_o}, "", {_role})
			stop
	# 고발당했으면 해명
	if {-mt::defend::%{_b}%} is set:
		set {_s} to {-mt::defend::%{_b}%}
		delete {-mt::defend::%{_b}%}
		# 거짓 보고를 한 봇은 그 가짜 직업으로 해명한다(말이 엇갈리지 않게)
		set {_cr} to {_role}
		if {-mt::fakerole::%{_b}%} is set:
			set {_cr} to {-mt::fakerole::%{_b}%}
		else if mBotEvilSide({_b}) is true:
			if chance of 45%:
				mBotSetClaim({_b}, "police")
				mBotSpeak({_b}, "fake_police", {_s}, "", "")
				stop
		if {_cr} is "doctor" or "police" or "soldier" or "reporter" or "detective" or "politician" or "guardian" or "shaman" or "thug" or "terrorist" or "vigilante":
			if chance of 70%:
				mBotSetClaim({_b}, {_cr})
				mBotSpeak({_b}, "defend_role", {_s}, "", {_cr})
				stop
		mBotSpeak({_b}, "defend", {_s}, "", "")
		stop
	# 경찰: 지난 밤 결과를 밝힌다(하루 한 번)
	if {_role} is "police":
		set {_t} to {-m::act::%{_b}%}
		if {_t} is set:
			if {-mt::told::%{_b}%::%{-m::day}%} is not set:
				set {-mt::told::%{_b}%::%{-m::day}%} to true
				if mBotK({_b}, {_t}) is "mafia":
					mBotSetClaim({_b}, "police")
					mBotSpeak({_b}, "police_mafia", {_t}, "", "")
					stop
				if chance of 50%:
					mBotSetClaim({_b}, "police")
					mBotSpeak({_b}, "police_town", {_t}, "", "")
					stop
	# 마피아 팀: 가끔 시민을 몰아간다
	if mBotEvilSide({_b}) is true:
		if chance of 40%:
			loop {-m::players::*}:
				if {-m::alive::%loop-value%} is true:
					if {-m::team::%loop-value%} is not "mafia":
						add loop-value to {_town::*}
			if size of {_town::*} > 0:
				set {_t} to mBotBest({_b}, {_town::*}, "threat")
				if {_t} is not "":
					mBotSpeak({_b}, "mafia_push", {_t}, "", "")
					stop
		if chance of 30%:
			mBotSpeak({_b}, "idle", "", "", "")
		stop
	# 광대: 일부러 수상하게
	if {_role} is "jester":
		if chance of 50%:
			mBotSpeak({_b}, "jester", "", "", "")
		stop
	# 그 밖: 가장 의심 가는 사람을 말하거나, 할 말이 없으면 가볍게
	set {_best} to ""
	set {_bs} to 30
	loop {-m::players::*}:
		if loop-value is not {_b}:
			if {-m::alive::%loop-value%} is true:
				if mBotSus({_b}, loop-value) > {_bs}:
					set {_bs} to mBotSus({_b}, loop-value)
					set {_best} to loop-value
	if {_best} is not "":
		if chance of 60%:
			mBotSpeak({_b}, "accuse", {_best}, "", mBotWhy({_b}, {_best}))
			stop
	if chance of 30%:
		mBotSpeak({_b}, "idle", "", "", "")


# ------------------------------------------------------------------ 봇 말하기: AI(LLM) 연결
# 행동(밤 능력, 투표)은 위의 규칙이 정하고, 말은 AI 가 만든다. OpenAI 호환 채팅 API(POST .../v1/chat/completions)면 어느 서비스든 된다
#   (예: Groq, OpenRouter 무료 모델, Google Gemini 의 OpenAI 호환 주소, 내 PC 의 Ollama http://localhost:11434/v1/chat/completions).
# 설정(관리자): /mtest llm url <주소> | key <키> | model <모델> | on | off | status | test
#   {mcfg::llm::url} {mcfg::llm::key} {mcfg::llm::model} {mcfg::llm::on}. 키는 서버 변수 파일에 그대로 저장되고, 화면에는 보여 주지 않는다.
# 흐름: mBotSpeak(봇, 의도, 대상...) → AI 가 켜져 있으면 요청을 비동기로 보내고(게임이 멈추지 않음) 1초마다 답이 왔는지 본다 → 한 줄로 다듬어 mBotSay.
#   AI 가 꺼져 있거나, 12초 안에 답이 없거나, 실패하면 정해 둔 문장(mBotLine)으로 말한다.
# 보내는 것: 봇의 진짜 직업·팀(마피아 팀이면 팀원), 아는 것, 의심 순위, 주장한 직업, 살아 있는 사람 번호, 최근 공개 채팅 12줄, 이번에 할 말의 의도.
#   (다른 사람에게 알려지면 안 되는 정보는 그 봇 자신의 것만 넣는다. 사람 플레이어의 채팅도 최근 공개 채팅으로 함께 보내진다.)
# 변수: {-mtllm::f::봇}(답을 기다리는 요청) {-mtllm::fb::봇}(실패하면 대신 할 말) {-mtllm::t::봇}(보낸 초) {-mtllm::err}(마지막 오류, status 에 표시)

# 답을 기다리는 최대 초({mcfg::llm::wait}, 기본 25). 생각하는 모델은 시간이 걸린다
function mBotLlmWait() :: number:
	if {mcfg::llm::wait} is set:
		return {mcfg::llm::wait}
	return 25

# HTTP/1.1, 접속 8초 제한(HTTP/2 협상에서 멈추는 환경을 피한다)
function mBotLlmClient() :: object:
	return HttpClient.newBuilder().version(HttpVer.HTTP_1_1).connectTimeout(Duration.ofSeconds(8)).build()

function mBotLlmOn() :: boolean:
	if {mcfg::llm::on} is not true:
		return false
	if {mcfg::llm::url} is not set:
		return false
	if {mcfg::llm::model} is not set:
		return false
	return true

# 의도 → AI 에게 줄 지시
function mBotIntent(kind: text, t: text, u: text, r: text) :: text:
	if {_kind} is "reply":
		return "%mNum({_t})%번 %mNameOf({_t})% 이(가) 너에게 이렇게 말했다: ""%{_r}%"". 네 입장(직업·팀·아는 것)에 맞게 자연스럽게 대답해라. 질문이면 답하고, 의심받으면 해명해라."
	if {_kind} is "report":
		return "아침 보고 차례다. 모두에게 네 직업과 지난밤 한 일을 밝힌다. 밝힐 내용: ""%mBotPlain({_r})%"". 직업, 사람 번호, 결과를 바꾸거나 빼지 말고 네 말투로 자연스럽게 한 문장으로 말해라."
	if {_kind} is "contra":
		return "%mNum({_t})%번 %mNameOf({_t})% 의 말에 모순을 찾았다: %mBotPlain({_r})%. 이 점을 짚고 %mNum({_t})%번에게 해명을 요구해라."
	set {_tn} to ""
	set {_un} to ""
	set {_rn} to ""
	if {_t} is not "":
		set {_tn} to "%mNum({_t})%번 %mNameOf({_t})%"
	if {_u} is not "":
		set {_un} to "%mNum({_u})%번 %mNameOf({_u})%"
	if {_r} is not "":
		set {_rn} to mRoleName({_r})
	if {_kind} is "police_mafia":
		return "너는 경찰이다. 어젯밤 조사해 보니 %{_tn}% 이(가) 마피아였다고 모두에게 밝혀라."
	if {_kind} is "police_town":
		return "너는 경찰이다. 어젯밤 조사한 %{_tn}% 은(는) 마피아가 아니었다고 밝혀라."
	if {_kind} is "accuse":
		if {_r} is not "":
			return "너는 %{_tn}% 을(를) 마피아로 의심한다. 근거(사실): %{_r}% 이 근거를 들어 %{_tn}% 을(를) 투표하자고 말해라. 근거에 없는 일을 지어내지 마라."
		return "너는 %{_tn}% 을(를) 조금 의심하지만 뚜렷한 근거는 없다. 근거를 지어내지 말고, 대화에 나온 말(직업 주장, 보고 내용)을 따져 보며 가볍게 의견을 말해라. 이미 나온 말을 되풀이하지 마라."
	if {_kind} is "mafia_push":
		return "너는 마피아 팀이다(절대 밝히지 마라). 대화 흐름에 맞춰, 시민인 %{_tn}% 에게 그럴듯한 근거로 의심을 돌려라. 너무 티 나게 몰지 말고, 이미 의심받는 사람이 있으면 거기에 슬쩍 얹어도 된다."
	if {_kind} is "defend_role":
		return "%{_tn}% 이(가) 너를 마피아로 몰았다. 네 직업 %{_rn}% 을(를) 밝히며 해명해라."
	if {_kind} is "defend":
		return "%{_tn}% 이(가) 너를 마피아로 몰았다. 억울함을 말하고 해명해라."
	if {_kind} is "fake_police":
		return "너는 마피아 팀이다(절대 밝히지 마라). %{_tn}% 이(가) 너를 몰았다. 네가 경찰인 척하며 오히려 %{_tn}% 이(가) 마피아라고 주장해라."
	if {_kind} is "agree":
		return "누군가 %{_tn}% 을(를) 의심했다. 대화를 보고 동의하면 근거를 덧붙이고, 동의하지 않으면 다른 생각을 말해라."
	if {_kind} is "conflict":
		return "%{_tn}% 와(과) %{_un}% 가 둘 다 %{_rn}% 이라고 주장했다. 둘 중 하나는 거짓말이라고 짚어라."
	if {_kind} is "real_vs_fake":
		return "너는 진짜 %{_rn}% 이다. %{_tn}% 이(가) %{_rn}% 을(를) 사칭하고 있다고 반박해라."
	if {_kind} is "jester":
		return "너는 광대다(밝히지 마라). 투표로 처형당해야 이긴다. 일부러 살짝 수상하게, 장난스럽게 말해라."
	if {_kind} is "vote":
		return "방금 %{_tn}% 에게 투표했다고 짧게 말해라."
	return "대화 흐름을 보고 지금 가장 자연스러운 한마디를 해라(질문에 답하기, 다른 사람 말에 반응하기, 직업을 밝힌 사람이 있으면 그 말을 따져 보기 등). 이미 나온 말을 되풀이하지 마라."

# AI 요청 글의 순서(확정): 고정 규칙(시스템) → 모두에게 공개된 기록(mBotHistory) → 그 봇만의 정보(mBotSelf) → 할 일.
#   앞부분이 매번 똑같아서 Ollama 같은 내 PC 모델이 앞 요청에서 읽은 부분을 다시 읽지 않고 재사용한다(빨라짐). 고정 규칙에는 변수를 넣지 않는다.
function mBotStatic() :: text:
	set {_c} to "너는 한국어 채팅으로 하는 마인크래프트 마피아 게임의 참가자 한 명을 연기한다."
	set {_c} to "%{_c}% 규칙: 밤에 마피아가 한 명을 죽이고, 낮에 토론한 뒤 투표로 한 명을 처형한다. 경찰은 밤마다 한 명이 마피아인지 조사하고, 의사는 한 명을 살린다. 마피아 팀(마피아와 접선한 보조 직업)은 표가 시민 팀 이상이면 이기고, 시민 팀은 마피아 팀이 모두 죽으면 이긴다."
	set {_c} to "%{_c}% 대화를 읽는 법: 대화 전체를 이어서 이해해라. '노마피아', '마피아 아님' 은 그 사람을 변호하는 말이다. 경찰이라고 밝힌 사람의 결과 발표는 무겁게 보되, 경찰 주장이 둘이면 둘 중 하나는 거짓이다. 말이 바뀌거나 근거 없이 몰아가는 사람을 의심해라."
	set {_c} to "%{_c}% 시민 팀이면 근거를 따져 마피아를 찾고, 믿을 만한 경찰 결과를 따르고, 억울하게 몰리는 사람은 변호한다. 마피아 팀이면 절대 정체를 밝히지 말고 시민처럼 추리하는 척하며, 팀원이 의심받으면 티 나지 않게 화제를 돌리고, 진짜 경찰로 보이는 사람의 신뢰를 깎는다."
	set {_c} to "%{_c}% 말을 할 때: 실제 사람처럼 짧은 한국어 채팅 한 문장(40자 이내)만 쓴다. 따옴표, 이름표, 괄호 지문(목소리·행동 묘사), 여러 후보, 설명, 이모지 없이 실제로 칠 말만. 사람을 가리킬 때는 번호와 이름을 쓴다(예: 3번 Alex). 게임 밖 이야기는 하지 않는다."
	set {_c} to "%{_c}% 할 일에 JSON 으로 답하라고 하면 다른 글 없이 JSON 하나만 출력한다."
	return {_c}

# 그 봇만의 정보(이름, 진짜 직업과 팀, 같은 팀, 주장한 직업, 개인 기록, 아는 것, 살아 있는 사람)
function mBotSelf(b: text) :: text:
	set {_shown} to mActRole({_b})
	set {_c} to "너는 %mNum({_b})%번 %mNameOf({_b})% 이다. 지금은 %{-m::day}%일차다. 네 진짜 직업은 %mRoleName({_shown})% 이다."
	if mBotEvilSide({_b}) is true:
		loop {-m::players::*}:
			if loop-value is not {_b}:
				if {-m::team::%loop-value%} is "mafia":
					add "%mNum(loop-value)%번 %mNameOf(loop-value)%(%mRoleName({-m::role::%loop-value%})%)" to {_mates::*}
		set {_c} to "%{_c}% 너는 마피아 팀이다."
		if size of {_mates::*} > 0:
			set {_c} to "%{_c}% 같은 팀: %{_mates::*}%."
	else if {-m::role::%{_b}%} is "jester":
		set {_c} to "%{_c}% 너는 광대다. 투표로 처형당해야 이긴다(정체는 숨겨라)."
	if {-mt::fakerole::%{_b}%} is set:
		set {_c} to "%{_c}% 너는 진짜 직업을 숨기고 %mRoleName({-mt::fakerole::%{_b}%})% 인 척하고 있다(거짓 보고). 들키지 않게 그 직업답게 말하고 진짜 직업은 절대 밝히지 마라."
	else if {-mt::claim::%{_b}%} is set:
		set {_c} to "%{_c}% 너는 사람들에게 %mRoleName({-mt::claim::%{_b}%})% 이라고 말해 두었다. 말이 엇갈리지 않게."
	set {_pm} to mBotPMemText({_b})
	if {_pm} is not "":
		set {_c} to "%{_c}% 너만 아는 기록: %{_pm}%"
	loop {-m::players::*}:
		set {_t} to loop-value
		if {_t} is not {_b}:
			set {_k} to mBotK({_b}, {_t})
			if {_k} is "mafia":
				add "%mNum({_t})%번 마피아 확인" to {_kn::*}
			else if {_k} is "town":
				add "%mNum({_t})%번 시민 확인" to {_kn::*}
			if {-m::alive::%{_t}%} is true:
				add "%mNum({_t})%번 %mNameOf({_t})%" to {_al::*}
	if size of {_kn::*} > 0:
		set {_c} to "%{_c}% 네가 아는 것: %{_kn::*}%."
	set {_c} to "%{_c}% 살아 있는 다른 사람: %{_al::*}%."
	return {_c}

# 요청의 사용자 글: 공개 기록 → (봇이면) 그 봇의 정보 → 할 일
function mBotUser(b: text, task: text) :: text:
	set {_u} to mBotHistory()
	if {_b} is not "":
		set {_u} to "%{_u}%%nl%[너에 대한 정보]%nl%%mBotSelf({_b})%"
	return "%{_u}%%nl%[할 일]%nl%%{_task}%"

# 말하기 요청
function mBotLlmSend(b: text, intent: text) :: boolean:
	set {_f} to mBotLlmPost(mBotStatic(), mBotUser({_b}, "%{_intent}% 지금까지의 대화를 기억하고, 같은 말을 되풀이하지 말고, 앞뒤가 맞게 채팅 한 문장만 답해라."), 600)
	if {_f} is not set:
		return false
	set {-mtllm::f::%{_b}%} to {_f}
	set {-mtllm::t::%{_b}%} to {-mau::sec}
	return true

# 실패한 요청의 이유(예외 이름과 메시지, 원인까지). 콘솔에도 남긴다
function mBotLlmErr(f: object) :: text:
	set {_ex} to {_f}.exceptionNow()
	set {_t} to {_ex}.toString()
	set {_c} to {_ex}.getCause()
	if {_c} is set:
		set {_t} to "%{_t}% / 원인: %{_c}.toString()%"
	Bukkit.getConsoleSender().sendMessage("[mafia] AI 요청 실패: %{_t}%")
	if {_t}.length() > 220:
		set {_t} to {_t}.substring(0, 220)
	return {_t}

# 답 꺼내기: 첫 번째 답의 내용 한 줄(실패하면 "")
function mBotLlmText(body: text) :: text:
	set {_o} to JsonParser.parseString({_body}).getAsJsonObject()
	if {_o}.has("choices") is false:
		set {-mtllm::err} to "답에 choices 가 없음: %{_body}%"
		return ""
	set {_m} to {_o}.getAsJsonArray("choices").get(0).getAsJsonObject().getAsJsonObject("message")
	set {_s} to {_m}.get("content").getAsString()
	# 한 줄로, 색 코드·따옴표·이름표를 빼고 60자까지
	set {_s} to {_s}.replaceAll("[\r\n]+", " ").replaceAll("[&§]", "").trim()
	# 작은 모델의 버릇 정리: 괄호 지문 "(낮은 목소리로)" 빼기, 여러 후보면 첫 번째만("또는" 뒤 버림), 따옴표 안의 말만
	set {_s} to {_s}.replaceAll("[(（][^)）]*[)）]", " ").replaceAll("\*[^*]*\*", " ").trim()
	set {_s} to {_s}.replaceAll("\s+또는\s.*$", "").trim()
	if {_s}.matches(".*[""“][^""“”]+[""”].*") is true:
		set {_s} to {_s}.replaceAll("^[^""“]*[""“]([^""“”]+)[""”].*$", "$1").trim()
	set {_s} to {_s}.replaceAll("^[""'“”]+|[""'“”]+$", "")
	set {_s} to {_s}.replaceAll("^<[^>]*>\s*", "")
	set {_s} to {_s}.replaceAll("^\d+번\s*[^:：]{1,12}[:：]\s*", "")
	set {_s} to {_s}.replaceAll("\s{2,}", " ").trim()
	if {_s}.length() > 60:
		set {_s} to {_s}.substring(0, 60)
	return {_s}

# 말하기: AI 가 켜져 있으면 요청, 아니면(또는 이미 기다리는 중이면) 정해 둔 문장
# 의도의 효과: 고발/변호
function mBotIntentEffect(b: text, kind: text, t: text):
	if {_t} is "":
		stop
	# 분명한 주장(경찰 결과 발표, 거짓 경찰 주장, 사칭 반박)은 AI 가 켜져 있어도 늘 반영한다(작은 모델이 해석을 틀려도 핵심은 전달되게)
	if {_kind} is "police_mafia" or "fake_police" or "real_vs_fake":
		mBotClaim({_b}, {_t}, "mafia")
		stop
	if {_kind} is "police_town":
		mBotClaim({_b}, {_t}, "town")
		stop
	# 의심 말하기(봇 말은 AI 로 다시 읽지 않으니 늘 의도로 반영)
	if {_kind} is "accuse" or "mafia_push" or "defend":
		mBotClaim({_b}, {_t}, "mafia")

function mBotSpeak(b: text, kind: text, t: text, u: text, r: text):
	if {-m::alive::%{_b}%} is not true:
		stop
	# 봇이 한 말의 뜻은 글을 다시 읽지 않고 의도로 바로 반영한다(오해가 번지지 않게)
	mBotIntentEffect({_b}, {_kind}, {_t})
	set {_fb} to mBotFill(mBotLine({_kind}), {_t}, {_u}, {_r})
	# 아침 보고·모순 지적·투표 알림은 내용이 정해져 있으니 AI 를 거치지 않고 바로 말한다(빠르고, 내용이 바뀌지 않게)
	if {_kind} is "report" or "contra" or "vote":
		mBotSay({_b}, {_fb})
		stop
	if mBotLlmOn() is true:
		# 이미 이 봇의 말을 만드는 중이면 새 말은 버린다(정해 둔 문장이 끼어들어 두 번 말하지 않게)
		if {-mtllm::f::%{_b}%} is set:
			stop
		if {-mtllm::q::*} contains {_b}:
			stop
		if {-mtllm::f::%{_b}%} is not set:
			if {-mtllm::q::*} does not contain {_b}:
				set {-mtllm::fb::%{_b}%} to {_fb}
				# 동시에 보낼 수 있는 수(기본 1)를 넘으면 줄을 세운다(저사양 Ollama 가 한 번에 하나씩 처리해 시간 초과가 나지 않게)
				if mBotLlmInflight() < mBotLlmPar():
					mBotLlmSend({_b}, mBotIntent({_kind}, {_t}, {_u}, {_r}))
				else:
					set {-mtllm::qd::%{_b}%} to "%{_kind}%|%{_t}%|%{_u}%|%{_r}%"
					set {-mtllm::qs::%{_b}%} to {-mau::sec}
					add {_b} to {-mtllm::q::*}
			stop
	if {_fb} is not "":
		mBotSay({_b}, {_fb})


# AI 결정(밤 능력·투표) 켜짐 여부({mcfg::llm::decide}, 기본 꺼짐: 작은 모델은 규칙보다 결정을 못할 때가 많다)
function mBotDecideOn() :: boolean:
	if mBotLlmOn() is false:
		return false
	if {mcfg::llm::decide} is true:
		return true
	return false

# 디버그 기록(/mtest llm debug on): 봇이 한 말, AI 결정, 말 해석 결과를 콘솔에 남긴다
function mBotDbg(s: text):
	if {mcfg::llm::debug} is true:
		Bukkit.getConsoleSender().sendMessage("[mafia-ai] %{_s}%")
# 동시에 보낼 요청 수({mcfg::llm::par}, 기본 1)와 지금 보낸 수
function mBotLlmPar() :: number:
	if {mcfg::llm::par} is set:
		return {mcfg::llm::par}
	return 1

function mBotLlmInflight() :: number:
	set {_n} to size of {-mtllm::f::*}
	add size of {-mtllm::df::*} to {_n}
	add size of {-mtllm::pf::*} to {_n}
	if {-mtllm::sf} is set:
		add 1 to {_n}
	return {_n}

# 1초마다: 자리가 나면 줄 선 요청을 보낸다(말하기 → 말 뜻 읽기 → 하루 요약 순). 너무 오래 기다린 말하기는 정해 둔 문장으로 바로 말한다
function mBotLlmDispatch():
	set {_k} to 0
	while {_k} < 4:
		add 1 to {_k}
		if mBotLlmInflight() >= mBotLlmPar():
			stop
		# 결정(밤 능력·투표)이 가장 먼저(시간 제한이 있음)
		if size of {-mtllm::dq::*} > 0:
			set {_db} to first element of {-mtllm::dq::*}
			remove {_db} from {-mtllm::dq::*}
			set {_dm} to {-mtllm::dqm::%{_db}%}
			delete {-mtllm::dqm::%{_db}%}
			if {-m::alive::%{_db}%} is true:
				if {_dm} is mState():
					mBotDecideNow({_db}, {_dm})
		else if size of {-mtllm::pq::*} > 0:
			# 사람 말 읽기가 봇 말하기보다 먼저(사람 말을 놓치지 않게)
			set {_e} to first element of {-mtllm::pq::*}
			remove {_e} from {-mtllm::pq::*}
			set {_pe::*} to split {_e} at "|"
			if mState() is "day" or "vote":
				mBotLlmParseNow({_pe::1}, {_pe::2})
		else if size of {-mtllm::q::*} > 0:
			set {_b} to first element of {-mtllm::q::*}
			remove {_b} from {-mtllm::q::*}
			set {_f::*} to split {-mtllm::qd::%{_b}%} at "|"
			set {_age} to {-mau::sec} - {-mtllm::qs::%{_b}%}
			delete {-mtllm::qd::%{_b}%}
			delete {-mtllm::qs::%{_b}%}
			if {-m::alive::%{_b}%} is true:
				if mState() is "day" or "vote":
					if {_age} > 12:
						mBotDbg("%mNum({_b})%번 말하기가 줄에서 %{_age}%초 기다려 정해 둔 문장으로 대신함")
						set {_fb} to {-mtllm::fb::%{_b}%}
						delete {-mtllm::fb::%{_b}%}
						if {_fb} is set:
							mBotSay({_b}, {_fb})
					else:
						mBotLlmSend({_b}, mBotIntent({_f::1}, {_f::2} ? "", {_f::3} ? "", {_f::4} ? ""))
		else if {-mtllm::sumwant} is set:
			set {_d} to {-mtllm::sumwant}
			delete {-mtllm::sumwant}
			mBotSummarize({_d})
		else:
			stop

every second:
	if mBotLlmOn() is true:
		mBotLlmDispatch()

# 1초마다: 답이 온 요청을 꺼내 말한다
function mBotLlmPoll():
	loop indices of {-mtllm::f::*}:
		set {_b} to loop-value
		set {_f} to {-mtllm::f::%{_b}%}
		set {_say} to ""
		set {_done} to false
		if {_f}.isDone() is true:
			set {_done} to true
			if {_f}.isCompletedExceptionally() is true:
				set {-mtllm::err} to "요청 실패: %mBotLlmErr({_f})%"
			else:
				set {_res} to {_f}.get()
				if {_res}.statusCode() is 200:
					set {_say} to mBotLlmText({_res}.body())
				else:
					set {-mtllm::err} to "HTTP %{_res}.statusCode()%: %{_res}.body()%"
		else if {-mau::sec} - {-mtllm::t::%{_b}%} > mBotLlmWait() + 1:
			set {_done} to true
			{_f}.cancel(true)
			set {-mtllm::err} to "%mBotLlmWait()%초 안에 답이 없음"
		if {_done} is true:
			set {_fb} to {-mtllm::fb::%{_b}%}
			delete {-mtllm::f::%{_b}%}
			delete {-mtllm::fb::%{_b}%}
			delete {-mtllm::t::%{_b}%}
			if mState() is "day" or "vote":
				if {_say} is not "":
					mBotSay({_b}, {_say})
				else if {_fb} is set:
					set {_er} to "-"
					if {-mtllm::err} is set:
						set {_er} to {-mtllm::err}
					mBotDbg("%mNum({_b})%번 AI 답이 없거나 실패해 정해 둔 문장으로 대신함 (%{_er}%)")
					if {_fb} is not "":
						mBotSay({_b}, {_fb})

every second:
	if size of {-mtllm::f::*} > 0:
		mBotLlmPoll()

# 설정 시험: 짧은 요청 하나를 보내 답을 보여 준다
function mBotLlmTest(p: player):
	set {_root} to new JsonObject()
	{_root}.addProperty("model", {mcfg::llm::model})
	{_root}.addProperty("max_tokens", 600)
	if {mcfg::llm::effort} is set:
		{_root}.addProperty("reasoning_effort", {mcfg::llm::effort})
	set {_msgs} to new JsonArray()
	set {_usr} to new JsonObject()
	{_usr}.addProperty("role", "user")
	{_usr}.addProperty("content", "마피아 게임 참가자처럼 한국어로 짧게 인사해 줘.")
	{_msgs}.add({_usr})
	{_root}.add("messages", {_msgs})
	set {_rb} to HttpRequest.newBuilder(URI.create({mcfg::llm::url}))
	{_rb}.timeout(Duration.ofSeconds(mBotLlmWait()))
	{_rb}.header("Content-Type", "application/json")
	if {mcfg::llm::key} is set:
		{_rb}.header("Authorization", "Bearer %{mcfg::llm::key}%")
	{_rb}.POST(HBodyPub.ofString({_root}.toString()))
	if {-mtllm::client} is not set:
		set {-mtllm::client} to mBotLlmClient()
	set {_f} to {-mtllm::client}.sendAsync({_rb}.build(), HBodyHand.ofString())
	send "&7AI 시험 요청을 보냈습니다. 답을 기다리는 중..." to {_p}
	set {_w} to 0
	while {_f}.isDone() is false:
		wait 10 ticks
		add 1 to {_w}
		if {_w} > mBotLlmWait() * 2 + 2:
			{_f}.cancel(true)
			send "&c%mBotLlmWait()%초 안에 답이 없습니다. 생각이 긴 모델이면 /mtest llm effort none 또는 더 가벼운 모델(예: gemini-flash-lite-latest)을 써 보세요." to {_p}
			stop
	if {_f}.isCompletedExceptionally() is true:
		set {_why} to mBotLlmErr({_f})
		send "&c요청 실패: &7%{_why}%" to {_p}
		set {_us} to {mcfg::llm::url}
		send "&7보낸 주소: &f[%{_us}%] &8(대괄호 안에 공백이나 꺾쇠가 없어야 합니다)" to {_p}
		stop
	set {_res} to {_f}.get()
	if {_res}.statusCode() is not 200:
		set {_bd} to {_res}.body()
		if {_bd}.length() > 200:
			set {_bd} to {_bd}.substring(0, 200)
		send "&cHTTP %{_res}.statusCode()%: &7%{_bd}%" to {_p}
		Bukkit.getConsoleSender().sendMessage("[mafia] AI 시험 HTTP %{_res}.statusCode()%: %{_bd}%")
		stop
	set {_ans} to mBotLlmText({_res}.body())
	send "&a답: &f%{_ans}%" to {_p}
	Bukkit.getConsoleSender().sendMessage("[mafia] AI 시험 성공(%{_w} / 2%초 안): %{_ans}%")
	if {_ans} is "":
		send "&e답이 비어 있습니다. 생각에 토큰을 다 쓴 것일 수 있어요. /mtest llm effort none(또는 low)을 써 보세요." to {_p}


# ------------------------------------------------------------------ 봇 기억과 대화 이해
# 대화 기억 {-mt::chat::*}: "[N일차] 3번 민준: 말" (사람과 봇의 생존자 대화, 게임 내내). 사건 기억은 기록({-m::log::*})의 전체 알림.
# 개인 기억 {-mt::pmem::봇::*}: 그 봇만 아는 것(조사 결과 등, 날짜와 함께).
# AI 가 켜져 있으면 사람의 말 한 줄마다 뜻을 읽는다(mBotLlmParse): 누구를 고발/변호했는지, 자기 직업 주장, 누구에게 말을 걸었는지 → 봇들이 받아들이고, 불린 봇은 대답한다.
# AI 가 꺼져 있어도: 말에 봇의 번호("3번")나 이름이 있으면 그 봇이 정해 둔 문장으로 대답한다(mBotAddressed).

function mBotChatAdd(s: text, msg: text):
	set {_m} to {_msg}.replaceAll("[&§][0-9a-fk-orA-FK-OR]", "")
	add "[%{-m::day}%일차] %mNum({_s})%번 %mNameOf({_s})%: %{_m}%" to {-mt::chat::*}

function mBotPMem(b: text, line: text):
	add "[%{-m::day}%일차] %{_line}%" to {-mt::pmem::%{_b}%::*}

# 기억을 AI 에게 줄 글로: 사건(전체 알림) 최근 40줄 + 대화 최근 40줄
# 기억을 AI 에게 줄 글로: 지난 날들의 요약(mBotSummarize) + 최근 사건 40줄 + 대화(요약이 없는 날과 오늘, 최근 40줄)
function mBotHistory() :: text:
	set {_sum} to ""
	set {_d} to 1
	while {_d} < {-m::day}:
		if {-mt::sum::%{_d}%} is set:
			set {_sum} to "%{_sum}%[%{_d}%일차 요약] %{-mt::sum::%{_d}%}%%nl%"
		add 1 to {_d}
	set {_n} to size of {-m::log::*}
	set {_from} to {_n} - 39
	set {_i} to 0
	set {_ev} to ""
	loop {-m::log::*}:
		add 1 to {_i}
		if {_i} >= {_from}:
			set {_e::*} to split loop-value at "|"
			if {_e::1} is "*":
				set {_l} to loop-value
				replace first "*|" in {_l} with ""
				replace first "|" in {_l} with " "
				set {_l} to {_l}.replaceAll("[&§][0-9a-fk-orA-FK-OR]", "")
				# 봇이 한 말은 대화 기억에 따로 있으니 뺀다
				if {_l} does not contain "<":
					set {_ev} to "%{_ev}%%{_l}%%nl%"
	# 대화: 요약이 있는 날은 빼고(요약으로 대신), 최근 40줄
	loop {-mt::chat::*}:
		set {_l} to loop-value
		set {_ld} to {_l}.replaceAll("^\[(\d+)일차\].*$", "$1")
		if {-mt::sum::%{_ld}%} is not set:
			add {_l} to {_keep::*}
	set {_n} to size of {_keep::*}
	set {_from} to {_n} - 39
	set {_i} to 0
	set {_ch} to ""
	loop {_keep::*}:
		add 1 to {_i}
		if {_i} >= {_from}:
			set {_ch} to "%{_ch}%%loop-value%%nl%"
	return "[지난 날 요약]%nl%%{_sum}%%nl%[최근 일어난 일]%nl%%{_ev}%%nl%[대화]%nl%%{_ch}%"

# d 일차에 공개된 일(기록)과 대화를 글로
function mBotDayText(d: number) :: text:
	set {_t} to ""
	loop {-m::log::*}:
		set {_e::*} to split loop-value at "|"
		if {_e::1} is "*":
			if {_e::2} contains "[%{_d}%일차":
				set {_l} to {_e::3}
				set {_l} to {_l}.replaceAll("[&§][0-9a-fk-orA-FK-OR]", "")
				if {_l} does not contain "<":
					set {_t} to "%{_t}%%{_l}%%nl%"
	loop {-mt::chat::*}:
		if loop-value starts with "[%{_d}%일차]":
			set {_t} to "%{_t}%%loop-value%%nl%"
	return {_t}

# 하루가 끝나면(다음 밤이 시작될 때) 그날을 AI 로 요약해 둔다(공개된 사실만, 모든 봇이 같이 쓴다). 하루 한 번 요청
function mBotSummarize(d: number):
	if mBotLlmOn() is false:
		stop
	if {_d} < 1:
		stop
	if {-mt::sum::%{_d}%} is set:
		stop
	if {-mtllm::sf} is set:
		stop
	# 다른 요청이 처리 중이면 나중에(mBotLlmDispatch)
	if mBotLlmInflight() >= mBotLlmPar():
		set {-mtllm::sumwant} to {_d}
		stop
	set {_txt} to mBotDayText({_d})
	if {_txt} is "":
		stop
	set {_ps} to ""
	loop {-m::players::*}:
		set {_ps} to "%{_ps}%%mNum(loop-value)%번 %mNameOf(loop-value)%, "
	set {_sys} to "아래 하루 기록을 요약해라. 참가자: %{_ps}%. 공개된 사실만 6줄 이내로 써라. 사람은 '3번 이름'으로 쓴다. 빠뜨리지 말 것: 누가 어떤 직업을 주장했는지(경찰 결과 포함), 누가 누구를 의심하거나 변호했는지, 말이 바뀌거나 모순된 사람, 투표 결과와 처형, 밤 사망자, 공개된 직업. 추측이나 설명은 쓰지 마라."
	set {-mtllm::sf} to mBotLlmPost(mBotStatic(), mBotUser("", "%{_sys}%%nl%[요약할 %{_d}%일차 기록]%nl%%{_txt}%"), 900)
	set {-mtllm::sd} to {_d}
	set {-mtllm::st} to {-mau::sec}

function mBotSummaryPoll():
	set {_f} to {-mtllm::sf}
	set {_done} to false
	set {_txt} to ""
	if {_f}.isDone() is true:
		set {_done} to true
		if {_f}.isCompletedExceptionally() is false:
			set {_res} to {_f}.get()
			if {_res}.statusCode() is 200:
				set {_o} to JsonParser.parseString({_res}.body()).getAsJsonObject()
				if {_o}.has("choices") is true:
					set {_txt} to {_o}.getAsJsonArray("choices").get(0).getAsJsonObject().getAsJsonObject("message").get("content").getAsString()
	else if {-mau::sec} - {-mtllm::st} > mBotLlmWait() + 5:
		set {_done} to true
		{_f}.cancel(true)
	if {_done} is false:
		stop
	set {_d} to {-mtllm::sd}
	delete {-mtllm::sf}
	delete {-mtllm::sd}
	delete {-mtllm::st}
	if {_txt} is "":
		stop
	set {_txt} to {_txt}.replaceAll("[&§]", "").replaceAll("[\r\n]+", " / ").trim()
	if {_txt}.length() > 700:
		set {_txt} to {_txt}.substring(0, 700)
	set {-mt::sum::%{_d}%} to {_txt}
	Bukkit.getConsoleSender().sendMessage("[mafia] %{_d}%일차 요약: %{_txt}%")

every second:
	if {-mtllm::sf} is set:
		mBotSummaryPoll()

# 봇 b 의 개인 기억(글)
function mBotPMemText(b: text) :: text:
	set {_t} to ""
	loop {-mt::pmem::%{_b}%::*}:
		set {_t} to "%{_t}%%loop-value%%nl%"
	return {_t}

# 사람이 봇을 불렀는지(번호 "3번"/"3" 또는 이름) → 그 봇이 대답(조금 뒤)
function mBotAddressed(s: text, msg: text):
	set {_w::*} to split {_msg} at " "
	loop {-m::players::*}:
		set {_b} to loop-value
		if mIsBot({_b}) is true:
			if {-m::alive::%{_b}%} is true:
				set {_hit} to false
				loop {_w::*}:
					set {_x} to loop-value-2
					replace all "님" in {_x} with ""
					replace all "번" in {_x} with ""
					replace all "," in {_x} with ""
					replace all "?" in {_x} with ""
					if {_x} is mNameOf({_b}):
						set {_hit} to true
					if {_x} is mNum({_b}):
						set {_hit} to true
				if {_hit} is true:
					mBotQueueReply({_b}, {_s}, {_msg})

function mBotQueueReply(b: text, s: text, msg: text):
	if {_b} is {_s}:
		stop
	set {_m} to {_msg}
	replace all "|" in {_m} with "/"
	mBotQueue({_b}, "reply|%{_s}%||%{_m}%", random integer between 2 and 4)

# 말 뜻 읽기: 자리가 없으면 줄을 세운다(최근 6개까지만, 오래된 것은 버림)
function mBotLlmParse(s: text, msg: text):
	if mBotLlmInflight() < mBotLlmPar():
		mBotLlmParseNow({_s}, {_msg})
		stop
	set {_m} to {_msg}
	replace all "|" in {_m} with "/"
	add "%{_s}%|%{_m}%" to {-mtllm::pq::*}
	if size of {-mtllm::pq::*} > 6:
		remove first element of {-mtllm::pq::*} from {-mtllm::pq::*}

# AI 로 사람 말의 뜻을 읽는다(비동기). 결과는 mBotLlmPoll 이 mBotApplyParse 로 넘긴다
function mBotLlmParseNow(s: text, msg: text):
	set {_ps} to ""
	loop {-m::players::*}:
		set {_ps} to "%{_ps}%%mNum(loop-value)%번 %mNameOf(loop-value)%, "
	set {_sys} to "채팅 한 줄의 뜻을 분석해라. 참가자: %{_ps}%. 말한 사람: %mNum({_s})%번 %mNameOf({_s})%. JSON 하나만 출력해라(설명 금지): {""accuse"":[번호],""clear"":[번호],""claim"":""직업"",""ask"":[번호],""night_target"":번호,""night_result"":""결과""}. accuse = 마피아로 의심하거나 지목한 사람, clear = 시민이라고 변호하거나 믿는다고 한 사람, claim = 말한 사람이 자기 직업이라고 밝힌 것(police, doctor, soldier, reporter, detective, politician, terrorist, thug, guardian, shaman, vigilante, madman, spy, madam, witch, thief, assassin, arsonist, jester 중 하나, 없으면 none), ask = 말한 사람이 질문하거나 말을 건 상대. 없으면 빈 배열. night_target = 말한 사람이 지난밤 자기 능력을 썼다고 밝힌 대상 번호(자기 자신도 됨, 밝히지 않았으면 0). night_result = 그 결과: 경찰 조사면 mafia 또는 town, 탐정이면 그 대상이 능력을 쓴 상대 번호(아무에게도 안 썼으면 none), 의사가 공격을 막았으면 saved, 그 밖에는 빈 문자열. 앞 대화를 보고 뜻을 정확히 읽어라: ""2 노마피아"", ""2번 마피아 아님"", ""2 시민 확인"" 은 2번 변호(clear)다. ""저 경찰인데"" 다음 줄의 ""3 마피아"" 는 경찰 조사 결과로 3번 고발(accuse)이다. 번호만 나왔다고 고발이 아니다. 확실하지 않으면 넣지 마라."
	# 공개 기록(대화 포함, 앞 요청과 같은 앞부분) 뒤에 분석할 말을 붙인다
	set {_f} to mBotLlmPost(mBotStatic(), mBotUser("", "%{_sys}%%nl%[분석할 말] %mNum({_s})%번 %mNameOf({_s})%: %{_msg}%%nl%JSON 하나만 답해라."), 300)
	if {_f} is not set:
		stop
	add 1 to {-mtllm::pn}
	set {_k} to "%{-mtllm::pn}%"
	set {-mtllm::pf::%{_k}%} to {_f}
	set {-mtllm::ps::%{_k}%} to {_s}
	set {-mtllm::pm::%{_k}%} to {_msg}
	set {-mtllm::pt::%{_k}%} to {-mau::sec}

# 공통 요청(시스템 지시, 사용자 글, 최대 토큰) → 비동기 결과
function mBotLlmPost(sys: text, usr: text, maxt: number) :: object:
	set {_root} to new JsonObject()
	{_root}.addProperty("model", {mcfg::llm::model})
	{_root}.addProperty("max_tokens", {_maxt})
	if {mcfg::llm::effort} is set:
		{_root}.addProperty("reasoning_effort", {mcfg::llm::effort})
	set {_msgs} to new JsonArray()
	set {_a} to new JsonObject()
	{_a}.addProperty("role", "system")
	{_a}.addProperty("content", {_sys})
	{_msgs}.add({_a})
	set {_c} to new JsonObject()
	{_c}.addProperty("role", "user")
	{_c}.addProperty("content", {_usr})
	{_msgs}.add({_c})
	{_root}.add("messages", {_msgs})
	set {_rb} to HttpRequest.newBuilder(URI.create({mcfg::llm::url}))
	{_rb}.timeout(Duration.ofSeconds(mBotLlmWait()))
	{_rb}.header("Content-Type", "application/json")
	if {mcfg::llm::key} is set:
		{_rb}.header("Authorization", "Bearer %{mcfg::llm::key}%")
	{_rb}.POST(HBodyPub.ofString({_root}.toString()))
	if {-mtllm::client} is not set:
		set {-mtllm::client} to mBotLlmClient()
	return {-mtllm::client}.sendAsync({_rb}.build(), HBodyHand.ofString())

# 뜻 읽기 결과 적용
function mBotApplyParse(s: text, msg: text, raw: text):
	mBotDbg("해석 %mNum({_s})%번 ""%{_msg}%"" → %{_raw}%")
	set {_a} to {_raw}.indexOf("{")
	set {_z} to {_raw}.lastIndexOf("}")
	if {_a} < 0:
		stop
	if {_z} <= {_a}:
		stop
	set {_j} to {_raw}.substring({_a}, {_z} + 1)
	set {_o} to JsonParser.parseString({_j}).getAsJsonObject()
	loop "accuse" and "clear":
		set {_key} to loop-value
		if {_o}.has({_key}) is true:
			set {_arr} to {_o}.getAsJsonArray({_key})
			set {_n} to {_arr}.size()
			set {_i} to 0
			while {_i} < {_n}:
				set {_no} to {_arr}.get({_i}).getAsInt()
				loop {-m::players::*}:
					if {-m::num::%loop-value-2%} is {_no}:
						if {_key} is "accuse":
							mBotClaim({_s}, loop-value-2, "mafia")
						else:
							mBotClaim({_s}, loop-value-2, "town")
				add 1 to {_i}
	if {_o}.has("claim") is true:
		set {_cr} to {_o}.get("claim").getAsString()
		if {_cr} is not "none":
			if mRoleExists({_cr}) is true:
				if {_cr} is not "mafia":
					mBotSetClaim({_s}, {_cr})
	# 지난밤 행적 보고(사람): 주장한 직업과 함께 기록해 모순 검사에 쓴다(하루 한 번)
	if {_o}.has("night_target") is true:
		if {_o}.get("night_target").isJsonPrimitive() is true:
			set {_nt} to {_o}.get("night_target").getAsInt()
			if {_nt} > 0:
				if {-mt::claim::%{_s}%} is set:
					if {-mt::rep::%{_s}%::%{-m::day}%} is not set:
						loop {-m::players::*}:
							if {-m::num::%loop-value%} is {_nt}:
								set {_ntu} to loop-value
						if {_ntu} is set:
							set {_nr} to "-"
							if {_o}.has("night_result") is true:
								set {_jr} to {_o}.get("night_result")
								if {_jr}.isJsonPrimitive() is true:
									set {_nr} to {_jr}.getAsString()
							set {_cl} to {-mt::claim::%{_s}%}
							set {_res} to "-"
							if {_cl} is "police":
								if {_nr} is "mafia" or "town":
									set {_res} to {_nr}
							else if {_cl} is "doctor":
								if {_nr} is "saved":
									set {_res} to "saved"
							else if {_cl} is "detective":
								set {_res} to "none"
								set {_yn} to {_nr} parsed as integer
								if {_yn} is set:
									loop {-m::players::*}:
										if {-m::num::%loop-value%} is {_yn}:
											set {_res} to "tgt:%loop-value%"
							mBotRepApply({_s}, "%{_cl}%|%{_ntu}%|%{_res}%", false)
	if {_o}.has("ask") is true:
		set {_arr} to {_o}.getAsJsonArray("ask")
		set {_n} to {_arr}.size()
		set {_i} to 0
		while {_i} < {_n}:
			set {_no} to {_arr}.get({_i}).getAsInt()
			loop {-m::players::*}:
				if {-m::num::%loop-value%} is {_no}:
					if mIsBot(loop-value) is true:
						if {-m::alive::%loop-value%} is true:
							# 봇이 봇을 부른 경우는 가끔만 대답(끝없이 주고받지 않게)
							if mIsBot({_s}) is false:
								mBotQueueReply(loop-value, {_s}, {_msg})
							else if chance of 40%:
								mBotQueueReply(loop-value, {_s}, {_msg})
			add 1 to {_i}

# 뜻 읽기 요청 확인(mBotLlmPoll 이 부른다)
function mBotParsePoll():
	loop indices of {-mtllm::pf::*}:
		set {_k} to loop-value
		set {_f} to {-mtllm::pf::%{_k}%}
		set {_done} to false
		set {_body} to ""
		if {_f}.isDone() is true:
			set {_done} to true
			if {_f}.isCompletedExceptionally() is false:
				set {_res} to {_f}.get()
				if {_res}.statusCode() is 200:
					set {_o} to JsonParser.parseString({_res}.body()).getAsJsonObject()
					if {_o}.has("choices") is true:
						set {_body} to {_o}.getAsJsonArray("choices").get(0).getAsJsonObject().getAsJsonObject("message").get("content").getAsString()
		else if {-mau::sec} - {-mtllm::pt::%{_k}%} > mBotLlmWait() + 1:
			set {_done} to true
			{_f}.cancel(true)
		if {_done} is true:
			set {_s} to {-mtllm::ps::%{_k}%}
			set {_m} to {-mtllm::pm::%{_k}%}
			delete {-mtllm::pf::%{_k}%}
			delete {-mtllm::ps::%{_k}%}
			delete {-mtllm::pm::%{_k}%}
			delete {-mtllm::pt::%{_k}%}
			if {_body} is not "":
				if mState() is "day" or "vote":
					mBotApplyParse({_s}, {_m}, {_body})

every second:
	if size of {-mtllm::pf::*} > 0:
		mBotParsePoll()


# ------------------------------------------------------------------ AI 결정: 밤 능력과 투표
# 밤·투표가 시작되면 봇마다 결정 요청을 줄 세운다(말하기보다 먼저 보낸다). 답이 오면 바로 능력을 쓰거나 투표한다.
# 답이 늦거나 이상하면 규칙(mTestNight/mTestVote)이 단계가 끝나기 직전에 대신 고른다. 마피아는 한 봇만 묻고 나머지는 같은 대상을 따른다.
# 변수: {-mtllm::dq::*}(줄 선 봇) {-mtllm::dqm::봇}(night/vote) {-mtllm::df::봇}(보낸 요청) {-mtllm::dm::봇} {-mtllm::dt::봇} {-mtllm::dph::봇}(단계) {-mt::dec::봇}(AI 가 정한 단계)

function mBotPhaseKey() :: text:
	return "%mState()%-%{-m::day}%"

# 직업별 고르는 요령
function mBotRoleHint(r: text, mode: text) :: text:
	if {_mode} is "vote":
		return "지금까지의 대화와 아는 것을 보고 처형할 사람을 고른다. 마피아 팀이면 팀원을 고르지 말고 시민(특히 위협이 되는 사람)을 고른다."
	if {_r} is "mafia":
		return "죽일 시민을 고른다. 경찰이나 의사로 보이는 사람, 너희를 의심하는 사람을 먼저 노린다. 의사가 지킬 만한 뻔한 대상은 피해도 좋다."
	if {_r} is "police":
		return "마피아인지 조사할 사람을 고른다. 아직 모르는 사람 중 수상한 사람을 고른다."
	if {_r} is "doctor":
		return "오늘 밤 마피아가 노릴 것 같은 사람을 살린다(자기 자신도 된다)."
	if {_r} is "spy" or "detective":
		return "조사할 사람을 고른다. 아직 모르는 사람 중 수상한 사람."
	if {_r} is "guardian":
		return "지킬 사람을 고른다(그 사람 대신 네가 죽을 수 있다). 중요한 직업을 밝힌 사람."
	if {_r} is "reporter":
		return "직업을 공개할 사람을 고른다(게임 중 한 번). 수상한 사람을 공개하면 좋다. 아직 아끼려면 0."
	if {_r} is "vigilante":
		return "죽일 사람을 고른다(게임 중 한 번, 시민을 죽이면 너도 죽는다). 확실할 때만 쓰고 아니면 0."
	if {_r} is "thief":
		return "죽이고 직업을 훔칠 사람을 고른다(게임 중 한 번). 쓸 만한 직업이 있을 것 같은 사람. 아끼려면 0."
	if {_r} is "assassin":
		return "죽일 사람을 고른다. 너 혼자 남아야 이긴다."
	if {_r} is "arsonist":
		return "기름을 뿌릴 사람을 고르거나, 기름 젖은 사람이 충분하면 -1 로 점화한다. 너 혼자 남아야 이긴다."
	if {_r} is "witch":
		return "저주할 사람을 고른다(다음 날 투표 때 말을 못 한다). 너희를 의심하는 사람."
	if {_r} is "thug":
		return "협박할 사람을 고른다(다음 날 투표를 못 한다). 수상한 사람."
	if {_r} is "shaman":
		return "주술을 걸 사람을 고른다(그 사람을 노린 능력 하나를 무효로 만든다)."
	return "능력을 쓸 대상을 고른다."

function mBotDecideQueue(b: text, mode: text):
	if mBotLlmOn() is false:
		stop
	if {-mtllm::dq::*} contains {_b}:
		stop
	if {-mtllm::df::%{_b}%} is set:
		stop
	# 마피아: 한 봇만 묻는다
	if {_mode} is "night":
		if mActRole({_b}) is "mafia":
			loop {-m::players::*}:
				if loop-value is not {_b}:
					if mActRole(loop-value) is "mafia":
						if {-mtllm::dq::*} contains loop-value:
							stop
						if {-mtllm::df::%loop-value%} is set:
							stop
	set {-mtllm::dqm::%{_b}%} to {_mode}
	add {_b} to {-mtllm::dq::*}

function mBotDecideNow(b: text, mode: text):
	if {_mode} is "night":
		set {_c::*} to mTargets({_b})
	else:
		if mVoteCan({_b}) is not "":
			stop
		loop {-m::players::*}:
			if loop-value is not {_b}:
				if {-m::alive::%loop-value%} is true:
					add loop-value to {_c::*}
	if size of {_c::*} is 0:
		stop
	set {_r} to mActRole({_b})
	# 규칙 계산 추천(참고용)
	set {_m} to "sus"
	if {_mode} is "night":
		if {_r} is "police" or "spy" or "detective":
			set {_m} to "unknown"
		else if {_r} is "doctor" or "guardian":
			set {_m} to "protect"
		else if {_r} is "mafia" or "assassin" or "thief" or "witch":
			set {_m} to "threat"
	else if mBotEvilSide({_b}) is true:
		set {_m} to "threat"
	set {_sug} to mBotBest({_b}, {_c::*}, {_m})
	set {_list} to ""
	loop {_c::*}:
		set {_t} to loop-value
		set {_x} to "%mNum({_t})%번 %mNameOf({_t})%"
		if {_t} is {_b}:
			set {_x} to "%{_x}%(너 자신)"
		set {_list} to "%{_list}%%{_x}%, "
	set {_what} to "%{-m::day}%일차 투표 시간이다. 처형할 사람에게 투표한다"
	if {_mode} is "night":
		set {_what} to "%{-m::day}%일차 밤이다. 네 직업(%mRoleName({_r})%) 능력을 쓸 대상을 고른다"
	set {_task} to "[결정] %{_what}%. %mBotRoleHint({_r}, {_mode})% 후보: %{_list}%"
	if {_sug} is not "":
		set {_task} to "%{_task}% 참고로 계산상 추천은 %mNum({_sug})%번이다(따르지 않아도 된다)."
	set {_task} to "%{_task}% JSON 하나만 답해라: {""target"": 번호} (고르지 않으려면 0"
	if {_r} is "arsonist":
		if {_mode} is "night":
			set {_task} to "%{_task}%, 점화하려면 -1"
	set {_task} to "%{_task}%)."
	set {_f} to mBotLlmPost(mBotStatic(), mBotUser({_b}, {_task}), 200)
	if {_f} is not set:
		stop
	set {-mtllm::df::%{_b}%} to {_f}
	set {-mtllm::dm::%{_b}%} to {_mode}
	set {-mtllm::dt::%{_b}%} to {-mau::sec}
	set {-mtllm::dph::%{_b}%} to mBotPhaseKey()

# 결정 답 적용
function mBotDecideApply(b: text, mode: text, raw: text):
	mBotDbg("결정 %mNum({_b})%번 %mNameOf({_b})% (%{_mode}%) 답: %{_raw}%")
	set {_a} to {_raw}.indexOf("{")
	set {_z} to {_raw}.lastIndexOf("}")
	if {_a} < 0:
		stop
	if {_z} <= {_a}:
		stop
	set {_o} to JsonParser.parseString({_raw}.substring({_a}, {_z} + 1)).getAsJsonObject()
	if {_o}.has("target") is false:
		stop
	set {_no} to {_o}.get("target").getAsInt()
	set {_key} to mBotPhaseKey()
	if {_mode} is "night":
		if {_no} is -1:
			if mActRole({_b}) is "arsonist":
				if mSetIgnite({_b}) is "":
					set {-mt::dec::%{_b}%} to {_key}
			stop
		if {_no} is 0:
			# 쓰지 않기로 함(규칙도 대신 쓰지 않게)
			set {-mt::dec::%{_b}%} to {_key}
			stop
		set {_c::*} to mTargets({_b})
		loop {_c::*}:
			if {-m::num::%loop-value%} is {_no}:
				set {_t} to loop-value
		if {_t} is not set:
			stop
		if mSetAct({_b}, {_t}) is "":
			set {-mt::dec::%{_b}%} to {_key}
			if mActRole({_b}) is "mafia":
				set {-mt::mk::%{-m::day}%} to {_t}
		stop
	if {_no} is 0:
		set {-mt::dec::%{_b}%} to {_key}
		stop
	loop {-m::players::*}:
		if {-m::num::%loop-value%} is {_no}:
			set {_t} to loop-value
	if {_t} is not set:
		stop
	if {_t} is {_b}:
		stop
	if mVoteCast({_b}, {_t}) is "":
		set {-mt::dec::%{_b}%} to {_key}
		if chance of 25%:
			mBotSpeak({_b}, "vote", {_t}, "", "")

function mBotDecidePoll():
	loop indices of {-mtllm::df::*}:
		set {_b} to loop-value
		set {_f} to {-mtllm::df::%{_b}%}
		set {_done} to false
		set {_body} to ""
		if {_f}.isDone() is true:
			set {_done} to true
			if {_f}.isCompletedExceptionally() is false:
				set {_res} to {_f}.get()
				if {_res}.statusCode() is 200:
					set {_o} to JsonParser.parseString({_res}.body()).getAsJsonObject()
					if {_o}.has("choices") is true:
						set {_body} to {_o}.getAsJsonArray("choices").get(0).getAsJsonObject().getAsJsonObject("message").get("content").getAsString()
		else if {-mau::sec} - {-mtllm::dt::%{_b}%} > mBotLlmWait() + 1:
			set {_done} to true
			{_f}.cancel(true)
		if {_done} is true:
			set {_m} to {-mtllm::dm::%{_b}%}
			set {_ph} to {-mtllm::dph::%{_b}%}
			delete {-mtllm::df::%{_b}%}
			delete {-mtllm::dm::%{_b}%}
			delete {-mtllm::dt::%{_b}%}
			delete {-mtllm::dph::%{_b}%}
			if {_body} is not "":
				if {_ph} is mBotPhaseKey():
					mBotDecideApply({_b}, {_m}, {_body})

every second:
	if size of {-mtllm::df::*} > 0:
		mBotDecidePoll()

# 사람 채팅 듣기(살아 있는 참가자가 낮·투표 시간에 한 말)
on chat:
	if size of {-mt::bots::*} is 0:
		stop
	if mRunning() is not true:
		stop
	# 밤: 사람 마피아가 마피아 팀 채팅에 대상을 말하면 마피아 봇이 따른다
	if mState() is "night":
		set {_nid} to "%uuid of player%"
		if {-m::alive::%{_nid}%} is true:
			if {-m::team::%{_nid}%} is "mafia":
				mBotMafiaHear({_nid}, uncolored message)
		stop
	if mState() is not "day" or "vote":
		stop
	set {_id} to "%uuid of player%"
	if {-m::alive::%{_id}%} is not true:
		stop
	set {_msg} to uncolored message
	# 봇의 대화 기억에 남긴다(AI 가 사람 말을 볼 수 있게)
	mBotChatAdd({_id}, {_msg})
	# AI 가 켜져 있으면 앞 대화까지 보고 뜻을 읽는다(단어만 보고 오해하지 않게, 단어 해석은 쓰지 않음)
	if mBotLlmOn() is true:
		mBotLlmParse({_id}, {_msg})
		stop
	# AI 가 꺼져 있으면 단어로 읽고, 봇을 불렀으면 그 봇이 대답한다
	mBotHear({_id}, {_msg})
	mBotAddressed({_id}, {_msg})

# ------------------------------------------------------------------ 밤의 마피아 팀 대화(봇)
# 마피아 팀 채팅(mchat.sk)은 원래 밤에 열려 있다. 봇도 거기서 말한다:
#   밤이 시작되고 몇 초 뒤 마피아 봇 하나가 오늘 밤 대상을 제안한다({-mt::mk::일차}, 마피아 봇은 모두 이 대상을 따른다).
#   사람 마피아가 대상을 고르면(W 선택) 또는 마피아 팀 채팅에 번호·닉네임을 말하면 봇들이 그 대상으로 바꾸고 대답한다.
# 변수: {-mt::mplan}(제안까지 남은 초), {-mt::msync::사람}(마지막으로 맞춘 사람 마피아의 선택)

# 마피아 팀 채널로 봇이 말한다(마피아 팀과 사망자·관전자가 받는다. mchat.sk 와 같은 모양)
function mBotMafiaSay(b: text, msg: text):
	if {-m::alive::%{_b}%} is not true:
		stop
	loop all players:
		set {_ok} to false
		if mChatAlive(loop-player) is not true:
			set {_ok} to true
		else if {-m::team::%uuid of loop-player%} is "mafia":
			set {_ok} to true
		if {_ok} is true:
			set {_nm} to mNumName({_b})
			set {_tag} to mMemoTag("%uuid of loop-player%", {_b})
			if {_tag} is not "":
				set {_nm} to "%{_nm}% %{_tag}%"
			send colored "&c[마피아 팀] &7<%{_nm}%&7> &f%{_msg}%" to loop-player
	mLogAdd("@mafia", "&c[마피아 팀] &7<{{n:%{_b}%}}&7> &f%{_msg}%")
	mBotDbg("마피아 팀 %mNum({_b})%번 %mNameOf({_b})%: %{_msg}%")

# 살아 있는 마피아 직업 봇들
function mBotMafiaBots() :: texts:
	loop {-m::players::*}:
		if mIsBot(loop-value) is true:
			if {-m::alive::%loop-value%} is true:
				if mActRole(loop-value) is "mafia":
					add loop-value to {_r::*}
	return {_r::*}

# 마피아 봇들의 오늘 밤 대상을 t 로 맞춘다
function mBotMafiaSet(t: text):
	set {-mt::mk::%{-m::day}%} to {_t}
	loop mBotMafiaBots():
		set {_c::*} to mTargets(loop-value)
		if {_c::*} contains {_t}:
			mSetAct(loop-value, {_t})
		delete {_c::*}

# 밤 시작 몇 초 뒤: 마피아 봇 하나가 대상을 제안한다
function mBotMafiaPlan():
	set {_bs::*} to mBotMafiaBots()
	if size of {_bs::*} is 0:
		stop
	set {_b} to first element of {_bs::*}
	set {_c::*} to mTargets({_b})
	if size of {_c::*} is 0:
		stop
	set {_key} to "%{-m::day}%"
	if {-mt::mk::%{_key}%} is set:
		set {_t} to {-mt::mk::%{_key}%}
	else:
		set {_t} to mBotBest({_b}, {_c::*}, "threat")
	if {_t} is "":
		stop
	mBotMafiaSet({_t})
	# 사람 마피아 팀원이 있으면 의견을 묻는다
	set {_human} to false
	loop {-m::players::*}:
		if mIsBot(loop-value) is false:
			if {-m::alive::%loop-value%} is true:
				if {-m::team::%loop-value%} is "mafia":
					set {_human} to true
	set {_l::*} to "오늘 밤은 %mBotRef({_t})% 어때요?", "%mBotRef({_t})% 가 제일 위험해 보여요. 그쪽 가죠", "저는 %mBotRef({_t})% 노릴게요"
	set {_m} to random element of {_l::*}
	if {_human} is true:
		set {_m} to "%{_m}% 다른 사람이 좋으면 번호 말해 주세요"
	mBotMafiaSay({_b}, {_m})

# 사람 마피아가 마피아 팀 채팅에 말했다: 번호·닉네임이 하나 나오면 그 사람으로 대상을 바꾼다
function mBotMafiaHear(s: text, msg: text):
	set {_bs::*} to mBotMafiaBots()
	if size of {_bs::*} is 0:
		stop
	set {_m} to {_msg}.replaceAll("[&§][0-9a-fk-orA-FK-OR]", "")
	set {_w::*} to split {_m} at " "
	loop {_w::*}:
		set {_x} to loop-value
		replace all "번" in {_x} with ""
		replace all "님" in {_x} with ""
		set {_no} to {_x} parsed as integer
		loop {-m::players::*}:
			set {_hit} to false
			if {_no} is set:
				if {-m::num::%loop-value-2%} is {_no}:
					set {_hit} to true
			if mNameOf(loop-value-2) is {_x}:
				set {_hit} to true
			if {_hit} is true:
				if {_ref::*} does not contain loop-value-2:
					add loop-value-2 to {_ref::*}
	if size of {_ref::*} is not 1:
		stop
	set {_t} to first element of {_ref::*}
	set {_b} to random element of {_bs::*}
	if {-m::alive::%{_t}%} is not true:
		mBotMafiaSay({_b}, "%mBotRef({_t})% 님은 이미 죽었어요")
		stop
	if {-m::team::%{_t}%} is "mafia":
		mBotMafiaSay({_b}, "%mBotRef({_t})% 님은 우리 팀이에요!")
		stop
	if {-mt::mk::%{-m::day}%} is {_t}:
		mBotMafiaSay({_b}, "네, %mBotRef({_t})% 그대로 가요")
		stop
	mBotMafiaSet({_t})
	mBotMafiaSay({_b}, "좋아요, %mBotRef({_t})% 로 바꿀게요")

# 사람 마피아가 W 로 대상을 고르면 봇들도 따라간다
function mBotMafiaSync():
	loop {-m::players::*}:
		set {_h} to loop-value
		if mIsBot({_h}) is false:
			if {-m::alive::%{_h}%} is true:
				if {-m::role::%{_h}%} is "mafia":
					set {_t} to mActOf({_h})
					if {_t} is not "":
						if {-mt::msync::%{_h}%} is not {_t}:
							set {-mt::msync::%{_h}%} to {_t}
							if {-mt::mk::%{-m::day}%} is not {_t}:
								set {_bs::*} to mBotMafiaBots()
								if size of {_bs::*} > 0:
									mBotMafiaSet({_t})
									mBotMafiaSay(random element of {_bs::*}, "%mBotRef({_t})% 고르셨네요. 저도 거기 갈게요")

# ------------------------------------------------------------------ 봇 진행(1초마다)

every second:
	if size of {-mt::bots::*} is 0:
		stop
	if mRunning() is not true:
		stop
	set {_s} to mState()
	set {_ph} to "%{_s}%-%{-m::day}%"
	if {-mt::phase} is not {_ph}:
		# 투표가 막 끝났으면 누가 누구를 찍었는지로 의심을 고친다(투표 기록은 다음 투표 시작 때 지워진다)
		if {-mt::phase} is set:
			if {-mt::phase} starts with "vote-":
				mBotVoteReview()
		set {-mt::phase} to {_ph}
		delete {-mt::when::*}
		delete {-mt::talk::*}
		# 지난 단계의 AI 결정 줄은 버린다(새 단계에서 다시 줄 세움)
		delete {-mtllm::dq::*}
		delete {-mtllm::dqm::*}
		if {_s} is "loading":
			mBotInit()
		delete {-mt::repdue::*}
		delete {-mt::noparse::*}
		if {_s} is "day":
			delete {-mt::said::*}
			mBotLearn()
			# 아침 보고 순서: 살아 있는 봇을 번호 순으로 3초 간격
			set {_ri} to 0
			set {_i} to 0
			while {_i} < 12:
				add 1 to {_i}
				loop {-m::players::*}:
					if {-m::num::%loop-value%} is {_i}:
						if mIsBot(loop-value) is true:
							if {-m::alive::%loop-value%} is true:
								set {_rat::%loop-value%} to {_ri}
								add 1 to {_ri}
		if {_s} is "night":
			delete {-mt::qm::*}
			# 지난 하루를 요약해 둔다(긴 게임에서도 초반을 기억하게)
			mBotSummarize({-m::day} - 1)
			delete {-mt::qt::*}
			delete {-mt::defend::*}
			delete {-mt::conflict::*}
			# 마피아 봇이 몇 초 뒤 마피아 팀 채팅에 오늘 밤 대상을 제안한다
			set {-mt::mplan} to random integer between 3 and 5
			delete {-mt::msync::*}
		loop {-m::players::*}:
			if mTestAutoOn(loop-value) is true:
				set {_max} to {-m::left} - 2
				if {_max} < 2:
					set {_max} to 2
				set {-mt::when::%loop-value%} to random integer between 1 and {_max}
				# AI 결정이 켜져 있으면(/mtest llm decide on) 밤 능력·투표를 AI 에게 먼저 묻고, 규칙은 단계가 끝나기 직전에만 대신 고른다
				if mBotDecideOn() is true:
					if mIsBot(loop-value) is true:
						if {_s} is "night" or "vote":
							mBotDecideQueue(loop-value, {_s})
							set {_late} to {-m::left} - 3
							if {_late} < 2:
								set {_late} to 2
							set {-mt::when::%loop-value%} to {_late}
				# 낮: 말할 때(아침 발표가 끝난 뒤 두 번)
				if {_s} is "day":
					if mIsBot(loop-value) is true:
						set {_ms} to mStgMorningLen() + 2
						set {_t1} to {_ms} + random integer between 1 and 12
						set {_t2} to {_t1} + random integer between 6 and 30
						# 첫 차례는 아침 보고(번호 순). 다음 말은 보고가 다 끝난 뒤
						if {_rat::%loop-value%} is set:
							set {_t1} to {_ms} + 1 + ({_rat::%loop-value%} * 3)
							set {-mt::repdue::%loop-value%} to true
							set {_re} to {_ms} + 1 + ({_ri} * 3)
							set {_t2} to {_re} + random integer between 4 and 25
						set {-mt::talk::%loop-value%::1} to {_t1}
						set {-mt::talk::%loop-value%::2} to {_t2}
						if chance of 50%:
							set {-mt::talk::%loop-value%::3} to {_t2} + random integer between 8 and 30
				# 처형 단계: 테러리스트 봇 길동무는 화형 컷신이 끝난 뒤
				if {_s} is "execute":
					set {-mt::when::%loop-value%} to mStgBurnLen() + random integer between 1 and 3
	# 밤: 마피아 봇의 대상 제안, 사람 마피아의 선택 따라가기
	if {_s} is "night":
		if {-mt::mplan} is set:
			subtract 1 from {-mt::mplan}
			if {-mt::mplan} <= 0:
				delete {-mt::mplan}
				mBotMafiaPlan()
		mBotMafiaSync()
	loop {-m::players::*}:
		set {_id} to loop-value
		if {-mt::when::%{_id}%} is set:
			subtract 1 from {-mt::when::%{_id}%}
			if {-mt::when::%{_id}%} <= 0:
				delete {-mt::when::%{_id}%}
				if {_s} is "night":
					mTestNight({_id})
				else if {_s} is "vote":
					mTestVote({_id})
				else if {_s} is "execute":
					mTestTake({_id})
		if {_s} is "day":
			if mIsBot({_id}) is true:
				loop 1, 2 and 3:
					set {_k} to loop-value-2
					if {-mt::talk::%{_id}%::%{_k}%} is set:
						subtract 1 from {-mt::talk::%{_id}%::%{_k}%}
						if {-mt::talk::%{_id}%::%{_k}%} <= 0:
							delete {-mt::talk::%{_id}%::%{_k}%}
							mBotTalk({_id})
				# 고발당하면 곧 해명(아침 보고를 마친 뒤)
				if {-mt::defend::%{_id}%} is set:
					if {-mt::repdue::%{_id}%} is not set:
						if chance of 35%:
							mBotTalk({_id})
		if {_s} is "day" or "vote":
			if mIsBot({_id}) is true:
				# 예약한 말(맞장구, 충돌 지적)
				if {-mt::qt::%{_id}%} is set:
					subtract 1 from {-mt::qt::%{_id}%}
					if {-mt::qt::%{_id}%} <= 0:
						mBotSayQueued({_id})
				# 사칭당한 진짜 직업 봇은 곧 반박
				if {-mt::conflict::%{_id}%} is set:
					if {-mt::repdue::%{_id}%} is not set:
						if chance of 40%:
							mBotTalk({_id})

# ------------------------------------------------------------------ 봇 탭 목록(가짜 항목, ProtocolLib)
# 게임 중에는 봇도 탭 목록에 번호·이름·생존 상태로 뜬다(mjoin.sk mTabJson 과 같은 모양). 머리는 UUID 로 정해지는 기본 스킨 = 더미 스킨과 같다.
# 접속한 사람마다 한 번 추가하고, 봇의 상태가 바뀌면 이름만 고쳐 보낸다. 로비로 돌아가면 지운다.
# 변수: {-mtab::bots::*}(탭에 올린 봇 uuid), {-mtab::sent::사람}(그 사람에게 추가했는지), {-mtab::st::봇}(마지막으로 보낸 이름)
function mBotTabData(b: text, i: number) :: object:
	set {_u} to UUID.fromString({_b})
	set {_gp} to new WrappedGameProfile({_u}, "bot%{_i}%")
	set {_dn} to WrappedChatComponent.fromJson(mTabJson({_b}, mNameOf({_b})))
	set {_ord} to 100
	if {-m::num::%{_b}%} is set:
		set {_ord} to 100 - {-m::num::%{_b}%}
	return new PlayerInfoData({_u}, 0, true, MtGM.ADVENTURE, {_gp}, {_dn}, true, {_ord}, null)

function mBotTabSend(p: player, full: boolean):
	set {_pm} to ProtocolLibrary.getProtocolManager()
	set {_pk} to {_pm}.createPacket(MtPT.PLAYER_INFO)
	if {_full} is true:
		set {_acts} to EnumSet.of(MtPIA.ADD_PLAYER, MtPIA.UPDATE_LISTED, MtPIA.UPDATE_DISPLAY_NAME, MtPIA.UPDATE_GAME_MODE, MtPIA.UPDATE_LIST_ORDER)
	else:
		set {_acts} to EnumSet.of(MtPIA.UPDATE_DISPLAY_NAME, MtPIA.UPDATE_LIST_ORDER)
	{_pk}.getPlayerInfoActions().write(0, {_acts})
	set {_list} to new ArrayList()
	set {_i} to 0
	loop {-mtab::bots::*}:
		add 1 to {_i}
		{_list}.add(mBotTabData(loop-value, {_i}))
	set {_mods} to {_pk}.getPlayerInfoDataLists()
	set {_idx} to 0
	if {_mods}.size() >= 2:
		set {_idx} to 1
	{_mods}.write({_idx}, {_list})
	{_pm}.sendServerPacket({_p}, {_pk})

function mBotTabRemove(p: player):
	set {_pm} to ProtocolLibrary.getProtocolManager()
	set {_pk} to {_pm}.createPacket(MtPT.PLAYER_INFO_REMOVE)
	set {_list} to new ArrayList()
	loop {-mtab::bots::*}:
		{_list}.add(UUID.fromString(loop-value))
	{_pk}.getUUIDLists().write(0, {_list})
	{_pm}.sendServerPacket({_p}, {_pk})

every second:
	if mState() is "lobby":
		if size of {-mtab::bots::*} > 0:
			loop all players:
				mBotTabRemove(loop-player)
			delete {-mtab::*}
		stop
	if size of {-mt::bots::*} is 0:
		stop
	if size of {-mtab::bots::*} is 0:
		set {-mtab::bots::*} to {-mt::bots::*}
	# 새로 접속한 사람에게 봇 항목 추가
	loop all players:
		if {-mtab::sent::%uuid of loop-player%} is not set:
			mBotTabSend(loop-player, true)
			set {-mtab::sent::%uuid of loop-player%} to true
	# 봇 상태(생존/사망, 번호)가 바뀌었으면 이름만 고쳐 보낸다
	set {_ch} to false
	loop {-mtab::bots::*}:
		set {_j} to mTabJson(loop-value, mNameOf(loop-value))
		if {-mtab::st::%loop-value%} is not {_j}:
			set {-mtab::st::%loop-value%} to {_j}
			set {_ch} to true
	if {_ch} is true:
		loop all players:
			mBotTabSend(loop-player, false)

on quit:
	delete {-mtab::sent::%uuid of player%}

function mTestTeamName(t: text) :: text:
	if {_t} is "mafia":
		return "&c마피아 팀"
	if {_t} is "citizen":
		return "&a시민 팀"
	if {_t} is "neutral":
		return "&e중립"
	return "&7무소속"

command /mtest [<text>] [<text>] [<text>]:
	permission: minecraft.command.op
	permission message: &c권한이 없습니다.
	description: 마피아 혼자 시험하기(봇) (관리자 전용)
	executable by: players
	trigger:
		if player is not op:
			send "&c관리자만 사용할 수 있습니다."
			stop
		set {_me} to "%uuid of player%"
		set {_a} to arg-1
		if {_a} is not set:
			send "&7사용법: /mtest start [봇 수] | role <직업id> [이름] | info | ai <이름> | llm ... | skip | kill <이름> | auto | stop"
			stop
		if {_a} is "start":
			if mState() is not "lobby":
				send "&c게임이 이미 진행 중입니다. /mtest stop 으로 먼저 끝내 주세요."
				stop
			set {_n} to 7
			if arg-2 is set:
				set {_n} to arg-2 parsed as integer
				if {_n} is not set:
					send "&c봇 수를 숫자로 입력해 주세요."
					stop
			if {_n} < 0:
				set {_n} to 0
			if {_n} > 11:
				set {_n} to 11
			delete {-mt::*}
			loop {_n} times:
				# 봇마다 다른 기본 스킨: UUID 를 골라서 클라이언트가 탭 머리에 그리는 기본 스킨(UUID 해시 % 18)과 더미 스킨을 맞춘다
				set {_k} to -1
				set {_try} to 0
				while {_k} < 0:
					set {_u} to UUID.randomUUID()
					set {_kk} to mod({_u}.hashCode(), 18)
					add 1 to {_try}
					if {_used::%{_kk}%} is not set:
						set {_k} to {_kk}
					else if {_try} > 200:
						set {_k} to {_kk}
				set {_used::%{_k}%} to true
				set {_id} to "%{_u}%"
				add {_id} to {-mt::bots::*}
				# 사람 같은 이름(겹치지 않게)
				set {_bn::*} to "Alex", "Mia", "Leo", "Emma", "Noah", "Lily", "Ethan", "Chloe", "Ryan", "Zoe", "Owen" and "Ruby"
				set {-mt::name::%{_id}%} to {_bn::%loop-value%}
				set {-mt::skin::%{_id}%} to {_k}
			if mStart(player) is not true:
				delete {-mt::*}
				send "&c시작하지 못했습니다. (위의 이유를 확인해 주세요)"
				stop
			send "&6[시험] &7봇 %{_n}%명과 게임을 시작했습니다. /mtest info 로 직업을 볼 수 있습니다."
			stop
		# AI(말하기) 설정: 게임 중이 아니어도 된다
		if {_a} is "llm":
			set {_k} to arg-2
			if {_k} is "url":
				if arg-3 is not set:
					send "&7예: /mtest llm url https://api.groq.com/openai/v1/chat/completions  (Ollama: http://localhost:11434/v1/chat/completions)"
					stop
				set {mcfg::llm::url} to arg-3
				send "&aAI 주소를 정했습니다."
				stop
			if {_k} is "key":
				if arg-3 is not set:
					delete {mcfg::llm::key}
					send "&7AI 키를 지웠습니다(키가 필요 없는 Ollama 등)."
					stop
				set {mcfg::llm::key} to arg-3
				send "&aAI 키를 저장했습니다. &7(화면에는 다시 보여 주지 않습니다)"
				stop
			if {_k} is "model":
				if arg-3 is not set:
					send "&7예: /mtest llm model llama-3.1-8b-instant"
					stop
				set {mcfg::llm::model} to arg-3
				send "&aAI 모델을 정했습니다: &f%arg-3%"
				stop
			if {_k} is "wait":
				set {_w} to arg-3 parsed as integer
				if {_w} is not set:
					send "&7답을 기다리는 시간(초): &f%mBotLlmWait()% &7(예: /mtest llm wait 40)"
					stop
				if {_w} < 5:
					set {_w} to 5
				set {mcfg::llm::wait} to {_w}
				delete {-mtllm::client}
				send "&a답을 기다리는 시간을 &f%{_w}%초&a로 정했습니다."
				stop
			if {_k} is "decide":
				if arg-3 is "on":
					set {mcfg::llm::decide} to true
					send "&a밤 능력·투표도 AI 가 정합니다. &7(늦으면 규칙이 대신)"
				else if arg-3 is "off":
					delete {mcfg::llm::decide}
					send "&7밤 능력·투표는 규칙이 정하고, AI 는 말만 합니다."
				else:
					send "&7사용법: /mtest llm decide on|off"
				stop
			if {_k} is "debug":
				if arg-3 is "on":
					set {mcfg::llm::debug} to true
					send "&a디버그 기록 켬: 봇이 한 말, AI 결정, 말 해석 결과가 콘솔에 [mafia-ai] 로 남습니다."
				else if arg-3 is "off":
					delete {mcfg::llm::debug}
					send "&7디버그 기록 끔."
				else:
					send "&7사용법: /mtest llm debug on|off"
				stop
			if {_k} is "par":
				set {_w} to arg-3 parsed as integer
				if {_w} is not set:
					send "&7동시에 보내는 요청 수: &f%mBotLlmPar()% &7(내 PC 의 Ollama 는 1, 인터넷 서비스는 2~3, 예: /mtest llm par 1)"
					stop
				if {_w} < 1:
					set {_w} to 1
				set {mcfg::llm::par} to {_w}
				send "&a동시에 보내는 요청 수를 &f%{_w}%&a(으)로 정했습니다."
				stop
			if {_k} is "effort":
				if arg-3 is not set:
					delete {mcfg::llm::effort}
					send "&7생각 정도(reasoning_effort)를 보내지 않습니다."
					stop
				set {mcfg::llm::effort} to arg-3
				send "&a생각 정도를 &f%arg-3%&a(으)로 보냅니다. &7(none/low/medium/high, 지원하지 않는 모델이면 /mtest llm effort 로 끄기)"
				stop
			if {_k} is "on":
				set {mcfg::llm::on} to true
				send "&a봇 말하기를 AI 로 합니다."
				if mBotLlmOn() is false:
					send "&e아직 주소나 모델이 없어 정해 둔 문장으로 말합니다."
				stop
			if {_k} is "off":
				delete {mcfg::llm::on}
				send "&7봇 말하기를 정해 둔 문장으로 합니다."
				stop
			if {_k} is "test":
				if {mcfg::llm::url} is not set:
					send "&c먼저 /mtest llm url <주소> 와 model <모델> 을 정해 주세요."
					stop
				if {mcfg::llm::model} is not set:
					send "&c먼저 /mtest llm model <모델> 을 정해 주세요."
					stop
				mBotLlmTest(player)
				stop
			set {_st} to "&c꺼짐"
			if {mcfg::llm::on} is true:
				set {_st} to "&a켜짐"
			set {_ky} to "&c없음"
			if {mcfg::llm::key} is set:
				set {_ky} to "&a있음"
			set {_ur} to "없음"
			if {mcfg::llm::url} is set:
				set {_ur} to {mcfg::llm::url}
			set {_mo} to "없음"
			if {mcfg::llm::model} is set:
				set {_mo} to {mcfg::llm::model}
			send "&6[AI] &7상태 %{_st}% &7주소 &f%{_ur}% &7모델 &f%{_mo}% &7키 %{_ky}%"
			if {-mtllm::err} is set:
				set {_er} to {-mtllm::err}
				if {_er}.length() > 150:
					set {_er} to {_er}.substring(0, 150)
				send "&7마지막 오류: &c%{_er}%"
			send "&7사용법: /mtest llm url <주소> | key <키> | model <모델> | effort [none|low] | wait <초> | par <수> | decide on|off | debug on|off | on | off | test | status"
			stop
		if {_a} is "stop":
			mToLobby()
			mBc("&7시험 게임을 끝내고 로비로 돌아왔습니다.")
			stop
		if mRunning() is not true:
			send "&c게임 중에만 쓸 수 있습니다. 먼저 /mtest start"
			stop
		if {_a} is "info":
			set {_s} to mState()
			send "&6[시험] &7단계 &f%{_s}% &7%{-m::day}%일차, 남은 시간 &f%{-m::left}%초"
			loop {-m::players::*}:
				set {_id} to loop-value
				set {_nm} to mNameOf({_id})
				set {_rn} to mRoleName({-m::role::%{_id}%})
				set {_tm} to mTestTeamName({-m::team::%{_id}%})
				set {_al} to "&a생존"
				if {-m::alive::%{_id}%} is not true:
					set {_al} to "&8사망"
				set {_ex} to ""
				if {-m::fake::%{_id}%} is set:
					set {_ex} to " &7(가짜: %mRoleName({-m::fake::%{_id}%})%)"
				if {-m::act::%{_id}%} is set:
					set {_ex} to "%{_ex}% &7밤 → &f%mNameOf({-m::act::%{_id}%})%"
				if {-m::actmode::%{_id}%} is "ignite":
					set {_ex} to "%{_ex}% &6점화"
				if {-m::vote::%{_id}%} is set:
					set {_ex} to "%{_ex}% &7투표 → &f%mNameOf({-m::vote::%{_id}%})%"
				if {-m::contact::%{_id}%} is true:
					set {_ex} to "%{_ex}% &c접선"
				if {-m::oil::%{_id}%} is true:
					set {_ex} to "%{_ex}% &6기름"
				send "&7- &f%{_nm}% &e%{_rn}% %{_tm}% %{_al}%%{_ex}%"
			stop
		if {_a} is "ai":
			if arg-2 is not set:
				send "&7사용법: /mtest ai <봇 이름>"
				stop
			set {_b} to mTestFind(arg-2)
			if {_b} is "":
				send "&c그런 참가자가 없습니다."
				stop
			send "&6[시험] &f%mNameOf({_b})% &7의 생각 (아는 것 / 의심 점수)"
			loop {-m::players::*}:
				if loop-value is not {_b}:
					set {_kn} to mBotK({_b}, loop-value)
					if {_kn} is "":
						set {_kn} to "-"
					set {_cl} to ""
					if {-mt::claim::%loop-value%} is set:
						set {_cl} to " &7주장: &f%mRoleName({-mt::claim::%loop-value%})%"
					send "&7- %mNumName(loop-value)% &7아는 것 &f%{_kn}% &7의심 &e%mBotSus({_b}, loop-value)%%{_cl}%"
			stop
		if {_a} is "skip":
			set {-m::left} to 1
			send "&7지금 단계를 끝냅니다."
			stop
		if {_a} is "auto":
			if {-mt::auto::%{_me}%} is true:
				delete {-mt::auto::%{_me}%}
				send "&7내 입력 자동: &c꺼짐"
			else:
				set {-mt::auto::%{_me}%} to true
				send "&7내 입력 자동: &a켜짐 &7(다음 단계부터)"
			stop
		if {_a} is "kill":
			if arg-2 is not set:
				send "&7사용법: /mtest kill <이름>"
				stop
			set {_t} to mTestFind(arg-2)
			if {_t} is "":
				send "&c그런 참가자가 없습니다."
				stop
			if {-m::alive::%{_t}%} is not true:
				send "&c이미 사망했습니다."
				stop
			mDie({_t})
			mTabUpdateAll()
			send "&7%arg-2% 님을 사망 처리했습니다."
			stop
		if {_a} is "role":
			set {_r} to arg-2
			if {_r} is not set:
				send "&7사용법: /mtest role <직업id> [이름]  (직업 id 는 /mrole list)"
				stop
			if mRoleExists({_r}) is false:
				send "&c그런 직업 id 가 없습니다. /mrole list 로 확인해 주세요."
				stop
			set {_t} to {_me}
			if arg-3 is set:
				set {_t} to mTestFind(arg-3)
				if {_t} is "":
					send "&c그런 참가자가 없습니다."
					stop
			if {-m::players::*} does not contain {_t}:
				send "&c게임 참가자가 아닙니다."
				stop
			set {-m::role::%{_t}%} to {_r}
			set {-m::orig::%{_t}%} to {_r}
			set {-m::team::%{_t}%} to mStartTeam({_r})
			delete {-m::fake::%{_t}%}
			delete {-m::used::%{_t}%}
			delete {-m::contact::%{_t}%}
			if {_r} is "madman":
				set {-m::fake::%{_t}%} to mFakeRole()
			set {_nm} to mNameOf({_t})
			send "&7%{_nm}% 님의 직업을 &e%mRoleName({_r})%&7(으)로 바꿨습니다."
			set {_tp} to mPlayerOf({_t})
			if {_tp} is set:
				mRoleReveal({_tp})
			stop
		send "&7사용법: /mtest start [봇 수] | role <직업id> [이름] | info | ai <이름> | llm ... | skip | kill <이름> | auto | stop"

# 다시 불러오면 AI 접속 객체를 새로 만든다(설정이 바뀌었을 수 있음)
on load:
	delete {-mtllm::client}
	delete {-mtllm::df::*}
	delete {-mtllm::dq::*}
	delete {-mtllm::dqm::*}
	delete {-mtllm::q::*}
	delete {-mtllm::pq::*}
	delete {-mtllm::pf::*}
	delete {-mtllm::sf}
	delete {-mtllm::f::*}
	delete {-mtllm::fb::*}
	delete {-mtllm::t::*}
