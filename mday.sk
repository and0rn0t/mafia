# ==============================================================================
# [mday.sk] 게임 진행 루프(밤 → 처리 → 낮 → 투표 → 처형 → 밤 …), 낮 시간 조절, 로비 복귀. 규칙은 ROLES.md, 구조는 DESIGN.md.
# 진행: every second 한 개가 {-m::state} 별로 {-m::left} 를 줄이고 0 이 되면 다음 단계로 넘긴다.
#   night(밤 입력 시간) → [mResolve] → resolve(mSceneResolve 연출 시간) → [mResolveShow + 승패] → day(토론) → vote(mvote.sk) → [mTally, 테러리스트면 execute] → [승패] → night …  end → 10초 뒤 로비
#   단계가 바뀔 때 mscene.sk 의 mSceneNight/mSceneDay/mSceneVote 를 부르고, 대상 선택 화면은 단계가 끝날 때 mPickCloseAll 로 닫는다.
# 낮 시간 조절: /mdisc up|down 또는 W/S 키 (낮마다 한 사람 한 번, 15초, 누가 눌렀는지 알림, 0초가 되면 투표로)
# 남은 시간 표시: 게임 중(밤/처리/낮/투표/길동무/종료) 모든 접속자 화면 위에 보스바로 단계 이름과 남은 초를 보여 준다(mBarUpdate, 1초마다).
#   막대 길이는 그 단계를 시작할 때의 시간 기준(낮에 시간을 늘리면 기준도 늘어난다). 로비로 돌아가면 지운다.
# 변수: {-m::tadj::uuid}(이 낮에 시간 조절 사용함, 낮 시작 때 초기화), {-m::bar}(보스바), {-m::barph}(단계 바뀜 감지), {-m::bartot}(막대 기준 초)
# 미검증: 전체(서버 실행 불가). Bukkit.createBossBar 가변 인자(BarFlag...)를 빼고 부르는 것.
# ==============================================================================

import:
	org.bukkit.Bukkit
	org.bukkit.boss.BarColor
	org.bukkit.boss.BarStyle

function mBarClear():
	if {-m::bar} is set:
		{-m::bar}.removeAll()
	delete {-m::bar}
	delete {-m::barph}
	delete {-m::bartot}

function mBarUpdate():
	set {_s} to mState()
	if {_s} is "lobby":
		mBarClear()
		stop
	if {-m::bar} is not set:
		set {-m::bar} to Bukkit.createBossBar("", BarColor.WHITE, BarStyle.SOLID)
	set {_left} to {-m::left}
	if {_left} is not set:
		set {_left} to 0
	if {_left} < 0:
		set {_left} to 0
	set {_ph} to "%{_s}%-%{-m::day}%"
	if {-m::barph} is not {_ph}:
		set {-m::barph} to {_ph}
		set {-m::bartot} to {_left}
	if {_left} > {-m::bartot}:
		set {-m::bartot} to {_left}
	set {_d} to {-m::day}
	set {_c} to BarColor.WHITE
	if {_s} is "night":
		set {_nm} to "&9%{_d}%일차 밤 &7· 능력 사용"
		set {_c} to BarColor.BLUE
	else if {_s} is "resolve":
		set {_nm} to "&9%{_d}%일차 밤 &7· 밤이 지나가는 중"
		set {_c} to BarColor.PURPLE
	else if {_s} is "day":
		set {_nm} to "&e%{_d}%일차 낮 &7· 토론"
		set {_c} to BarColor.YELLOW
	else if {_s} is "vote":
		set {_nm} to "&c%{_d}%일차 낮 &7· 투표"
		set {_c} to BarColor.RED
	else if {_s} is "execute":
		set {_nm} to "&c처형"
		if {-m::exe} is set:
			set {_nm} to "&c테러리스트 길동무 선택"
		set {_c} to BarColor.RED
	else if {_s} is "loading":
		set {_nm} to "&e게임 준비 중"
		set {_c} to BarColor.YELLOW
	else:
		set {_nm} to "&f게임 종료 &7· 로비로 돌아가는 중"
	{-m::bar}.setTitle(colored "%{_nm}% &f%{_left}%초")
	{-m::bar}.setColor({_c})
	set {_pr} to 0
	if {-m::bartot} > 0:
		set {_pr} to {_left} / {-m::bartot}
	if {_pr} > 1:
		set {_pr} to 1
	{-m::bar}.setProgress({_pr})
	set {_has} to {-m::bar}.getPlayers()
	loop all players:
		if {_has}.contains(loop-player) is false:
			{-m::bar}.addPlayer(loop-player)

every second:
	mBarUpdate()

function mToLobby():
	mBarClear()
	mSceneClear()
	mReset()
	set {_lb} to mLobbyLoc()
	loop all players:
		if loop-player is not op:
			set loop-player's gamemode to adventure
		else if gamemode of loop-player is spectator:
			set loop-player's gamemode to creative
		mTp(loop-player, {_lb})
		mLobbyEnsure(loop-player)
	# 연출 중 막아 둔 본체를 다시 보이게 한다(mbody.sk)
	mBodyRefresh()
	mTabUpdateAll()

function mStartNight():
	add 1 to {-m::day}
	set {-m::state} to "night"
	mNightStart()
	broadcast "&6[마피아] &7%{-m::day}%일차 밤이 시작됩니다. (%{-m::left}%초)"
	mSceneNight()

function mStartDay():
	set {-m::state} to "day"
	# 아침 발표(사망자, 기자 특종) 연출 시간만큼 토론 시간을 늘려 둔다(발표가 토론 시간을 잡아먹지 않게)
	set {-m::left} to mTimeDiscuss() + mStgMorningLen()
	delete {-m::tadj::*}
	broadcast "&6[마피아] &7%{-m::day}%일차 낮입니다. 토론하세요. (%{-m::left}%초)"
	mSceneDay()

# 승패가 났으면 종료 처리하고 true
function mCheckEnd() :: boolean:
	set {_w} to mWinCheck()
	if {_w} is "":
		return false
	mPickCloseAll()
	mEnd({_w})
	loop {-m::players::*}:
		mViewAuto(loop-value)
	# 승리 팀 라인업(관리자 메뉴에서 정한 위치가 있을 때)
	mStgLineup({_w})
	return true

every second:
	set {_s} to mState()
	if mRunning() is not true:
		if {_s} is "end":
			subtract 1 from {-m::left}
			if {-m::left} <= 0:
				mToLobby()
				broadcast "&6[마피아] &7게임이 종료되어 로비로 돌아왔습니다."
		stop
	subtract 1 from {-m::left}
	if {-m::left} > 0:
		stop
	if {_s} is "loading":
		mStgReveal()
		mStartNight()
	else if {_s} is "night":
		mPickCloseAll()
		set {-m::state} to "resolve"
		mResolve()
		set {-m::left} to mSceneResolve()
	else if {_s} is "resolve":
		mResolveShow()
		if mCheckEnd() is true:
			stop
		mStartDay()
	else if {_s} is "day":
		mVoteStart()
	else if {_s} is "vote":
		mPickCloseAll()
		mTally()
		if mState() is "execute":
			stop
		if mCheckEnd() is true:
			stop
		mStartNight()
	else if {_s} is "execute":
		mPickCloseAll()
		if {-m::exe} is set:
			set {_x} to {-m::exe}
			loop {-m::players::*}:
				if loop-value is not {_x}:
					if {-m::alive::%loop-value%} is true:
						add loop-value to {_cand::*}
			if size of {_cand::*} > 0:
				mTakePick({_x}, random element of {_cand::*})
			# 길동무 TNT 연출이 시작됐으면(남은 시간이 다시 채워짐) 끝날 때까지 기다린다
			if {-m::left} > 0:
				stop
		if mCheckEnd() is true:
			stop
		mStartNight()

command /mdisc <text>:
	description: 낮 토론 시간 15초 늘리기/줄이기 (마피아 게임, 낮마다 한 번)
	executable by: players
	trigger:
		set {_id} to "%uuid of player%"
		if mState() is not "day":
			send "&c낮 토론 시간에만 쓸 수 있습니다."
			stop
		if {-m::alive::%{_id}%} is not true:
			send "&c생존자만 쓸 수 있습니다."
			stop
		if {-m::tadj::%{_id}%} is true:
			send "&c오늘은 이미 시간을 조절했습니다."
			stop
		if arg-1 is "up":
			add 15 to {-m::left}
			broadcast "&6[마피아] &f%name of player%&7 님이 토론 시간을 15초 늘렸습니다."
		else if arg-1 is "down":
			subtract 15 from {-m::left}
			if {-m::left} < 0:
				set {-m::left} to 0
			broadcast "&6[마피아] &f%name of player%&7 님이 토론 시간을 15초 줄였습니다."
		else:
			send "&7사용법: /mdisc up|down"
			stop
		set {-m::tadj::%{_id}%} to true
