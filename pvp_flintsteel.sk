# [flintsteel.sk] 부싯돌과 부시 스킬(우클릭, 쿨 20초): 주변 10칸 안의 적(플레이어)을 5초간 '취약'(받는 피해 1.2배)으로 만들고 불태움(불로는 데미지 없음). 사용 지점에서 범위 끝까지 불꽃이 퍼지는 이펙트.
# 환경, 작업 규칙, 변수 목록, 스킬 추가 절차는 skill_core.sk 맨 위 주석을 먼저 읽을 것.
# 이 파일이 쓰는 변수: {-fscd}(쿨타임 종료 시각), {-vuln::uuid}(취약 종료 시각, main.sk 의 on damage 가 x1.2), {-noburn::uuid}(불 데미지 무시 종료 시각, main.sk 가 읽음), {-skillitems::flint_steel}, 상태이상 출처 키 flint(보스바 해로운 효과 "취약")
# 대상: 사용자 본인과 아군({-team} isAlly)은 제외한 플레이어. 몹은 대상이 아니다(몹 대상 여부는 미정이라 확인 필요).
# 불태움은 화염 애니메이션만이고 불 피해(FIRE_TICK/FIRE)는 main.sk 에서 취소한다. 점화 동안 noburn 으로 막는다(불 5초 + 여유 3초).
# 주의: 'flint and steel' 은 함수 인자에 쓰면 and 로 갈려서 '둘'로 읽히므로 {-skillitems::flint_steel} 변수로 넘긴다.
# 우클릭이 블럭에 불을 붙이지 않도록 이벤트를 취소한다.
# 이펙트: 사용 지점에서 반지름 1~10 칸까지 1틱마다 한 칸씩 커지는 불꽃 고리(총 10틱)(FLAME). 미검증: 파티클 FLAME 고리, ignite 효과.

import:
	org.bukkit.Particle

on load:
	set {-skillitems::flint_steel} to flint and steel

# 중심에서 반지름 r 인 고리에 불꽃을 뿌린다(발 높이)
function flintRing(center: location, r: number):
	set {_w} to {_center}.getWorld()
	set {_n} to {_r} * 8
	loop {_n} times:
		set {_a} to loop-number * 360 / {_n}
		set {_x} to cos({_a}) * {_r}
		set {_z} to sin({_a}) * {_r}
		set {_l} to {_center} ~ vector({_x}, 0.3, {_z})
		{_w}.spawnParticle(Particle.FLAME, {_l}, 1, 0.1, 0.1, 0.1, 0.02, null, true)

on rightclick:
	if skillHand(player, {-skillitems::flint_steel}) is false:
		stop
	cancel event
	set {_id} to "%player's uuid%"
	if {-fscd::%{_id}%} is set:
		if {-fscd::%{_id}%} > now:
			stop
	set {-fscd::%{_id}%} to now + 20 seconds
	set item cooldown of {-skillitems::flint_steel} for player to 20 seconds
	set {_p} to player
	set {_c} to location of {_p}
	soundAround("item.flintandsteel.use", location of {_p}, 1, 1)
	soundAround("entity.blaze.shoot", location of {_p}, 0.7, 0.8)
	# 주변 10칸 안의 적: 취약 + 불태움
	loop all players in radius 10 around {_c}:
		set {_t} to loop-player
		if {_t} is not {_p}:
			if isAlly({_id}, "%uuid of {_t}%") is false:
				set {_tid} to "%uuid of {_t}%"
				set {-vuln::%{_tid}%} to now + 5 seconds
				set {-noburn::%{_tid}%} to now + 8 seconds
				# 불을 붙이고(화염 애니메이션) 불 피해만 main.sk 에서 취소한다. 불이 확실히 붙도록 ignite 와 setFireTicks 를 같이 쓴다.
				ignite {_t} for 5 seconds
				{_t}.setFireTicks(100)
				setStatus({_t}, "flint", "취약", 5 seconds, "bad")
	# 불꽃이 사용 지점에서 범위 끝(10칸)까지 퍼져나간다
	loop 10 times:
		flintRing({_c}, loop-number)
		wait 1 tick

on death of player:
	delete {-vuln::%victim's uuid%}
	delete {-noburn::%victim's uuid%}
	clearStatus(victim, "flint")

on join:
	delete {-fscd::%player's uuid%}
