# ==============================================================================
# [mcore.sk] 마피아 게임 핵심: 변수 목록, 설정(시간, 로비/게임 월드 위치), 상태 값. 규칙은 ROLES.md, 구조는 DESIGN.md.
# 파일/변수를 추가하거나 바꾸면 이 주석(변수 목록)도 같이 갱신한다.
# ==============================================================================
# 변수 목록 (런타임은 임시 변수 {-m::...}, 설정만 저장 변수 {mcfg::...})
#   {-m::state}              lobby / night / resolve / day / vote / execute / end (mGo 로만 바꾼다)
#   {-m::day}                몇 번째 날(1부터)
#   {-m::left}               현재 단계의 남은 시간(초)
#   {-m::players::*}         게임 참가자 uuid 목록(관전자는 없음)
#   {-m::ready::uuid}        로비에서 준비됨(true)                                                     mjoin.sk
#   {-m::spec::uuid}         로비에서 게임 관전을 고름(true). 참가자 목록에 안 들어간다             mjoin.sk
#   {-m::cd}                 자동 시작 카운트다운 남은 초(없으면 카운트다운 아님)                       mjoin.sk
#   {-m::away::uuid}         자리비움(게임 중 접속을 끊음, 재접속하면 삭제)                           mjoin.sk
#   {-m::alive::uuid}        생존 여부(true/false)
#   {-m::role::uuid}, {-m::orig::uuid}, {-m::team::uuid}   현재 직업 / 최초 직업 / 팀(mafia, citizen, neutral, none)   mroles.sk
#   {mcfg::role::직업id}     false 면 그 직업을 끈 것                                                           mroles.sk
#   {mcfg::discper}, {mcfg::vote}, {mcfg::night}   낮 토론(생존자 1명당) / 투표 / 밤 능력 선택 시간(초). 기본 15/30/30        mcore.sk(/mtime)
#   {mcfg::loc::lobby::world|x|y|z|yaw|pitch}   로비 위치(없으면 서버 기본 월드 스폰)                          mcore.sk(/mloc)
#   {mcfg::loc::game::world|x|y|z|yaw|pitch}    게임 월드 위치(게임 시작 때 참가자가 이동하는 곳)                mcore.sk(/mloc)
#   {-m::act::uuid}          이 밤에 고른 대상 uuid                                                        mnight.sk
#   {-m::actmode::uuid}      target(대상 선택) / ignite(방화범 점화)                                        mnight.sk
#   {-m::used::uuid}         1회 능력(기자, 자경단, 도둑) 사용 여부                                         mnight.sk(읽기), mresolve.sk(쓰기)
#   {-m::sealed::uuid}       마담에게 지목당해 이번 밤 능력 불가                                           mnight.sk(읽기), mvote.sk/mresolve.sk
#   {-m::fake::uuid}         광인에게 보여 준 가짜 직업                                                      mjoin.sk, mnight.sk
#   {-m::contact/soldier/oil/nocht/novote/stolen::uuid}, {-m::ev/info/pub/dead::*}   밤 처리 결과·상태 (자세한 뜻은 mresolve.sk 머리말)
#   {-m::vote/votes/tadj::uuid}, {-m::exe}   투표 대상 / 받은 표 / 낮 시간 조절 사용 / 길동무 선택 대기 테러리스트   mvote.sk, mday.sk
#   {-ms::...}               화면 연출 상태(카메라, 더미, 대상 선택 화면). 목록과 뜻은 mscene.sk 머리말. mSceneClear 가 한꺼번에 지운다   mscene.sk
#   {mcfg::loc::table/daycam/room/nightcam/bed/bedcam::...}, {mcfg::scene::radius/facedist/faceh/bedgap/backdist/sidedist/camh}   연출 장소(/mbuild)와 숫자 설정(관리자 메뉴 맵/연출)   madmin.sk
#   {-madm::uuid}            관리자 메뉴에서 지금 열어 둔 메뉴 이름                                          madmin.sk
#   {-msq::...}, {-msc::...}   밤 처리 연출의 장면 목록 / 재생 중인 장면(자세한 뜻은 mfx.sk 머리말)                         mfx.sk
#   {-ms::spec::*}, {-ms::watch::uuid}, {-ms::hold::uuid}, {-ms::stage}   관전자 목록 / 사망자·관전자가 보는 자리 / 해골 미루기 / 컷신 중   mscene.sk, mstage.sk
#   {-m::rep::*}             이번 밤 기자 취재 대상(아침 특종)   mresolve.sk, mstage.sk
#   {mcfg::take}, {mcfg::loc::lineup::...}   길동무 선택 시간 / 승리 팀 라인업 위치(관리자 메뉴)   madmin.sk
#   {-ms::house::uuid}       그 참가자의 집 번호(1~12, mScHouse). {mcfg::house::번호::face} 집 문 방향                           mscene.sk, mbuild.sk
#   {mcfg::nofb}             false 면 연속 퍼블 금지 꺼짐(없으면 켜짐). {-mfb::prev/cur::*} 지난/이번 게임 1일차 밤 사망자(mReset 이 지우지 않음)   mnight.sk, mresolve.sk, mBegin
#
# 위치 저장은 PvP 서버(andornot)의 gcSaveLoc/gcLoadLoc 와 같은 방식이다(월드 이름 + 좌표). 월드는 world.sk 의 /world create 로 먼저 만들어 둔다.
# 명령(관리자 전용, 도움말은 mhelp.sk): /mloc lobby|game set|tp|info , /mtime discuss|vote|night <초> , /mtime (현재 값)
# 미검증: 전체(서버 실행 불가).
# ==============================================================================

import:
	org.bukkit.Bukkit
	org.bukkit.SoundCategory
	java.util.ArrayList
	java.util.function.Consumer
	io.papermc.paper.dialog.Dialog
	io.papermc.paper.registry.data.dialog.DialogBase
	io.papermc.paper.registry.data.dialog.DialogBase$DialogAfterAction as DlgAfter
	io.papermc.paper.registry.data.dialog.body.DialogBody
	io.papermc.paper.registry.data.dialog.type.DialogType
	net.kyori.adventure.text.serializer.legacy.LegacyComponentSerializer

# 소리는 모두 플레이어 자신에게 붙여서 재생한다(Player#playSound(Entity, ...)). 위치에 재생하면 관전 카메라로 시점이 옮겨진 동안
# 서버의 플레이어 위치와 실제 화면 위치가 어긋나 소리가 씹혔다. 분류는 MASTER(마스터 음량만 따름). s 는 "ui.button.click" 같은 소리 이름.
function mSound(p: player, s: text, v: number, pi: number):
	{_p}.playSound({_p}, "minecraft:%{_s}%", SoundCategory.MASTER, {_v}, {_pi})

# 토론 시간 = 생존자 수 × 1명당 초(기본 15초, 관리자 메뉴·/mtime discuss 로 바꾼다)
function mTimeDiscussPer() :: number:
	if {mcfg::discper} is set:
		return {mcfg::discper}
	return 15

function mTimeDiscuss() :: number:
	set {_n} to 0
	loop {-m::players::*}:
		if {-m::alive::%loop-value%} is true:
			add 1 to {_n}
	return {_n} * mTimeDiscussPer()

function mTimeVote() :: number:
	if {mcfg::vote} is set:
		return {mcfg::vote}
	return 30

function mTimeNight() :: number:
	if {mcfg::night} is set:
		return {mcfg::night}
	return 30

# 테러리스트 길동무 선택 시간(초). 관리자 메뉴에서 바꾼다. 기본 10(확정)
function mTimeTake() :: number:
	if {mcfg::take} is set:
		return {mcfg::take}
	return 10

# 현재 단계("lobby" 등). 아직 정해지지 않았으면 lobby.
function mState() :: text:
	if {-m::state} is not set:
		return "lobby"
	return {-m::state}

# 게임이 진행 중인지(lobby 와 end 가 아니면)
function mRunning() :: boolean:
	set {_s} to mState()
	if {_s} is "lobby":
		return false
	if {_s} is "end":
		return false
	return true

# 위치 저장/읽기. key 는 "lobby" 또는 "game".
function mLocSave(key: text, l: location):
	set {_w} to {_l}.getWorld()
	# 이미 같은 값이면 다시 쓰지 않는다(스크립트를 불러올 때마다 연출 자리 수백 개를 다시 쓰면 변수 저장이 밀려 리로드가 느려졌다)
	if {mcfg::loc::%{_key}%::world} is {_w}.getName():
		if {mcfg::loc::%{_key}%::x} is {_l}.getX():
			if {mcfg::loc::%{_key}%::y} is {_l}.getY():
				if {mcfg::loc::%{_key}%::z} is {_l}.getZ():
					if {mcfg::loc::%{_key}%::yaw} is {_l}.getYaw():
						if {mcfg::loc::%{_key}%::pitch} is {_l}.getPitch():
							stop
	set {mcfg::loc::%{_key}%::world} to {_w}.getName()
	set {mcfg::loc::%{_key}%::x} to {_l}.getX()
	set {mcfg::loc::%{_key}%::y} to {_l}.getY()
	set {mcfg::loc::%{_key}%::z} to {_l}.getZ()
	set {mcfg::loc::%{_key}%::yaw} to {_l}.getYaw()
	set {mcfg::loc::%{_key}%::pitch} to {_l}.getPitch()

# 저장이 있고 월드가 불러와져 있어야 true
function mLocSet(key: text) :: boolean:
	set {_wn} to {mcfg::loc::%{_key}%::world}
	if {_wn} is not set:
		return false
	if Bukkit.getWorld({_wn}) is not set:
		return false
	return true

# 저장된 위치. 저장이 없거나 월드가 없으면 값 없음.
function mLocLoad(key: text) :: location:
	if mLocSet({_key}) is false:
		return {_none}
	set {_w} to Bukkit.getWorld({mcfg::loc::%{_key}%::world})
	set {_l} to new Location({_w}, {mcfg::loc::%{_key}%::x}, {mcfg::loc::%{_key}%::y}, {mcfg::loc::%{_key}%::z}, {mcfg::loc::%{_key}%::yaw}, {mcfg::loc::%{_key}%::pitch})
	return {_l}

# 로비 위치: 저장된 로비, 없으면 서버 기본 월드의 스폰
function mLobbyLoc() :: location:
	set {_l} to mLocLoad("lobby")
	if {_l} is set:
		return {_l}
	return Bukkit.getWorlds().get(0).getSpawnLocation()

# 게임 월드 위치: 저장된 위치. 없으면 값 없음(시작 검사에서 막는다).
function mGameLoc() :: location:
	return mLocLoad("game")

# 안전한 이동: 탈것/올라탄 엔티티를 먼저 내리고 이동한다(다른 월드로 이동이 거부되는 것을 막음).
function mTp(p: player, l: location):
	{_l}.getChunk()
	{_p}.eject()
	{_p}.leaveVehicle()
	teleport {_p} to {_l}

# 시작할 때 월드 준비 검사. 문제가 없으면 "", 있으면 이유 문장.
function mWorldCheck() :: text:
	if mLocSet("game") is false:
		return "게임 월드 위치가 정해지지 않았습니다. /mloc game set 으로 정해 주세요."
	return ""

function mLocLabel(key: text) :: text:
	if {_key} is "lobby":
		return "로비"
	return "게임 월드"

command /mloc [<text>] [<text>]:
	permission: minecraft.command.op
	permission message: &c권한이 없습니다.
	description: 마피아 로비/게임 월드 위치 설정 (관리자 전용)
	executable by: players
	trigger:
		if player is not op:
			send "&c관리자만 사용할 수 있습니다."
			stop
		set {_k} to arg-1
		if {_k} is not "lobby":
			if {_k} is not "game":
				send "&7사용법: /mloc lobby|game set|tp|info"
				stop
		set {_lb} to mLocLabel({_k})
		if arg-2 is "set":
			mLocSave({_k}, player's location)
			set {_wn} to {mcfg::loc::%{_k}%::world}
			send "&a%{_lb}% 위치를 지금 서 있는 곳으로 정했습니다. (월드 %{_wn}%)"
			stop
		if arg-2 is "tp":
			set {_l} to mLocLoad({_k})
			if {_l} is not set:
				send "&c%{_lb}% 위치가 정해지지 않았거나 월드가 불러와져 있지 않습니다."
				stop
			mTp(player, {_l})
			stop
		set {_wn} to {mcfg::loc::%{_k}%::world}
		if {_wn} is not set:
			send "&7%{_lb}%: &c정해지지 않음"
			stop
		set {_x} to round({mcfg::loc::%{_k}%::x} * 10) / 10
		set {_y} to round({mcfg::loc::%{_k}%::y} * 10) / 10
		set {_z} to round({mcfg::loc::%{_k}%::z} * 10) / 10
		set {_st} to "불러옴"
		if mLocSet({_k}) is false:
			set {_st} to "아직 안 불러옴"
		send "&7%{_lb}%: &f%{_wn}% &7(%{_x}%, %{_y}%, %{_z}%) 월드 %{_st}%"

command /mtime [<text>] [<number>]:
	permission: minecraft.command.op
	permission message: &c권한이 없습니다.
	description: 마피아 낮/투표/밤 시간 설정 (관리자 전용)
	trigger:
		if sender is a player:
			if player is not op:
				send "&c관리자만 사용할 수 있습니다."
				stop
		if arg-1 is not set:
			set {_d} to mTimeDiscussPer()
			set {_v} to mTimeVote()
			set {_n} to mTimeNight()
			send "&7낮 토론 &f생존자 1명당 %{_d}%초 &7/ 투표 &f%{_v}%초 &7/ 밤 능력 선택 &f%{_n}%초"
			send "&7사용법: /mtime discuss|vote|night <초>"
			stop
		if arg-2 is not set:
			send "&c초를 숫자로 입력해 주세요. 예: /mtime discuss 15"
			stop
		if arg-2 < 5:
			send "&c5초 이상으로 입력해 주세요."
			stop
		if arg-1 is "discuss":
			set {mcfg::discper} to arg-2
			send "&a낮 토론 시간을 생존자 1명당 %arg-2%초로 정했습니다."
			stop
		if arg-1 is "vote":
			set {mcfg::vote} to arg-2
			send "&a투표 시간을 %arg-2%초로 정했습니다."
			stop
		if arg-1 is "night":
			set {mcfg::night} to arg-2
			send "&a밤 능력 선택 시간을 %arg-2%초로 정했습니다."
			stop
		send "&7사용법: /mtime discuss|vote|night <초>"

# 게임을 시작한 직후 첫 밤으로 넘어간다. (밤/낮/투표 진행은 mnight.sk, mday.sk, mvote.sk 를 만들 때 여기에 이어 붙인다)
function mBegin():
	set {-m::day} to 0
	# 연속 퍼블 금지: 지난 게임의 1일차 밤 사망자를 이번 게임의 보호 대상으로 넘긴다(mnight.sk 의 mFbProtected)
	delete {-mfb::prev::*}
	set {-mfb::prev::*} to {-mfb::cur::*}
	delete {-mfb::cur::*}
	# 5초 로딩(원탁 화면 + 액션바 loading...) 뒤 mday.sk 의 진행 루프가 직업 안내(mStgReveal)를 하고 첫 밤을 시작한다
	delete {-m::log::*}
	set {-m::state} to "loading"
	set {-m::left} to 5

# 게임 상태를 전부 지우고 로비로 돌린다(강제 종료, 게임 종료 뒤 공통).
function mReset():
	set {-m::state} to "lobby"
	delete {-m::day}
	delete {-m::left}
	delete {-m::players::*}
	delete {-m::nm::*}
	delete {-m::num::*}
	delete {-m::calm}
	delete {-m::diedsince}
	delete {-m::drawwhy}
	delete {-m::jwin}
	delete {-m::winwhy}
	delete {-m::alive::*}
	delete {-m::role::*}
	delete {-m::orig::*}
	delete {-m::team::*}
	delete {-m::away::*}
	delete {-m::act::*}
	delete {-m::actmode::*}
	delete {-m::used::*}
	delete {-m::sealed::*}
	delete {-m::fake::*}
	delete {-m::vote::*}
	delete {-m::votes::*}
	delete {-m::tadj::*}
	delete {-m::exe}
	delete {-m::contact::*}
	delete {-m::soldier::*}
	delete {-m::oil::*}
	delete {-m::nocht::*}
	delete {-m::novote::*}
	delete {-m::stolen::*}
	delete {-m::ev::*}
	delete {-m::info::*}
	delete {-m::pub::*}
	delete {-m::rep::*}
	delete {-m::dead::*}
	delete {-m::ready::*}
	delete {-m::cd}
	delete {-mt::*}

# ------------------------------------------------------------------ 게임 메시지 기록(/mlog)
# 게임 중 전체 알림(mBc)과 본인에게만 간 메시지(mLogP: 직업 안내, 조사 결과, 접선)를 순서대로 남긴다. 다음 게임이 시작될 때 지운다.
# 항목: "받는 사람|단계 표시|문장" (받는 사람 * = 모두)
function mLogTag() :: text:
	set {_s} to mState()
	set {_d} to {-m::day}
	if {_s} is "night" or "resolve":
		return "&8[%{_d}%일차 밤]"
	if {_s} is "day":
		return "&8[%{_d}%일차 낮]"
	if {_s} is "vote" or "execute":
		return "&8[%{_d}%일차 투표]"
	if {_s} is "end":
		return "&8[종료]"
	return "&8[시작]"

function mLogAdd(who: text, t: text):
	add "%{_who}%|%mLogTag()%|%{_t}%" to {-m::log::*}

# 전체 알림 + 기록
function mBc(t: text):
	broadcast colored {_t}
	if mState() is not "lobby":
		mLogAdd("*", {_t})

# 본인에게만 간 메시지 기록(보내기는 부르는 쪽이 한다)
function mLogP(id: text, t: text):
	mLogAdd({_id}, {_t})

# 기록 창(대화창 dialog). 채팅에 쓰지 않아 채팅이 밀리지 않는다. 최근 것이 아래, 길면 창 안에서 스크롤. ESC 나 확인 버튼으로 닫는다.
# Paper Dialog API: Dialog.create(Consumer) 는 proxy 로 만든다(받는 함수 mLogDlgAccept 가 {-mlogdlg::base} 를 넣는다).
function mLogDlgAccept(px: object, f: object):
	set {_b} to {_f}.empty()
	{_b}.base({-mlogdlg::base})
	{_b}.type(DialogType.notice())

function mLogShow(p: player):
	set {_id} to "%uuid of {_p}%"
	loop {-m::log::*}:
		set {_e::*} to split loop-value at "|"
		if {_e::1} is "*" or {_id}:
			set {_line} to loop-value
			replace first "%{_e::1}%|" in {_line} with ""
			replace first "|" in {_line} with " "
			add {_line} to {_mine::*}
	set {_n} to size of {_mine::*}
	if {_n} is 0:
		set {_t} to "&7아직 기록이 없습니다."
	else:
		# 너무 길면 최근 200줄만
		set {_first} to 1
		if {_n} > 200:
			set {_first} to {_n} - 199
		set {_t} to ""
		set {_i} to {_first}
		while {_i} <= {_n}:
			if {_t} is "":
				set {_t} to {_mine::%{_i}%}
			else:
				set {_t} to "%{_t}%%nl%%{_mine::%{_i}%}%"
			add 1 to {_i}
	replace all "&" in {_t} with "§"
	set {_body} to new ArrayList()
	{_body}.add(DialogBody.plainMessage(LegacyComponentSerializer.legacySection().deserialize({_t}), 400))
	set {_title} to LegacyComponentSerializer.legacySection().deserialize("§6§l게임 기록")
	set {-mlogdlg::base} to DialogBase.create({_title}, null, true, false, DlgAfter.CLOSE, {_body}, new ArrayList())
	set {_h::accept} to function reference "mLogDlgAccept"
	set {_c} to a new proxy of Consumer using {_h::*}
	set {_d} to Dialog.create({_c})
	delete {-mlogdlg::base}
	{_p}.showDialog({_d})

command /mlog:
	aliases: /기록, /log
	description: 이번 게임 메시지 기록 보기(대화창)
	executable by: players
	trigger:
		mLogShow(player)

# ------------------------------------------------------------------ 봇 시험(mtest.sk) 연결점
# 게임 코드는 봇에 대해 이 세 함수만 부른다. 봇 변수({-mt::*})는 mtest.sk 가 채우고, 그 파일이 없으면 늘 비어 있어 봇이 없는 것과 같다.
# 운영 서버에서는 mtest.sk 만 빼면 된다(다른 파일은 그대로).

# mStart 가 부른다: 이번 게임에 넣을 봇 uuid 목록(없으면 비어 있음)
function mTestBots() :: texts:
	return {-mt::bots::*}

# 봇 이름(봇이 아니면 "")
function mTestName(id: text) :: text:
	if {-mt::name::%{_id}%} is set:
		return {-mt::name::%{_id}%}
	return ""

function mIsBot(id: text) :: boolean:
	if {-mt::name::%{_id}%} is set:
		return true
	return false
