# ==============================================================================
# [mbody.sk] 연출(카메라) 중에는 플레이어 본체를 서로에게 보내지 않는다 (ProtocolLib 필요). 구조는 DESIGN.md.
# 왜: 참가자 본체는 관전 모드로 카메라 근처에 있고, 밤 장면 동안 행동한 사람만 본체가 다른 곳으로 순간이동한다.
#     미니맵·엔티티 레이더 모드가 본체 위치를 보여 주면 "누가 밤에 움직였는지"가 드러난다.
# 방법: 플레이어 엔티티 생성 패킷(SPAWN_ENTITY, 종류 PLAYER)을 막는다. 탭 목록(PLAYER_INFO)은 항목을 지우지 않고, 다른 사람 항목의 관전 모드만 모험으로 바꿔 보통 플레이어처럼 보이게 한다(mBodyInfo).
#   이미 서로 보이던 본체는 mBodyRefresh(숨겼다 다시 보여 주기)로 다시 보내게 해서 막히게 한다. 게임이 끝나면 같은 함수로 다시 보이게 한다.
#   막는 조건은 {-ms::on}(연출 켜짐)뿐이다. 연출 없이 하는 게임은 본체가 곧 플레이어라 막지 않는다.
# 리스너 주인 플러그인: uuidmask.sk 가 다시 불러올 때 Skript 플러그인 이름으로 등록된 리스너를 모두 지우므로, 가능하면 skript-reflect 이름으로 등록한다.
#   혹시 지워져도 5초마다 확인해서 다시 등록한다.
# 변수: {-mbody::l}(등록한 리스너)
# 미검증: 번들 안의 SPAWN_ENTITY 취소, getEntityTypeModifier 읽기, 네티 스레드에서 {-ms::on} 읽기.
# ==============================================================================

import:
	org.bukkit.Bukkit
	org.bukkit.entity.EntityType
	ch.njol.skript.Skript as SkriptMain
	java.util.ArrayList
	java.util.HashSet
	com.comphenix.protocol.ProtocolLibrary
	com.comphenix.protocol.PacketType$Play$Server as PTServer
	com.comphenix.protocol.events.PacketListener
	com.comphenix.protocol.events.ListeningWhitelist
	com.comphenix.protocol.events.ListenerPriority
	com.comphenix.protocol.events.ListenerOptions
	com.comphenix.protocol.wrappers.PlayerInfoData
	com.comphenix.protocol.wrappers.WrappedChatComponent
	net.kyori.adventure.text.serializer.gson.GsonComponentSerializer
	net.kyori.adventure.text.serializer.legacy.LegacyComponentSerializer
	com.comphenix.protocol.wrappers.EnumWrappers$PlayerInfoAction as PIAction
	com.comphenix.protocol.wrappers.EnumWrappers$NativeGameMode as PIGameMode

function mBodyPlugin() :: object:
	set {_pl} to Bukkit.getPluginManager().getPlugin("skript-reflect")
	if {_pl} is set:
		return {_pl}
	return SkriptMain.getInstance()

function mBodySendWl() :: object:
	set {_t} to new ArrayList()
	{_t}.add(PTServer.SPAWN_ENTITY)
	{_t}.add(PTServer.PLAYER_INFO)
	set {_o} to new HashSet()
	{_o}.add(ListenerOptions.SKIP_PLUGIN_VERIFIER)
	set {_b} to ListeningWhitelist.newBuilder()
	{_b}.types({_t})
	{_b}.options({_o})
	{_b}.priority(ListenerPriority.NORMAL)
	return {_b}.build()

function mBodyRecvWl() :: object:
	return ListeningWhitelist.EMPTY_WHITELIST

# (proxy 핸들러: 첫 인자는 proxy 자신, 두 번째가 PacketEvent)
function mBodyOnSend(px: object, e: object):
	if {-ms::on} is not true:
		stop
	if {_e}.isPlayerTemporary() is true:
		stop
	if {_e}.getPacketType().equals(PTServer.PLAYER_INFO) is true:
		mBodyInfo({_e})
		stop
	set {_ty} to {_e}.getPacket().getEntityTypeModifier().read(0)
	if {_ty} is not set:
		stop
	if {_ty}.equals(EntityType.PLAYER) is true:
		{_e}.setCancelled(true)

# 탭 목록: 게임 중 참가자·관전자는 연출 카메라 때문에 관전 모드라 탭에 회색 기울임(관전)으로 뜬다.
# 다른 사람에게 보내는 탭 항목의 게임 모드만 모험으로 바꿔 보통 플레이어처럼 보이게 한다(받는 사람 자신의 항목은 그대로: 자기 게임 모드에 영향이 없게).
function mBodyInfo(e: object):
	set {_pk} to {_e}.getPacket()
	set {_acts} to {_pk}.getPlayerInfoActions().read(0)
	if {_acts} is not set:
		stop
	set {_hasgm} to {_acts}.contains(PIAction.UPDATE_GAME_MODE)
	set {_hasdn} to {_acts}.contains(PIAction.UPDATE_DISPLAY_NAME)
	if {_hasgm} is false:
		if {_hasdn} is false:
			stop
	set {_mods} to {_pk}.getPlayerInfoDataLists()
	set {_idx} to 0
	if {_mods}.size() >= 2:
		set {_idx} to 1
	set {_list} to {_mods}.read({_idx})
	if {_list} is not set:
		stop
	set {_v} to {_e}.getPlayer().getUniqueId()
	set {_vs} to "%{_v}%"
	set {_out} to new ArrayList()
	set {_hit} to false
	set {_n} to {_list}.size()
	set {_i} to 0
	while {_i} < {_n}:
		set {_d} to {_list}.get({_i})
		set {_pid} to {_d}.getProfileId()
		set {_ch} to false
		set {_gm} to {_d}.getGameMode()
		set {_ngm} to {_gm}
		# 다른 사람의 관전 모드는 모험으로(보통 플레이어처럼)
		if {_hasgm} is true:
			if {_gm} is set:
				if {_gm}.equals(PIGameMode.SPECTATOR) is true:
					if {_pid}.equals({_v}) is false:
						set {_ngm} to PIGameMode.ADVENTURE
						set {_ch} to true
		# 이름 옆에 받는 사람의 메모 표시(mmemo.sk)
		set {_dn} to {_d}.getDisplayName()
		set {_ndn} to {_dn}
		if {_hasdn} is true:
			if {_dn} is set:
				set {_tag} to mMemoTag({_vs}, "%{_pid}%")
				if {_tag} is not "":
					set {_tj} to GsonComponentSerializer.gson().serialize(LegacyComponentSerializer.legacyAmpersand().deserialize(" %{_tag}%"))
					set {_ndn} to WrappedChatComponent.fromJson("[%{_dn}.getJson()%,%{_tj}%]")
					set {_ch} to true
		if {_ch} is true:
			set {_hit} to true
			{_out}.add(new PlayerInfoData({_pid}, {_d}.getLatency(), {_d}.isListed(), {_ngm}, {_d}.getProfile(), {_ndn}, {_d}.isShowHat(), {_d}.getListOrder(), {_d}.getRemoteChatSessionData()))
		else:
			{_out}.add({_d})
		add 1 to {_i}
	if {_hit} is false:
		stop
	set {_cl} to {_pk}.shallowClone()
	{_cl}.getPlayerInfoDataLists().write({_idx}, {_out})
	{_e}.setPacket({_cl})

function mBodyOnRecv(px: object, e: object):
	stop

function mBodyRegister():
	if Bukkit.getPluginManager().isPluginEnabled("ProtocolLib") is false:
		stop
	if {-mbody::l} is set:
		ProtocolLibrary.getProtocolManager().removePacketListener({-mbody::l})
	set {_h::onpacketsending} to function reference "mBodyOnSend"
	set {_h::onpacketreceiving} to function reference "mBodyOnRecv"
	set {_h::getsendingwhitelist} to function reference "mBodySendWl"
	set {_h::getreceivingwhitelist} to function reference "mBodyRecvWl"
	set {_h::getplugin} to function reference "mBodyPlugin"
	set {_l} to a new proxy of PacketListener using {_h::*}
	ProtocolLibrary.getProtocolManager().addPacketListener({_l})
	set {-mbody::l} to {_l}

# 모든 접속자끼리 본체를 숨겼다 다시 보여 준다 -> 서버가 생성 패킷을 다시 보낸다(연출 중이면 막히고, 끝났으면 다시 보인다)
function mBodyRefresh():
	loop all players:
		set {_a} to loop-player-1
		loop all players:
			if loop-player-2 is not {_a}:
				{_a}.hidePlayer(mScPlugin(), loop-player-2)
	wait 2 ticks
	loop all players:
		set {_a} to loop-player-1
		loop all players:
			if loop-player-2 is not {_a}:
				{_a}.showPlayer(mScPlugin(), loop-player-2)

on load:
	mBodyRegister()

on unload:
	if {-mbody::l} is set:
		ProtocolLibrary.getProtocolManager().removePacketListener({-mbody::l})
		delete {-mbody::l}

every 5 seconds:
	if {-mbody::l} is not set:
		mBodyRegister()
		stop
	if ProtocolLibrary.getProtocolManager().getPacketListeners().contains({-mbody::l}) is false:
		mBodyRegister()

# 안전한 다시 불러오기(관리자): Skript 로 만든 ProtocolLib 리스너(이 파일, uuidmask.sk)를 먼저 떼고 /sk reload all 을 한다.
# 그냥 /sk reload 하면 함수가 먼저 내려가 그사이 패킷에서 "getSendingWhitelist() is null" 오류가 콘솔에 찍힌다(게임에는 영향 없음).
# 리스너는 각 파일의 on load 가 다시 붙인다(이 파일은 5초마다 확인도 한다).
command /mreload:
	permission: minecraft.command.op
	permission message: &c권한이 없습니다.
	description: 마피아 스크립트 안전하게 다시 불러오기 (관리자 전용)
	trigger:
		if sender is a player:
			if player is not op:
				send "&c관리자만 사용할 수 있습니다."
				stop
		if Bukkit.getPluginManager().isPluginEnabled("ProtocolLib") is true:
			set {_pm} to ProtocolLibrary.getProtocolManager()
			if {-mbody::l} is set:
				{_pm}.removePacketListener({-mbody::l})
			if {-umlistener} is set:
				{_pm}.removePacketListener({-umlistener})
			{_pm}.removePacketListeners(SkriptMain.getInstance())
			set {_rf} to Bukkit.getPluginManager().getPlugin("skript-reflect")
			if {_rf} is set:
				{_pm}.removePacketListeners({_rf})
			delete {-mbody::l}
			delete {-umlistener}
		send "&7패킷 리스너를 떼고 스크립트를 다시 불러옵니다..."
		make console execute command "sk reload all"
